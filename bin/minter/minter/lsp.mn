load network.protocols.json-rpc.serializer
load network.protocols.json-rpc.exception
load network.protocols.json-rpc.server
load network.endpoints.stdio
load network.endpoints.ip
load network.sockets.stdio
load network.sockets.tcp
load runtime.scheduler
load system.terminal
load system.process
load system.thread
load system.os
load system.timer
load container.set
load mint.function
load mint.range

load minter.workspace
load minter.config

@enum LspTextDocumentSyncKind {
	None = 0
	Full = 1
	Incremental = 2
}

/**
 * This class provides an implementation of the language server protocol for the
 * mint language.
 */
@class MintLspServer {
	/**
	 * Creates a new language server. The `stream` parameter must implement the
	 * stream interface (read and write) and will be used to send end receive
	 * messages. If the `checkParentProcess` is set to `true`, the server will
	 * be closed if the parent process is stopped. If the `consumer` parameter
	 * is not `none`, the given object will be called to send responses instead
	 * of the `stream` write method.
	 */
	const def new(self, stream, checkParentProcess: boolean = false, consumer = none) {

		self.checkParentProcess = checkParentProcess
		self.jsonRpcStream = stream

		// if consumer is none, it is assumed that the default streams-based approach is being used
		if consumer {
			self.jsonRpcEndpoint = def [consumer] (self, data) {
				var message = self.toMessage(data)
				logger.debug("Sending response to client %s", message.toString())
				return consumer(message)
			}
		} else {
			self.jsonRpcEndpoint = def (self, data) {
				var message = self.toMessage(data)
				logger.debug("Sending response to client %s", message.toString())
				return self.jsonRpcStream.write(message)
			}
		}
	}

	/**
	 * Entry point for the server.
	 */
	const def start(self) {
		self.scheduler = Runtime.Scheduler()
		self.scheduler.spawn(self.run())
		self.scheduler.run()
	}

	/**
	 * Server main loop.
	 */
	- const async def run(self) {
		self.running = true
		while self.running {
			try {
				if let message = self.jsonRpcStream.read() {
					await self.consume(message)
				}
			} catch error {
				logger.error("Failed to read from stream: %s", error.toString())
				if typeof error == 'DocumentStream.InvalidDocument' {
					logger.error("Document error: %s", error.getError())
				}
				// Continue trying to read despite errors
			}
		}
	}

	/**
	 * Consume a JSON RPC message from the client.
	 * Args:
	 * message (hash): The JSON RPC message sent by the client
	 */
	const async def consume(self, message) {

		const JsonRpcVersion: string = '2.0'

		if 'jsonrpc' not in message or message['jsonrpc'] != JsonRpcVersion {
			logger.warning("Unknown message type %s", message.toString())
			return none
		}

		if 'id' not in message {
			try {
				logger.debug("Handling notification from client %s", message.toString())
				await self.onRpcNotification(message['method'], message.get('params'))
			} catch error {
				logger.error("Failed to handle notification %s", message['method'])
				logger.error(error.toString())
			}
		} elif 'method' not in message {
			try {
				logger.debug("Handling response from client %s", message.toString())
				await self.onRpcResponse(message['id'], message.get('result'), message.get('error'))
			} catch error {
				logger.error("Failed to handle request %s", message['id'])
				logger.error(error.toString())
			}
		} else {
			try {
				logger.debug("Handling request from client %s", message.toString())
				var result = await self.onRpcRequest(message['id'], message['method'], message.get('params'))
				self.jsonRpcEndpoint({
					"jsonrpc": JsonRpcVersion,
					"result": result,
					"id": message['id']
				})
			} catch error {
				logger.error("Failed to handle request %s (%s)", message['method'], message['id'])
				logger.error(error.toString())
				self.jsonRpcEndpoint({
					'jsonrpc': JsonRpcVersion,
					'id': message['id'],
					'error': error.toHash()
				})
			}
		}
	}

	const async def onRpcNotification(self, method, params) {
		if self.shutdown and method != 'exit' {
			// exit is the only allowed method during shutdown
			logger.debug("Ignoring non-exit method during shutdown: %s", method)
			raise Network.JsonRpc.InvalidRequest(method)
		}
		const callMethod = Network.JsonRpc.AbstractRequestHandler.toMethodSymbol(method)
		logger.debug("RPC call %s", callMethod)
		if callMethod not in membersof self {
			if method.startsWith('$/') {
				logger.debug("Ignoring unknown protocol notification: %s", method)
				return none
			}
			raise Network.JsonRpc.MethodNotFound(method)
		}
		await self.${callMethod}(params)
	}

	const async def onRpcRequest(self, id, method, params) {
		if self.shutdown and method != 'exit' {
			// exit is the only allowed method during shutdown
			logger.debug("Ignoring non-exit method during shutdown: %s", method)
			raise Network.JsonRpc.InvalidRequest(method)
		}
		const callMethod = Network.JsonRpc.AbstractRequestHandler.toMethodSymbol(method)
		logger.debug("RPC call %s", callMethod)
		if callMethod not in membersof self {
			raise Network.JsonRpc.MethodNotFound(method)
		}
		return await self.${callMethod}(params)
	}

	const async def onRpcResponse(self, id, result, error) {

	}

	- const def getWorkspaceFromUrl(self, uri) {

		if uri in self.workspaces {
			return self.workspaces[uri]
		}

		let url = uri.toUrl()
		let targetPath = none
		if not defined url {
			if defined uri and not uri.isEmpty() {
				let path = System.File(uri)?.getAbsolutePath()
				if defined path {
					url = System.Url.fromFilePath(path)
					targetPath = path
				}
			}
		} else {
			targetPath = url.toFile()?.getAbsolutePath()
		}

		let bestWorkspace = none
		let bestLength = -1

		for let workspace in self.workspaces.values() {
			if let rootUri = workspace.getRootUri() {
				let rootString = rootUri.toString()
				if defined uri and uri.startsWith(rootString) and rootString.size() > bestLength {
					bestWorkspace = workspace
					bestLength = rootString.size()
				}
			}
			if let rootPath = workspace.getRootPath() {
				if defined targetPath and targetPath.startsWith(rootPath) and rootPath.size() > bestLength {
					bestWorkspace = workspace
					bestLength = rootPath.size()
				}
			}
		}

		return bestWorkspace
	}

	/**
	 * Returns `data` converted into an instance of `Network.JsonRpc.Message`.
	 */
	- const def toMessage(self, data) -> Network.JsonRpc.Message {
		switch typeof data {
		case 'Network.JsonRpc.Message':
			return data
		case 'string':
			return Network.JsonRpc.Message.fromString(data)
		default:
			return Network.JsonRpc.Message(data)
		}
	}

	const def capabilities(self, rootUri) -> hash? {
		if let workspace = self.getWorkspaceFromUrl(rootUri) {
			return {
				'codeActionProvider': self.hasCapability('onCodeActions', workspace),
				/*'codeLensProvider': {
					'resolveProvider': false  // We may need to make this configurable
				},*/
				'completionProvider': {
					'resolveProvider': self.hasCapability('onCompletionItemResolve', workspace),
					'triggerCharacters': ['.']
				},
				'documentFormattingProvider': self.hasCapability('onFormatDocument', workspace),
				'documentHighlightProvider': self.hasCapability('onDocumentHighlight', workspace),
				'documentRangeFormattingProvider': self.hasCapability('onFormatRange', workspace),
				'documentSymbolProvider': self.hasCapability('onDocumentSymbols', workspace),
				'definitionProvider': self.hasCapability('onDefinitions', workspace),
				'executeCommandProvider': {
					'commands': self.flatten(self.hook('getCommands', rootUri))
				},
				'hoverProvider': self.hasCapability('onHover', workspace),
				'referencesProvider': self.hasCapability('onReferences', workspace),
				'renameProvider': self.hasCapability('onRename', workspace),
				'foldingRangeProvider': false,
				'signatureHelpProvider': {
					'triggerCharacters': ['(', ',', '=']
				},
				'textDocumentSync': {
					'change': LspTextDocumentSyncKind.Incremental,
					'save': {
						'includeText': true
					},
					'openClose': true
				},
				'workspace': {
					'workspaceFolders': {
						'supported': true,
						'changeNotifications': true
					}
				},
				'general': {
					'positionEncoding': 'utf-8'
				},
				'experimental': self.hook('getExperimentalCapabilities', rootUri).accumulate({}, def (result, item) {
					for k, v in item {
						result[k] = v
					}
					return result
				})
			}
		}
	}

	- const async def rpc_initialize(self, params) {

		var processId = params.get('processId')
		var rootUri = params.get('rootUri')
		var rootPath = params.get('rootPath')
		var capabilities = params.get('capabilities', {})
		var initializationOptions = params.get('initializationOptions', {})

		logger.debug('Language server initialized with %s %s %s %s', processId, rootUri, rootPath, initializationOptions)
		if not rootUri {
			rootUri = rootPath
		}
		if rootUri {
			let config = MintLspConfig(rootUri, initializationOptions, processId, capabilities)
			let workspace = MintLspWorkspace(rootUri, Callback(self, self.jsonRpcEndpoint), config)
			logger.debug('Updated workspace for %s', workspace.getRootPath())
			self.workspaces[rootUri] = workspace
		}
		for var folder in params.get('workspaceFolders') {
			let uri = folder.get('uri')
			if uri == rootUri {
				continue // Already created
			}
			let config = MintLspConfig(uri, initializationOptions, processId, capabilities)
			let workspace = MintLspWorkspace(uri, Callback(self, self.jsonRpcEndpoint), config)
			logger.debug('Updated workspace for %s', workspace.getRootPath())
			self.workspaces[uri] = workspace
		}

		self.hook('onInitialize', rootUri)

		if self.checkParentProcess and defined processId and self.watchingThread is none {
			let const watchParentProcess = def [self] (pid) {
				const PARENT_PROCESS_WATCH_INTERVAL = 10  // 10 s
				var parentProcess = System.Process(pid)
				while parentProcess.isRunning() {
					System.sleep(PARENT_PROCESS_WATCH_INTERVAL * 1000)
				}
				// exit when the given pid is not alive
				logger.info("Parent process %s is not alive, exiting!", pid)
				self.onRpcNotification('exit', {})
			}

			logger.debug('Starting parent process watcher for PID %d', processId)
			self.watchingThread = System.Thread(watchParentProcess)
			self.watchingThread.start(processId)
		}

		// Get our capabilities
		var serverCapabilities = self.capabilities(rootUri)
		logger.info('Server capabilities: %s', serverCapabilities)
		return {
			'capabilities': serverCapabilities,
			'serverInfo': {
				'name': 'minter',
				'version': __version__
			}
		}
	}

	- const async def rpc_initialized(self, params) {
		for var workspace in self.workspaces.values() {
			self.hook('onInitialized', workspace.getRootPath())
		}
	}

	- const async def rpc___setTrace(self, params) {
		self.traceValue = params.get('value', 'off')
		logger.debug('Trace value set to %s', self.traceValue)
	}

	- const async def rpc___cancelRequest(self, params) {
		logger.debug('Cancel request received for %s', params.get('id'))
	}

	- const async def rpc_completion_item__resolve(self, params) {
		var completionItem = params.get('completionItem', {})
		var docUri = completionItem.get('data', {}).get('docUri')
		return self.hook('onCompletionItemResolve', docUri, completionItem)
	}

	- const async def rpc_textDocument_didClose(self, params) {
		var textDocument = params['textDocument']
		self.cancelPendingLint(textDocument['uri'])
		if let workspace = self.getWorkspaceFromUrl(textDocument['uri']) {
			workspace.publishDiagnostics(textDocument['uri'], [])
			workspace.removeDocument(textDocument['uri'])
		}
	}

	- const async def rpc_textDocument_didOpen(self, params) {
		var textDocument = params['textDocument']
		self.cancelPendingLint(textDocument['uri'])
		if let workspace = self.getWorkspaceFromUrl(textDocument['uri']) {
			workspace.createDocument(textDocument['uri'], textDocument['text'], textDocument.get('version'))
		}
		self.hook('onDocumentDidOpen', textDocument['uri'])
		self.lint(textDocument['uri'], true)
	}

	- const async def rpc_textDocument_didChange(self, params) {
		var contentChanges = params['contentChanges']
		var textDocument = params['textDocument']
		if let workspace = self.getWorkspaceFromUrl(textDocument['uri']) {
			for let change in contentChanges {
				workspace.updateDocument(textDocument['uri'], change, textDocument.get('version'))
			}
		}
		self.scheduleLint(textDocument['uri'])
	}

	- const async def rpc_textDocument_didSave(self, params) {
		var textDocument = params['textDocument']
		self.cancelPendingLint(textDocument['uri'])
		self.hook("onDocumentDidSave", textDocument['uri'])
		self.lint(textDocument['uri'], true)
	}

	- const async def rpc_textDocument_codeAction(self, params) {
		var textDocument = params['textDocument']
		var range = params['range']
		var context = params['context']
		return self.flatten(self.hook('onCodeActions', textDocument['uri'], range, context))
	}

	- const async def rpc_textDocument_codeLens(self, params) {
		var textDocument = params['textDocument']
		return self.flatten(self.hook('onCodeLens', textDocument['uri']))
	}

	- const async def rpc_textDocument_completion(self, params) {
		var textDocument = params['textDocument']
		var position = params['position']
		return {
			'isIncomplete': false,
			'items': self.flatten(self.hook('onCompletions', textDocument['uri'], position))
		}
	}

	- const async def rpc_textDocument_definition(self, params) {
		var textDocument = params['textDocument']
		var position = params['position']
		return self.flatten(self.hook('onDefinitions', textDocument['uri'], position))
	}

	- const async def rpc_textDocument_documentHighlight(self, params) {
		var textDocument = params['textDocument']
		var position = params['position']
		return self.flatten(self.hook('onDocumentHighlight', textDocument['uri'], position))
	}

	- const async def rpc_textDocument_hover(self, params) {
			var textDocument = params['textDocument']
			var position = params['position']
			if let hovers = self.hook('onHover', textDocument['uri'], position) {
					for let hover in hovers {
							if defined hover {
									return hover
							}
					}
			}
			return {'contents': ''}
	}

	- const async def rpc_textDocument_documentSymbol(self, params) {
		var textDocument = params['textDocument']
		return self.flatten(self.hook('onDocumentSymbols', textDocument['uri']))
	}

	- const async def rpc_textDocument_formatting(self, params) {
		var textDocument = params['textDocument']
		var options = params['options']
		return self.hook('onFormatDocument', textDocument['uri'], options)
	}

	- const async def rpc_textDocument_rename(self, params) {
		var textDocument = params['textDocument']
		var position = params['position']
		var newName = params['newName']
		return self.hook('onRename', textDocument['uri'], position, newName)
	}

	- const async def rpc_textDocument_foldingRange(self, params) {
		var textDocument = params['textDocument']
		return self.flatten(self.hook('onFoldingRange', textDocument['uri']))
	}

	- const async def rpc_textDocument_rangeFormatting(self, params) {
		var textDocument = params['textDocument']
		var range = params['range']
		var options = params['options']
		return self.hook('onFormatRange', textDocument['uri'], range, options)
	}

	- const async def rpc_textDocument_references(self, params) {
		var textDocument = params['textDocument']
		var position = params['position']
		var context = params['context']
		var includeDeclaration = context['includeDeclaration']
		return self.flatten(self.hook('onReferences', textDocument['uri'], position, includeDeclaration))
	}

	- const async def rpc_textDocument_signatureHelp(self, params) {
		var textDocument = params['textDocument']
		var position = params['position']
		return self.hook('onSignatureHelp', textDocument['uri'], position)
	}

	- const async def rpc_workspace__didChangeConfiguration(self, params) {
		var settings = params['settings']
		if defined self.config {
			self.config.update((settings or {}).get('minter', {}))
		}
		for var workspace in self.workspaces.values() {
			workspace.updateConfig(settings)
			for docUri in workspace.documents {
				self.lint(docUri, false)
			}
		}
	}

	- const async def rpc_workspace__didChangeWorkspaceFolders(self, params) {
		var event = params['event']
		if not defined event {
			return none
		}

		var added = event.get('added', [])
		var removed = event.get('removed', [])

		for let removedInfo in removed {
			if 'uri' in removedInfo {
				self.workspaces.remove(removedInfo['uri'])
			}
		}

		for let addedInfo in added {
			if 'uri' in addedInfo {
				let added_uri = addedInfo['uri']
				let workspace_config = MintLspConfig(added_uri, self.config.getInitOptions(), self.config.getProcessId(), self.config.getCapabilities())
				workspace_config.update(self.config._settings)
				self.workspaces[added_uri] = MintLspWorkspace(added_uri, self.jsonRpcEndpoint, workspace_config)
			}
		}

		var rootWorkspaceRemoved = removed.anyOf(def [self] (removedInfo) {
			var uri = removedInfo.get('uri')
			if not defined uri {
				return false
			}
			if uri == self.rootUri {
				return true
			}
			if let workspace = self.workspaces.get(self.rootUri) {
				if uri == workspace.getRootUri()?.toString() {
					return true
				}
				var removedPath = uri?.toUrl()?.toFile()?.getAbsolutePath()
				return defined removedPath and removedPath == workspace.getRootPath()
			}
			return false
		})
		var workspaceAdded = not added.isEmpty() and 'uri' in added[0]
		if rootWorkspaceRemoved and workspaceAdded {
			let added_uri = added[0]['uri']
			self.rootUri = added_uri
			new_root_workspace = self.workspaces[added_uri]
			self.config = new_root_workspace._config
			self.workspace = new_root_workspace
		} elif rootWorkspaceRemoved {
			// NOTE: Removing the root workspace can only happen when the server
			// is closed, thus the else condition of this if can never happen.
			if self.workspaces {
				logger.debug('Root workspace deleted!')
				let available_workspaces = sorted(self.workspaces)
				let first_workspace = available_workspaces[0]
				let new_root_workspace = self.workspaces[first_workspace]
				self.rootUri = first_workspace
				self.config = new_root_workspace._config
				self.workspace = new_root_workspace
			}
		}

		// Migrate documents that are on the root workspace and have a better
		// match now
		var docUris = self.workspace.documents ? self.workspace.documents.keys() : []
		for let uri in docUris {
			let doc = self.workspace.documents.pop(uri)
			let newWorkspace = self.getWorkspaceFromUrl(uri)
			if newWorkspace {
				newWorkspace.documents[uri] = doc
			}
		}
	}

	- const async def rpc_workspace__didChangeWatchedFiles(self, params) {
		var changes = params.get('changes')
		var changedMintFiles = Container.Set()
		var configChanged = false
		for let d in changes {
			let uri = d.get('uri', '')
			if uri.endsWith('.mn') {
				changedMintFiles.insert(uri)
			} elif uri.endsWith(MintLspConfig.ConfigFileName) {
				configChanged = true
			}
		}

		if configChanged {
			self.config.settings.cache_clear()
		} elif changedMintFiles.isEmpty() {
			// Only externally changed python files and lint configs may result in changed diagnostics.
			return none
		}

		for let workspace in self.workspaces.values() {
			for let docUri in workspace.getDocuments() {
				// Changes in docUri are already handled by rpc_textDocument_did_save
				if docUri not in changedMintFiles {
					self.lint(docUri, false)
				}
			}
		}
	}

	- const async def rpc_workspace__executeCommand(self, params) {
		var command = params['command']
		var arguments = params['arguments']
		return self.hook('onExecuteCommand', command, arguments)
	}

	- const async def rpc_shutdown(self, params) {
		for workspace in self.workspaces.values() {
			workspace.close()
		}
		self.shutdown = true
		return null
	}

	- const async def rpc_exit(self, params) {
		self.running = false
	}

	- const def hasCapability(self, hookName, workspace) {
		var config = workspace.getConfig()
		return config.getPluginManager().hasHookFor(hookName, config.getDisabledPlugins())
	}

	/**
	 * Calls hookName and returns a list of results from all registered handlers
	 */
	- const def hook(self, hookName, docUri, ...) {
		logger.debug('Call hook for %s on %s', hookName, docUri)
		if let workspace = self.getWorkspaceFromUrl(docUri) {
			let document = workspace.getDocument(docUri)
			if let config = workspace.getConfig() {
				let hookHandlers = config.getPluginManager().subSetHookCaller(hookName, config.getDisabledPlugins())
				return hookHandlers(config, workspace, document, *va_args)
			}
		}
	}

	- const def lint(self, docUri, isSaved) {
		if var workspace = self.getWorkspaceFromUrl(docUri) {
			if docUri in workspace.getDocuments() {
				workspace.publishDiagnostics(docUri, self.flatten(self.hook('onLint', docUri, isSaved)))
			}
		}
	}

	- const def scheduleLint(self, docUri) {
		if docUri in self.pendingLints {
			self.pendingLints[docUri]['generation']++
			return none
		}

		let pending = {
			'generation': 1,
			'timer': System.AsyncTimer(self.scheduler)
		}
		self.pendingLints[docUri] = pending
		self.scheduler.spawn(self.debounceLint(docUri, pending))
	}

	- const def cancelPendingLint(self, docUri) {
		if docUri in self.pendingLints {
			self.pendingLints.remove(docUri)
		}
	}

	- const async def debounceLint(self, docUri, pending) {
		while docUri in self.pendingLints and self.pendingLints[docUri] is pending {
			let generation = pending['generation']
			await pending['timer'].wait(300)

			if docUri not in self.pendingLints or self.pendingLints[docUri] is not pending {
				return none
			}
			if pending['generation'] == generation {
				self.pendingLints.remove(docUri)
				self.lint(docUri, false)
				return none
			}
		}
	}

	- @const def flatten(results) {
		return [for let list in results => for let item in list => item]
	}

	- final scheduler: Runtime.Scheduler? = none
	- final pendingLints = {}
	- final watchingThread: System.Thread? = none
	- final workspaces = {}
	- final uriWorkspaceMapper = {}

	- final checkParentProcess: boolean = false
	- final jsonRpcEndpoint: function? = none
	- final jsonRpcStream = null
	- final shutdown = false
	- final running = false
	- final traceValue = 'off'
}

/**
 * Starts a language server described by the `MintLspServerClass` class initialized
 * to communicate using a TCP socket listening on the address `address` an the port
 * `port`. If the `checkParentProcess` is set to `true`, the server will automatically
 * be closed if its parent process is closed.
 */
@def startTcpLangServer(address: string, port: number, checkParentProcess: boolean, MintLspServerClass = MintLspServer) {

	const shutdownServer = def (checkParentProcess, server) {
		if checkParentProcess {
			logger.debug('Shutting down server')
			// Shutdown call must be done on a thread, to prevent deadlocks
			var stopThread = System.Thread(server, server.close)
			stopThread.start()
		}
	}

	// Construct a custom wrapper class around the user's MintLspServerClass
	const WrapperClass = type(typeof MintLspServerClass + 'Handler', [Network.JsonRpc.RequestHandler], {
		'new': def [MintLspServerClass, checkParentProcess] (self, endpoint, configuration) {
			Network.JsonRpc.RequestHandler.new(self as Network.JsonRpc.RequestHandler, endpoint, configuration)
			self.delegate = MintLspServerClass(self, checkParentProcess)
			return self
		},
		'onOpen': def (self, channel) {
			try {
				channel.setNonBlocking(false)
			} catch error {
				if not SocketError.isBaseOf(e) or System.OS.getType() != System.OSType.Windows {
					raise
				}
				if error.getErrno() != OSError.Errno.ECONNRESET {
					raise
				}
				// Catch and pass on ConnectionResetError when parent process dies
			}
		},
		'onClose': def [shutdownServer, checkParentProcess] (self, channel) {
			shutdownServer(checkParentProcess, channel)
		},
		'onMessage': def (self, channel) {
			while var message = channel.read() {
				self.delegate.consume(message)
			}
		},
		private('delegate'): null
	})

	let socket: Network.TcpSocket = Network.TcpSocket()
	socket.setSocketOption(Network.SocketOption.REUSEADDR, true)

	let channel: Network.JsonRpc.Server = Network.JsonRpc.Server(socket, WrapperClass)
	channel.listen(Network.IpEndpoint = Network.IpEndpoint(address, port))
	logger.info('Serving %s on (%s, %s)', typeof MintLspServerClass, address, port)
	let server = MintLspServerClass(channel, checkParentProcess)
	server.start()
}

/**
 * Starts a language server described by the `MintLspServerClass` class initialized
 * to communicate using a web socket listening on the the port `port`. If the
 * `checkParentProcess` is set to `true`, the server will automatically be closed if
 * its parent process is closed.
 */
@def startWSLangServer(port: number, checkParentProcess: boolean, MintLspServerClass = MintLspServer) {
	
}

/**
 * Starts a language server described by the `MintLspServerClass` class initialized
 * to communicate using the {System.IO} object. If the `checkParentProcess` is
 * set to `true`, the server will automatically be closed if its parent process is
 * closed.
 */
@def startIOLangServer(checkParentProcess: boolean, MintLspServerClass = MintLspServer) {
	logger.info('Starting %s IO language server', typeof MintLspServerClass)
	logger.debug("Creating Network.StdioSocket")
	let socket: Network.StdioSocket = Network.StdioSocket()
	socket.bind(Network.StdioEndpoint(System.stdin, System.stdout))
	logger.debug("Creating Channel")
	let channel: Network.Channel = Network.Channel(socket, Network.JsonRpc.Serializer)
	if not channel {
		logger.error("Failed to create Channel")
		return none
	}
	logger.info("Creating and starting MintLspServer")
	var server = MintLspServerClass(channel, checkParentProcess)
	server.start()
}
