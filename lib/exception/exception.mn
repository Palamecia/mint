load mint.type

package Exception {

/**
 * This class provides a base to create exception contexts.
 */
class Exception {}

/**
 * This class provides a default runtime exception implementation that contains an error message.
 */
class RuntimeError : Exception.Exception {
    /**
     * Creates a runtime error with the `message` error message.
     */
    const def new(self, message) {
        self.message = message
        return self
    }

    /**
     * Returns the error message.
     */
    const def toString(const self) {
        return self.message
    }

    /// Internal error message.
    - final message = ''
}

}
