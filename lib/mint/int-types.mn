}

/**
 * Converts `self` to {int8}. If `value` is already a {int8}, the object is returned; otherwise, if it provides a
 * `toInt8` method, the result of the method call is returned; otherwise, a new object is created.
 */
@const def toInt8(self) -> int8 {
	if typeof self === 'int8' {
		return self
	}
	if defined self.toInt8 {
		return self.toInt8() as int8
	}
	return int8(self)
}

