/**
 * This class provides a signed integer representation encoded on 8 bits.
 */
@final class int8 {
	/**
	 * Creates a new integer initialized to `value`.
	 */
	const def new(self, value = 0) -> int8 {
		if typeof value === 'int8' {
			return value
		}
		if defined value.toInt8 {
			return value.toInt8() as int8
		}
		self.d_ptr = int8.g_lib.call('mint_int8_create', value)
		self.d_ptr.delete = def [g_lib = int8.g_lib] (self) {
			g_lib.call('mint_int8_delete', self)
		}
		return self
	}

	/**
	 * Returns the result of the `:=` operator applied to `self` and `other`.
	 */
	const def :=(self, other) {
		return int8.g_lib.call('mint_int8_copy', self, other.toInt8())
	}

	/**
	 * Returns the result of the `()` operator applied to `self`.
	 */
	const def ()(self) {
		var other = int8.g_lib.call('mint_int8_call', self, other.toInt8())
		other.d_ptr.delete = def [g_lib = int8.g_lib] (self) {
			g_lib.call('mint_int8_delete', self)
		}
		return other
	}

	/**
	 * Returns the result of the `+` operator applied to `self` and `other`.
	 */
	const def +(self, other) {
		return int8.g_lib.call('mint_int8_add', self, other.toInt8())
	}

	/**
	 * Returns the result of the `-` operator applied to `self` and `other`.
	 */
	const def -(self, other) {
		return int8.g_lib.call('mint_int8_sub', self, other.toInt8())
	}

	/**
	 * Returns the result of the `*` operator applied to `self` and `other`.
	 */
	const def *(self, other) {
		return int8.g_lib.call('mint_int8_mul', self, other.toInt8())
	}

	/**
	 * Returns the result of the `/` operator applied to `self` and `other`.
	 */
	const def /(self, other) {
		return int8.g_lib.call('mint_int8_div', self, other.toInt8())
	}

	/**
	 * Returns the result of the `**` operator applied to `self` and `other`.
	 */
	const def **(self, other) {
		return int8.g_lib.call('mint_int8_pow', self, other.toInt8())
	}

	/**
	 * Returns the result of the `%` operator applied to `self` and `other`.
	 */
	const def %(self, other) {
		return int8.g_lib.call('mint_int8_mod', self, other.toInt8())
	}

	/**
	 * Returns the result of the `==` operator applied to `self` and `other`.
	 */
	const def ==(self, other) {
		return int8.g_lib.call('mint_int8_eq', self, other.toInt8())
	}

	/**
	 * Returns the result of the `!=` operator applied to `self` and `other`.
	 */
	const def !=(self, other) {
		return int8.g_lib.call('mint_int8_ne', self, other.toInt8())
	}

	/**
	 * Returns the result of the `<` operator applied to `self` and `other`.
	 */
	const def <(self, other) {
		return int8.g_lib.call('mint_int8_lt', self, other.toInt8())
	}

	/**
	 * Returns the result of the `>` operator applied to `self` and `other`.
	 */
	const def >(self, other) {
		return int8.g_lib.call('mint_int8_gt', self, other.toInt8())
