 * @module
 * This module provides tools to access the stacktrace.
 */

/**
 * This class provides a stack frame informations about an exception's stacktrace.
 */
@class StackFrame {
    /**
     * Creates an new stack frame for the module with ID `moduleId`, named `moduleName` at line `lineNumber`.
     */
    const def new(self, moduleId, moduleName, lineNumber) {
        self.d_ptr = StackFrame.g_lib.call('mint_stack_frame_from_id', moduleId, moduleName, lineNumber)
        self.d_ptr.delete = def [g_lib = Exception.StackFrame.g_lib] (self) {
            g_lib.call('mint_stack_frame_delete', self)
        }
        return self
    }

    /**
     * Creates an new stack frame for the module named `moduleName` at line `lineNumber`.
     */
    const def new(self, moduleName, lineNumber) {
        self.d_ptr = StackFrame.g_lib.call('mint_stack_frame_from_name', moduleName, lineNumber)
        self.d_ptr.delete = def [g_lib = Exception.StackFrame.g_lib] (self) {
            g_lib.call('mint_stack_frame_delete', self)
        }
        return self
    }

    /**
     * Returns the module ID as a number.
     */
	const def getModuleId(const self) {
        return StackFrame.g_lib.call('mint_stack_frame_get_module_id', self.d_ptr)
    }

    /**
     * Returns the module name as a string.
     */
	const def getModuleName(const self) {
        return StackFrame.g_lib.call('mint_stack_frame_get_module_name', self.d_ptr)
    }

    /**
     * Returns the line number as a number.
     */
	const def getLineNumber(const self) {
        return StackFrame.g_lib.call('mint_stack_frame_line_number', self.d_ptr)
    }

    /**
     * Returns the line content as a string.
     */
	const def getSourceLine(const self) {
        return StackFrame.g_lib.call('mint_stack_frame_source_line', self.d_ptr)
    }

    /**
     * Returns the string representation of the stack frame.
     */
	const def toString(const self) {
        return StackFrame.g_lib.call('mint_stack_frame_to_string', self.d_ptr)
    }

    /**
     * Returns the module path in the filesystem as a string.
     */
	const def getSystemPath(const self) {
        return StackFrame.g_lib.call('mint_stack_frame_get_system_path', self.d_ptr)
    }

    /**
     * Returns the module file name in the filesystem as a string.
     */
	const def getSystemFileName(const self) {
        return StackFrame.g_lib.call('mint_stack_frame_get_system_file_name', self.d_ptr)
    }

    /// Global library handle.
    - @const g_lib = lib('libmint-mint')

    /// Object data.
    - final d_ptr = null
}

/**
 * Returns the current stacktrace as an array of {StackFrame}. The array starts from the oldest call to the most recent
 * one. If the `threadId` parameter is given, the stacktrace of the thread * with the given id is used; otherwise the
 * current thread is used.
 */
@def [g_lib = lib('libmint-mint')] stacktrace() {
    return [for let (id, name, line) in g_lib.call('mint_lang_stacktrace') => StackFrame(id, name, line)]
}
