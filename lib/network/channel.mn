 * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
 * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS
 * IN THE SOFTWARE.
 *
 * @module
 * This module provides message-oriented channel abstractions for exchanging
 * protocol messages over a network socket.
 *
 * The implementations are split by execution model:
 *
 * - {Network.Channel} performs synchronous exchanges and returns immediately
 *   when a read or write operation can be completed.
 * - {Network.AsyncChannel} exposes coroutine-friendly methods that suspend
 *   until the underlying socket becomes ready for the requested operation.
 * - {Network.EventChannel} is designed for event-driven usage and integrates
 *   with the polling layer so it can be driven by readiness notifications.
 *
 * In all cases, the underlying socket is responsible for the low-level I/O and
 * the serializer is responsible for framing and decoding message objects.
 */
 
load network.serializers.text
load runtime.operation
load mint.lock-guard
load mint.function
load system.thread

package Network {

	/**
	 * This class provides synchronous, message-oriented communication over a
	 * socket using a serializer.
	 *
	 * Each operation is attempted immediately. If the underlying socket is not
	 * yet ready, the operation returns `false` or `none`, and the caller can
	 * retry later or switch to one of the other channel abstractions.
	 *
	 * This class is well suited for explicit I/O loops and for code that wants
	 * to control buffering and readiness handling itself.
	 *
	 * For coroutine-based flows, prefer {Network.AsyncChannel}. For event-driven
	 * loops that are driven by {Network.Poller}, prefer {Network.EventChannel}.
	 */
	@class Channel {
		/**
		 * Creates a new channel to manage synchronous exchanges with the
		 * device described by `socket`. The `socket` parameter must
		 * implement the {Network.Socket} interface. The `Serializer` parameter
		 * must be a class implementing the {@module network.serializers} interface
		 * used to detect messages end and convert exchanged data into objects.
		 * 
		 * If the `socket` parameter is `none`, the channel is not created.
		 */
		const def new(self, socket, Serializer = Network.TextSerializer) {
			if self.socket = socket {
				self.request = Serializer()
				self.reply = Serializer()
				return self
			}
		}

		/**
		 * Attempts to make a connection to the remote device identified by `endpoint`. Returns `true` if connection
		 * succeed; otherwise returns `false`. This method calls the {Network.Socket.connect} method of the underlying
		 * object.
		 * 
		 * If the method returns `false` and the underlying end point enters the {Network.Socket.State.Connecting}
		 * state, the connection must be finalized later using the {@see finalizeConnection} method.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def connect(self, endpoint) {
			try {
				if not self.socket.connect(endpoint) {
					return false
				}
			} catch error {
				if typeof error === 'Exception.SocketError' {
					raise in Exception.SocketError(error.getErrno(), self)
				} else {
					raise
				}
			}
			return true
		}

		/**
		 * Finalize the connection to the peer. Return `true` if the connection
		 * succeed; otherwise returns `false`. This method calls the
		 * {Network.Socket.finalizeConnection} method of the underlying end
		 * point.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def finalizeConnection(self) {
			try {
				return self.socket.finalizeConnection()
			} catch error {
				if typeof error === 'Exception.SocketError' {
					raise in Exception.SocketError(error.getErrno(), self)
				} else {
					raise
				}
			}
			return false
		}

		/**
		 * Attempts to bind the channel to the remote device identified by `endpoint`. Returns `true` if binding
		 * succeed; otherwise returns `false`. This method calls the {Network.Socket.bind} method of the underlying
		 * object.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def bind(self, endpoint) {
			try {
				if not self.socket.bind(endpoint) {
					return false
				}
			} catch error {
				if typeof error === 'Exception.SocketError' {
					raise in Exception.SocketError(error.getErrno(), self)
				} else {
					raise
				}
			}
			return true
		}

		/**
		 * Tells the channel to listen for incoming connections on address configured by `endpoint`. Returns `true` on
		 * success; otherwise returns `false`. This method calls the {Network.Socket.listen} method of the underlying
		 * object. The {Network.ServerSerializer} should be used has serializer class to correctly handle incoming
		 * connections.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def listen(self, endpoint) {
			try {
				if not self.socket.listen(endpoint) {
					return false
				}
			} catch error {
				if typeof error === 'Exception.SocketError' {
					raise in Exception.SocketError(error.getErrno(), self)
				} else {
					raise
				}
			}
			return true
		}

		/**
		 * Writes the pending data to the underlying socket. Returns `true` if the write operation succeed; otherwise
		 * returns `false` and the remaining data should be sent later.
		 * 
		 * The message object will be converted to {Serializer.DataStream} using the serializer class and sent to the
		 * peer using the {Network.Socket.write} method of the underlying socket.
		 */
		const def write(self) {
			while not self.request.isEmpty() {
				if not self.request.write(self.socket) {
					return false
				}
			}
			return true
		}

		/**
		 * Writes the message object described by `data` to the underlying socket. Returns `true` if the write operation
		 * succeed; otherwise returns `false` and the remaining data should be sent later using {@see write}.
		 * 
		 * The message object will be converted to {Serializer.DataStream} using the serializer class and sent to the
		 * peer using the {Network.Socket.write} method of the underlying socket.
		 */
		const def write(self, data) {
			self.request.appendMessage(data)
			while not self.request.isEmpty() {
				if not self.request.write(self.socket) {
					return false
				}
			}
			return true
		}

		/**
		 * Returns the next message object in the reply queue or `none` if no more message is available.
		 * 
		 * The message objects are created from a {Serializer.DataStream} using the serializer class. The serializer
		 * must receive enough data from the peer to construct a message using the {Network.Socket.read} method of the
		 * underlying socket.
		 */
		const def read(self) {
			if self.reply.containsMessage() {
				return self.reply.nextMessage()
			}
			switch self.socket.getState() {
			case Network.Socket.State.Bound:
			case Network.Socket.State.Connected:
				while self.reply.read(self.socket) {
					if self.reply.containsMessage() {
						return self.reply.nextMessage()
					}
				}
				break
			case Network.Socket.State.Listening:
				while self.reply.accept(self.socket) {
					if self.reply.containsMessage() {
						return self.reply.nextMessage()
					}
				}
				break
			default:
				break
			}
		}

		/**
		 * Disable sends or receives on the socket if it was in the {Network.Socket.State.Connected} state or stops
		 * listening if it was in the {Network.Socket.State.Listening} state. This method calls the
		 * {Network.Socket.shutdown} method of the underlying object.
		 * 
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def shutdown(self) {
			try {
				self.socket.shutdown()
			} catch error {
				if typeof error === 'Exception.SocketError' {
					raise in Exception.SocketError(error.getErrno(), self)
				} else {
					raise
				}
			}
			return false
		}

		/**
		 * Closes the communication with the peer if the channel was connected using the {@see connect} method or stops
		 * listening if the channel was opened with {@see listen}. This method calls the {Network.Socket.close} method
		 * of the underlying object.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def close(self) {
			try {
				self.socket.close()
			} catch error {
				if typeof error === 'Exception.SocketError' {
					raise in Exception.SocketError(error.getErrno(), self)
				} else {
					raise
				}
			}
		}

		/**
		 * Returns the channel's socket's handle as an instance of `mint::handle_t`. This method calls the
		 * {Network.Socket.getHandle} method of the underlying object.
		 */
		const def getHandle(const self) {
			return self.socket.getHandle()
		}

		/**
		 * Returns the underlying end point object.
		 */
		const def getSocket(const self) {
			return self.socket
		}

		/**
		 * Returns `true` if the underlying socket is open; otherwise returns `false`.
		 */
		const def isOpen(const self) {
			return self.socket.isOpen()
		}

		/**
		 * Returns the current state of the channel as a value of
		 * {Network.Socket.State}. This method calls the {Network.Socket.getState}
		 * method of the underlying object.
		 */
		const def getState(const self) {
			return self.socket.getState()
		}

		/**
		 * Returns `true` if the channel performs I/O operations asynchronously
		 * (i.e. read or write data without blocking other channels); otherwise
		 * returns `false`. This method calls the {Network.Socket.isNonBlocking}
		 * method of the underlying object.
		 */
		const def isNonBlocking(const self) {
			return self.socket.isNonBlocking()
		}

		/**
		 * Sets the non blocking mode of the channel to `enabled`. This method
		 * calls the {Network.Socket.setNonBlocking} method of the underlying
		 * object. Returns `true` if the mode was successfully changed; otherwise
		 * returns `false`.
		 * 
		 * > [!WARNING]
		 * > Disable the non blocking mode on a channel can slow down any network
		 * > I/O operations of the application. Other channels will not be able
		 * > to perform I/O operations until the current operation's
		 * > acknowledgment by the peer.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def setNonBlocking(self, enabled) {
			try {
				return self.socket.setNonBlocking(enabled)
			} catch error {
				if typeof error === 'Exception.SocketError' {
					raise in Exception.SocketError(error.getErrno(), self)
				} else {
					raise
				}
			}
		}

		/// Internal underlying socket.
		- final socket = null
		
		/// Internal serializer object for writing requests.
		- final request = null
		
		/// Internal serializer object for reading replies.
		- final reply = null
	}

	/**
	 * This class provides coroutine-friendly, message-oriented communication over
	 * a socket using a serializer.
	 *
	 * The `read`, `write`, and `close` operations are asynchronous and may
	 * suspend the current coroutine until the underlying socket is ready for the
	 * requested operation. This class is intended for use with {Runtime.Scheduler}
	 * and Mint coroutines.
	 *
	 * When an operation cannot complete immediately, the scheduler resumes the
	 * coroutine once the socket becomes readable, writable, or otherwise ready.
	 */
	@class AsyncChannel {
		/**
		 * Creates a new asynchronous channel to manage exchanges with the asynchronous device described by `socket`.
		 */
		const def new(self, socket, Serializer = Network.AsyncTextSerializer) {
			if self.socket = socket {
				self.request = Serializer()
				self.reply = Serializer()
				return self
			}
		}

		/**
		 * Attempts to make a connection to the remote device identified by `endpoint`. Returns `true` if connection
		 * succeed; otherwise returns `false`. This method calls the {Network.Socket.connect} method of the underlying
		 * object.
		 * 
		 * This method suspends the current coroutine until the connection attempt either succeeds or fails.
		 *
		 * If the method returns `false` and the underlying end point enters the {Network.Socket.State.Connecting}
		 * state, the connection must be finalized later using the {@see finalizeConnection} method.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const async def connect(self, endpoint) {
			try {
				if not await self.socket.connect(endpoint) {
					return false
				}
			} catch error {
				if typeof error === 'Exception.SocketError' {
					raise in Exception.SocketError(error.getErrno(), self)
				} else {
					raise
				}
			}
			return true
		}

		/**
		 * Attempts to bind the channel to the remote device identified by `endpoint`. Returns `true` if binding
		 * succeed; otherwise returns `false`. This method calls the {Network.Socket.bind} method of the underlying
		 * object.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def bind(self, endpoint) {
			try {
				if not self.socket.bind(endpoint) {
					return false
				}
			} catch error {
				if typeof error === 'Exception.SocketError' {
					raise in Exception.SocketError(error.getErrno(), self)
				} else {
					raise
				}
			}
			return true
		}

		/**
		 * Tells the channel to listen for incoming connections on address configured by `endpoint`. Returns `true` on
		 * success; otherwise returns `false`. This method calls the {Network.Socket.listen} method of the underlying
		 * object. The {Network.ServerSerializer} should be used has serializer class to correctly handle incoming
		 * connections.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def listen(self, endpoint) {
			try {
				if not self.socket.listen(endpoint) {
					return false
				}
			} catch error {
				if typeof error === 'Exception.SocketError' {
					raise in Exception.SocketError(error.getErrno(), self)
				} else {
					raise
				}
			}
			return true
		}

		/**
		 * Writes the pending data to the underlying socket. Returns `true` if the write operation succeed; otherwise
		 * returns `false` and the remaining data should be sent later.
		 * 
		 * This method suspends the current coroutine until the write operation completes.
		 *
		 * The message object will be converted to {Serializer.DataStream} using the serializer class and sent to the
		 * peer using the {Network.Socket.write} method of the underlying socket.
		 */
		const async def write(self) {
			while not self.request.isEmpty() {
				if not await self.request.write(self.socket) {
					return false
				}
			}
			return true
		}

		/**
		 * Writes the message object described by `data` to the underlying socket. Returns `true` if the write operation
		 * succeed; otherwise returns `false` and the remaining data should be sent later using {@see write}.
		 * 
		 * This method suspends the current coroutine until the write operation completes.
		 *
		 * The message object will be converted to {Serializer.DataStream} using the serializer class and sent to the
		 * peer using the {Network.Socket.write} method of the underlying socket.
		 */
		const async def write(self, data) {
			self.request.appendMessage(data)
			while not self.request.isEmpty() {
				if not await self.request.write(self.socket) {
					return false
				}
			}
			return true
		}

		/**
		 * Returns the next message object in the reply queue or `none` if no more message is available.
		 * 
		 * This method suspends the current coroutine until the read operation completes.
		 *
		 * The message objects are created from a {Serializer.DataStream} using the serializer class. The serializer
		 * must receive enough data from the peer to construct a message using the {Network.Socket.read} method of the
		 * underlying socket.
		 */
		const async def read(self) {
			if self.reply.containsMessage() {
				return self.reply.nextMessage()
			}
			switch self.socket.getState() {
			case Network.Socket.State.Bound:
			case Network.Socket.State.Connected:
				while await self.reply.read(self.socket) {
					if self.reply.containsMessage() {
						return self.reply.nextMessage()
					}
				}
				break
			case Network.Socket.State.Listening:
				while await self.reply.accept(self.socket) {
					if self.reply.containsMessage() {
						return self.reply.nextMessage()
					}
				}
				break
			default:
				break
			}
		}

		/**
		 * Closes the communication with the peer. Returns `true` if the channel was successfully closed; otherwise
		 * returns `false`.
		 *
		 * The underlying synchronous close attempt is performed by {Network.AsyncSocket.close}.
		 *
		 * On success, the channel enters the {Network.Socket.State.Closed} state.
		 *
		 * On failure, the channel enters the {Network.Socket.State.Error} state.
		 */
		const def close(self) {
			return self.socket.close()
		}

		/**
		 * Returns the scheduler associated with the object. This method calls
		 * the {Network.Socket.getScheduler} method of the underlying object.
		 */
		const def getScheduler(const self) {
			return self.socket.getScheduler()
		}

		/**
		 * Returns the channel's socket's handle as an instance of `mint::handle_t`. This method calls the
		 * {Network.Socket.getHandle} method of the underlying object.
		 */
		const def getHandle(const self) {
			return self.socket.getHandle()
		}

		/**
		 * Returns the underlying end point object.
		 */
		const def getSocket(const self) {
			return self.socket
		}

		/**
		 * Returns `true` if the underlying socket is open; otherwise returns `false`.
		 */
		const def isOpen(const self) {
			return self.socket.isOpen()
		}

		/**
		 * Returns the current state of the underlying socket as a value of
		 * {Network.Socket.State}.
		 */
		const def getState(const self) {
			return self.socket.getState()
		}

		/// Internal underlying socket.
		- final socket = null
		
		/// Internal serializer object for writing requests.
		- final request = null
		
		/// Internal serializer object for reading replies.
		- final reply = null
	}

	/**
	 * This class provides event-driven, message-oriented communication over a
	 * socket using a serializer.
	 *
	 * It is intended for code that consumes readiness notifications from
	 * {Network.Poller} rather than relying on coroutine suspension. Operations
	 * are driven by state and readiness callbacks and are suitable for
	 * applications that manage their own event loop or integrate with the
	 * poller infrastructure.
	 */
	@class EventChannel {
		/**
		 * Creates a new channel to manage asynchronous exchanges with the device described by `socket`. The `socket`
		 * parameter must implement the {Network.Socket} interface. The `Serializer` parameter must be a class
		 * implementing the {@module network.serializers} interface used to detect messages end and convert exchanged
		 * data into objects.
		 * 
		 * If the `socket` parameter is `none`, the channel is not created. The call to {Network.Socket.setNonBlocking}
		 * must succeed to create the channel. The channel is created in non blocking mode and the `socket` parameter is
		 * configured to call the channel's {@see notifyStateChanged}, {@see notifyReadable}, {@see notifyWritable},
		 * {@see notifyConnection}, {@see notifyClosed} and {@see notifyError} methods on state change, readability,
		 * writability, new connection, close and error events respectively.
		 */
		const def new(self, socket, Serializer = Network.TextSerializer) {
			if self.socket = socket {
				self.socket.onState = Callback(self, self.notifyStateChanged)
				self.request = Network.EventChannel.DataQueue(Serializer)
				self.reply = Network.EventChannel.DataQueue(Serializer)
				return self
			}
		}

		/**
		 * Returns `true` if `other` is equal to this channel; otherwise returns `false`.
		 */
		const def ==(const self, const other) {
			return self is other
		}

		/**
		 * Returns `false` if `other` is equal to this channel; otherwise returns `true`.
		 */
		const def !=(const self, const other) {
			return not (self is other)
		}

		/**
		 * Attempts to make a connection to the remote device identified by `endpoint`. This method calls the
		 * {Network.Socket.connect} method of the underlying object.
		 * 
		 * The channel is connected asynchronously when the connection is accepted by the peer. The connection will be
		 * finalized if {Network.poll} is called on this instance. On connection success, the {@see onOpen} method will
		 * be called.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def connect(self, endpoint) {
			try {
				if not self.socket.connect(endpoint) {
					return false
				}
			} catch error {
				if typeof error === 'Exception.SocketError' {
					raise in Exception.SocketError(error.getErrno(), self)
				} else {
					raise
				}
			}
			if self.socket.getState() is Network.Socket.State.Connected {
				self.onOpen(self)
			}
			return true
		}

		/**
		 * Attempts to bind the channel to the remote device identified by `endpoint`. Returns `true` if binding
		 * succeed; otherwise returns `false`. This method calls the {Network.Socket.bind} method of the underlying
		 * object.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def bind(self, endpoint) {
			try {
				if not self.socket.bind(endpoint) {
					return false
				}
			} catch error {
				if typeof error === 'Exception.SocketError' {
					raise in Exception.SocketError(error.getErrno(), self)
				} else {
					raise
				}
			}
			if self.socket.getState() is Network.Socket.State.Bound {
				self.onOpen(self)
			}
			return true
		}

		/**
		 * Tells the channel to listen for incoming connections on address configured by `endpoint`. Returns `true` on
		 * success; otherwise returns `false`. This method calls the {Network.Socket.listen} method of the underlying
		 * object. The {Network.ServerSerializer} should be used has serializer class to correctly handle incoming
		 * connections.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def listen(self, endpoint) {
			try {
				if not self.socket.listen(endpoint) {
					return false
				}
			} catch error {
				if typeof error === 'Exception.SocketError' {
					raise in Exception.SocketError(error.getErrno(), self)
				} else {
					raise
				}
			}
			if self.socket.getState() is Network.Socket.State.Listening {
				self.onOpen(self)
			}
			return true
		}

		/**
		 * Pushes the message object described by `data` to the request queue.
		 * 
		 * The message is not sent directly but will be sent asynchronously when
		 * the underlying end point will become writable if the channel is watched
		 * (see {@see watch}) and {Runtime.Scheduler.synchronize} is called or if
		 * {Runtime.Scheduler.poll} is called with an instance of
		 * {Runtime.Scheduler.PollDescriptor} created for this object.
		 * 
		 * The message object will then be converted to {Serializer.DataStream}
		 * using the serializer class and sent to the peer using the
		 * {Network.Socket.write} method of the underlying end point.
		 */
		const def write(self, data) {
			return self.request.push(data)
		}

		/**
		 * Returns the next message object in the reply queue or `none` if no
		 * more message is available.
		 * 
		 * Messages are added asynchronously when the underlying end point become
		 * readable if the channel is watched (see {@see watch}) and
		 * {Runtime.Scheduler.synchronize} is called or if
		 * {Runtime.Scheduler.poll} is called with an instance of
		 * {Runtime.Scheduler.PollDescriptor} created for this object.
		 * 
		 * The message objects are created from a {DataStreamSerializer.} using
		 * the serializer class. The serializer must receive enough data from the
		 * peer to construct a message using the {Network.Socket.read} method
		 * of the underlying end point.
		 */
		const def read(self) {
			return self.reply.pop()
		}

		/**
		 * Closes the communication with the peer if the channel was connected
		 * using the {@see connect} method or stops listening if the channel was
		 * opened with {@see listen}. This method calls the {Network.Socket.close}
		 * method of the underlying object. If the socket was successfully closed,
		 * {@see onClose} is called; otherwise the socket will be closed later.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def close(self) {
			let closed = false
			try {
				if not defined self.socket.shutdown or self.socket.shutdown() {
					self.socket.close()
					closed = true
				}
			} catch error {
				if typeof error === 'Exception.SocketError' {
					raise in Exception.SocketError(error.getErrno(), self)
				} else {
					raise
				}
			}
			if closed {
				self.onClose(self)
			}
		}

		/**
		 * Returns the channel's socket's handle as an instance of `mint::handle_t`. This method calls the
		 * {Network.Socket.getHandle} method of the underlying object.
		 */
		const def getHandle(const self) {
			return self.socket.getHandle()
		}

		/**
		 * Returns the underlying end point object.
		 */
		const def getSocket(const self) {
			return self.socket
		}

		/**
		 * Returns `true` if the underlying socket is open; otherwise returns `false`.
		 */
		const def isOpen(const self) {
			return self.socket.isOpen()
		}

		/**
		 * Returns the current state of the channel as a value of
		 * {Network.Socket.State}. This method calls the {Network.Socket.getState}
		 * method of the underlying object.
		 */
		const def getState(const self) {
			return self.socket.getState()
		}

		/**
		 * Returns the events expected by the channel as mask of values from the
		 * {Network.PollEvent} enum.
		 */
		const def getEvents(const self) {
			const PollEvent = Network.PollEvent
			switch self.socket.getState() {
			case Network.Socket.State.Unknown:
			case Network.Socket.State.Closed:
			case Network.Socket.State.Error:
				return 0

			case Network.Socket.State.Open:
				return PollEvent.Close | PollEvent.Error

			case Network.Socket.State.Bound:
			case Network.Socket.State.Connected:
				return PollEvent.Read | PollEvent.Write | PollEvent.Close | PollEvent.Error

			case Network.Socket.State.Listening:
				return PollEvent.Accept | PollEvent.Error

			case Network.Socket.State.Connecting:
				return PollEvent.Write | PollEvent.Error

			case Network.Socket.State.Closing:
				return PollEvent.Close | PollEvent.Error
			}
		}

		/**
		 * Returns `true` if the channel performs I/O operations asynchronously
		 * (i.e. read or write data without blocking other channels); otherwise
		 * returns `false`. This method calls the {Network.Socket.isNonBlocking}
		 * method of the underlying object.
		 */
		const def isNonBlocking(const self) {
			return self.socket.isNonBlocking()
		}

		/**
		 * Sets the non blocking mode of the channel to `enabled`. This method
		 * calls the {Network.Socket.setNonBlocking} method of the underlying
		 * object. Returns `true` if the mode was successfully changed; otherwise
		 * returns `false`.
		 * 
		 * > [!WARNING]
		 * > Disable the non blocking mode on a channel can slow down any network
		 * > I/O operations of the application. Other channels will not be able
		 * > to perform I/O operations until the current operation's
		 * > acknowledgment by the peer.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def setNonBlocking(self, enabled) {
			try {
				return self.socket.setNonBlocking(enabled)
			} catch error {
				if typeof error === 'Exception.SocketError' {
					raise in Exception.SocketError(error.getErrno(), self)
				} else {
					raise
				}
			}
		}

		/**
		 * Notifies the channel that the underlying end point's state is about
		 * to change. The `state` parameter is the new state that will be
		 * applied to the end point. This value is passed to a call to
		 * {@see onState}. The previous state can still be accessed with
		 * {@see getState} until the end of the method.
		 * 
		 * > [!WARNING]
		 * > Calling {@see Network.Socket.setState} in this method can result
		 * > in an infinite loop.
		 */
		const def notifyStateChanged(self, %state) {
			self.onState(self, state)
		}

		/**
		 * Notifies the channel that the underlying end point is readable. The
		 * channel will then read all available data on the end point and send
		 * it to the serializer object. If one or more message can created with
		 * the data, {@see onMessage} is called.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def notifyReadable(self) {
			switch self.socket.getState() {
			case is Network.Socket.State.Connected:
			case is Network.Socket.State.Bound:
				try {
					var received = self.reply.read(self.socket)
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
				if received {
					self.onMessage(self)
				}
			}
		}

		/**
		 * Notifies the channel that the underlying end point is writable. The
		 * channel will then send all available data from the serializer object
		 * to the end point. If the underlying end point was connecting, the
		 * connection is finalized and {@see onOpen} is called.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def notifyWritable(self) {
			switch self.socket.getState() {
			case is Network.Socket.State.Connecting:
				try {
					var connected = self.socket.finalizeConnection()
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
				if connected {
					self.onOpen(self)
				}
			case is Network.Socket.State.Connected:
				try {
					self.request.write(self.socket)
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}
		}

		/**
		 * Notifies the listening channel that the underlying end point has received
		 * a new connection request. The end point corrsponding to the new connection
		 * is pushed to the reply queue and {@see onMessage} is called.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def notifyConnection(self) {
			switch self.socket.getState() {
			case is Network.Socket.State.Listening:
				try {
					var accepted = self.reply.accept(self.socket)
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
				if accepted {
					self.onMessage(self)
				}
			}
		}

		/**
		 * Notifies the channel that the connection was closed by the peer. The
		 * connection is then closed using {Network.Socket.close} and
		 * {@see onClose} is called.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def notifyClosed(self) {
			try {
				self.socket.close()
			} catch error {
				if typeof error === 'Exception.SocketError' {
					raise in Exception.SocketError(error.getErrno(), self)
				} else {
					raise
				}
			}
			self.onClose(self)
		}

		/**
		 * Notifies the channel that the underlying end point has received an error.
		 * The end point state is updated to {Network.Socket.State.Error} and
		 * an instance of {Exception.SocketError} is raised.
		 */
		const def notifyError(self) {
			self.socket.setState(Network.Socket.State.Error)
			raise Exception.SocketError(self)
		}

		/**
		 * This method can be rebound to handle state change events. The `channel`
		 * parameter is the channel that received the event and the `state` parameter
		 * is the state that will be applied to the underlying end point. The previous
		 * state can still be accessed with {@see getState} until the end of the method.
		 * 
		 * > [!WARNING]
		 * > Calling {Network.Socket.setState} in this method can result in an
		 * > infinite loop.
		 */
		var def onState(self, channel, %state) {}

		/**
		 * This method can be rebound to handle message events. The `channel`
		 * parameter is the channel that received the event. The messages can
		 * be accessed using the {@see read} method.
		 * 
		 * > [!NOTE]
		 * > This method can be called for one or more messages and will not be
		 * > called until the underlying end point receive more data.
		 * > The {@see read} method should then be called by this method until
		 * > `none` is returned.
		 */
		var def onMessage(self, channel) {}

		/**
		 * This method can be rebound to handle connection success events. The
		 * `channel` parameter is the channel that received the event. This
		 * method can be used to begin exchanges with the peer.
		 */
		var def onOpen(self, channel) {}

		/**
		 * This method can be rebound to handle close events. The `channel`
		 * parameter is the channel that received the event. This can be used
		 * to cleanup a context or try to reconnect when the connection was
		 * closed by the peer.
		 */
		var def onClose(self, channel) {}

		/**
		 * This class manage a data queue where data can be pushed as messages
		 * or as byte stream and converted using an object implementing the
		 * {@module network.serializers} interface.
		 * 
		 * Any method of this class is thread safe.
		 */
		- class DataQueue {
			/**
			 * Creates a new data queue. The `Serializer` parameter must be a
			 * class implementing the {@module network.serializers} interface
			 * used to detect messages end and convert data from or to objects.
			 */
			const def new(self, Serializer) {
				self.serializer = Serializer()
				self.mutex = System.Mutex()
				return self
			}

			/**
			 * Performs a read operation on `socket` and append received data
			 * to the queue.  Returns `true` if at least one message can be
			 * constructed from the data pushed into the queue; otherwise returns
			 * `false`.
			 */
			const def read(self, socket) {
				var lock = LockGuard(self.mutex)
				if self.serializer.read(socket) {
					return self.serializer.containsMessage()
				}
				return false
			}

			/**
			 * Performs a write operation on `socket` using the data available
			 * in the queue. Returns `true` if the data was successfully sent;
			 * otherwise returns `false`. After this call, the sent data should
			 * be removed from the queue.
			 */
			const def write(self, socket) {
				var lock = LockGuard(self.mutex)
				return self.serializer.write(socket)
			}

			/**
			 * Performs an accept operation on `socket` and push the new socket
			 * in the queue. Returns `true` if a new connection was successfully
			 * accepted; otherwise returns `false`.
			 */
			const def accept(self, socket) {
				var lock = LockGuard(self.mutex)
				return self.serializer.accept(socket)
			}

			/**
			 * Returns `true` if no more message can be retrieved from the queue;
			 * otherwise returns `false`.
			 */
			const def isEmpty(const self) {
				var lock = LockGuard(self.mutex)
				return not self.serializer.containsMessage()
			}

			/**
			 * Pushes the message object described by `data` into the queue. The
			 * `data` parameter must a message object that can be converted into
			 * a byte stream by the serializer object to be stored in the queue.
			 */
			const def push(self, data) {
				var lock = LockGuard(self.mutex)
				self.serializer.appendMessage(data)
			}

			/**
			 * Removes the oldest message from the queue and returns it. If no
			 * more message can be generated using the remaining byte stream,
			 * `none` is returned.
			 */
			const def pop(self) {
				var lock = LockGuard(self.mutex)
				if self.serializer.containsMessage() {
					return self.serializer.nextMessage()
				}
			}

			/// Internal serializer object.
			- final serializer = null
			
			/// Internal mutex.
			- final mutex = null
		}

		/// Internal underlying end point.
		- final socket = null
		
		/// Internal {@see DataQueue} instance for requests waiting to be sent.
		- final request = null
		
		/// Internal {@see DataQueue} instance for replies waiting to be read.
		- final reply = null
	}
}
