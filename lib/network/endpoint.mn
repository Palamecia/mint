load exception.network
load serializer.data-stream

package Network {

	/**
	 * This enum describes the options of an endpoint's socket. The effetive value
	 * of the option code can depend on the current system.
	 */
	@enum SocketOption {
		/// Permit sending of broadcast datagrams (boolean).
		BROADCAST
		/// Enable debug tracing (boolean).
		DEBUG
		/// Bypass routing table lookup (boolean).
		DONTROUTE
		/// Get pending error and clear ({Exception.SocketError}, read only).
		ERROR
		/// Periodically test if connection still alive (boolean).
		KEEPALIVE
		/// Linger on close if data to send ({Network.SocketLinger}).
		LINGER
		/// Leave received out-of-band data inline (boolean).
		OOBINLINE
		/// Receive buffer size (number).
		RCVBUF
		/// Send buffer size (number).
		SNDBUF
		/// Receive buffer low-water mark (number).
		RCVLOWAT
		/// Send buffer low-water mark (number).
		SNDLOWAT
		/// Receive timeout ({Network.SocketTime}).
		RCVTIMEO
		/// Send timeout ({Network.SocketTime}).
		SNDTIMEO
		/// Allow local address reuse (boolean).
		REUSEADDR
		/// Allow local port reuse (boolean).
		REUSEPORT
		/// Get socket type (number, read only).
		TYPE
		/// Routing socket gets copy of what it sends (boolean).
		USELOOPBACK
	}

	/**
	 * This class maintains information about a specific socket that specifies
	 * how that socket should behave when data is queued to be sent and
	 * {Network.EndPoint.close} is called on the socket.
	 */
	@class SocketLinger {
		/**
		 * Creates a new linger object for the given `data`. The data parameter
		 * can be an instance of {Network.SocketLinger}, in this case the object
		 * is returned as the new instance, or an instance of the `linger` C
		 * struct. The parameter can also provide a `toSocketLinger` method that
		 * will be used to create the object.
		 */
		const def new(self, data) {
			switch typeof data {
			case 'Network.SocketLinger':
				return data
			case 'libobject':
				self.d_ptr = data
				self.d_ptr.delete = def [g_lib = Network.SocketLinger.g_lib] (self) {
					g_lib.call('mint_socket_linger_delete', self)
				}
				return self
			default:
				if defined data.toSocketLinger {
					return data.toSocketLinger()
				}
			}
		}

		/**
		 * Creates a new linger object. The `enable` parameter must be a boolean
		 * value used to specifies whether a socket should remain open for a
		 * specified amount of time after closed to enable queued data to be sent.
		 * The `linger_time` parameter must be a number used, if enabled, to sets
		 * the linger time in seconds. This value specifies how long to remain open
		 * after a closesocket function call to enable queued data to be sent.
		 */
		const def new(self, const enable, const linger_time) {
			self.d_ptr = Network.SocketLinger.g_lib.call('mint_socket_linger_create', enable, linger_time)
			self.d_ptr.delete = def [g_lib = Network.SocketLinger.g_lib] (self) {
				g_lib.call('mint_socket_linger_delete', self)
			}
			return self
		}

		/**
		 * Returns `true` if enabled; otherwise returns `false`. This attribute
		 * specifies whether a socket should remain open for a specified amount
		 * of time after closed to enable queued data to be sent.
		 */
		const def isEnabled(const self) {
			return Network.SocketLinger.g_lib.call('mint_socket_linger_get_onoff', self.d_ptr)
		}

		/**
		 * Specifies whether a socket should remain open for a specified amount
		 * of time after closed to enable queued data to be sent.
		 */
		const def setEnabled(self, const enabled) {
			Network.SocketLinger.g_lib.call('mint_socket_linger_set_onoff', self.d_ptr, enabled)
		}

		/**
		 * Specifies how long to remain open after closed to enable queued data
		 * to be sent. This attribute is only applicable if enabled.
		 */
		const def getLingerTime(const self) {
			return Network.SocketLinger.g_lib.call('mint_socket_linger_get_linger', self.d_ptr)
		}

		/**
		 * Sets the linger time in seconds. This attribute specifies how long to
		 * remain open after closed to enable queued data to be sent. It is only
		 * applicable if enabled.
		 */
		const def setLingerTime(self, const linger_time) {
			Network.SocketLinger.g_lib.call('mint_socket_linger_set_linger', self.d_ptr, linger_time)
		}

		/**
		 * Returns the pointer to the internal `struct linger` instance.
		 */
		~ const def to_linger(const self) {
			return self.d_ptr
		}

        /// Global library handle.
		- @g_lib = lib('libmint-network')

		/// Object data.
		- final d_ptr = null
	}
 
	/**
	 * This class is used to specify a time interval.
	 */
    @class SocketTime {
		/**
		 * Creates a new time interval object for the given `data`. The data
		 * parameter can be an instance of {Network.SocketTime}, in this case
		 * the object is returned as the new instance, or an instance of the
		 * `timeval` C struct. The parameter can also provide a `toTime` method
		 * that will be used to create the object.
		 */
		const def new(self, data) {
			switch typeof data {
			case 'Network.SocketTime':
				return data
			case 'libobject':
				self.d_ptr = data
				self.d_ptr.delete = def [g_lib = Network.SocketTime.g_lib] (self) {
					g_lib.call('mint_socket_timeval_delete', self)
				}
				return self
			default:
				if defined data.toTime {
					return data.toTime()
				}
			}
		}

		/**
		 * Creates a new time interval object. The `sec` parameter must be a number
		 * used to specifies the time interval in seconds. The `usec` parameter
		 * must be a number used to specifies the time interval, in microseconds.
		 * This parameter is used in combination with the `sec` parameter to
		 * represent time interval values that are not a multiple of seconds.
		 */
		const def new(self, const sec, const usec) {
			self.d_ptr = Network.SocketTime.g_lib.call('mint_socket_timeval_create', sec, usec)
			self.d_ptr.delete = def [g_lib = Network.Time.g_lib] (self) {
                g_lib.call('mint_socket_timeval_delete', self)
            }
			return self
		}

		/**
		 * Returns the time interval, in seconds.
		 */
		const def getSeconds(const self) {
			return Network.SocketTime.g_lib.call('mint_socket_timeval_get_sec', self.d_ptr)
		}

		/**
		 * Specifies the time interval in seconds.
		 */
		const def setSeconds(self, const sec) {
			Network.SocketTime.g_lib.call('mint_socket_timeval_set_sec', self.d_ptr, sec)
		}

		/**
		 * Returns the time interval, in microseconds. This value is used in
		 * combination with the value of {@see getSeconds} to represent time
		 * interval values that are not a multiple of seconds.
		 */
		const def getMicroseconds(const self) {
			return Network.SocketTime.g_lib.call('mint_socket_timeval_get_usec', self.d_ptr)
		}

		/**
		 * Specifies the time interval in microseconds. This value is used in
		 * combination with the value passed to {@see setSeconds} to represent
		 * time interval values that are not a multiple of seconds.
		 */
		const def setMicroseconds(self, const usec) {
			Network.SocketTime.g_lib.call('mint_socket_linger_set_linger', self.d_ptr, usec)
		}

		/**
		 * Returns the pointer to the internal `struct timeval` instance.
		 */
		~ const def to_timeval(const self) {
			return self.d_ptr
		}

        /// Global library handle.
		- @g_lib = lib('libmint-network')

		/// Object data.
		- final d_ptr = null
    }

	/**
	 * Base class representing a network communication endpoint (layers 1 to 4 of the OSI model).
	 * 
	 * An endpoint encapsulates a socket and provides both synchronous and
	 * asynchronous operations for connecting, sending and receiving data.
	 * 
	 * Asynchronous operations integrate with {Network.Scheduler} and use
	 * Mint coroutines to suspend execution until the underlying socket
	 * becomes ready for the requested operation.
	 * 
	 * Concrete implementations such as TCP/IP endpoints must implement
	 * the low-level synchronous methods while the asynchronous variants
	 * are implemented using scheduler operations.
	 */
	@class EndPoint {
		/**
		 * This enum describes the different states in which an end point can be.
		 */
		enum State {
			/// The end point is not initialized.
			Unknown
			/// The end point is not connected.
			Disconnected
			/// The end point has started establishing a connection.
			Connecting
			/// A connection is established.
			Connected
			/// The end point is bound to an address and port.
			Bound
			/// The end point is ready to receive connection requests.
			Listening
			/// The socket is about to close (data may still be waiting to be written).
			Closing
			/// The end point was closed.
			Closed
			/// The end point entered an invalid state.
			Error
		}

		/**
		 * This enum describes the status of an I/O operation.
		 */
		enum IOStatus {
			/// The I/O operation has succeed.
			IOSuccess
			/// The I/O operation would block.
			IOWouldBlock
			/// The I/O operation was performed on a closed device.
			IOClosed
			/// The I/O operation has failed.
			IOError
		}

		/**
		 * Scheduler operation used to establish a connection asynchronously.
		 *
		 * This operation is created by {Network.EndPoint.connectAsync}
		 * and submitted to the scheduler using {Network.Scheduler.suspend}.
		 *
		 * The operation attempts to connect the underlying socket using the
		 * synchronous {Network.EndPoint.connect} method. If the connection
		 * cannot complete immediately, the operation registers interest in the
		 * socket writability event and suspends the current coroutine.
		 *
		 * Once the operating system reports that the socket is writable, the
		 * scheduler resumes the coroutine and the connection result is checked.
		 *
		 * If the connection succeeds the endpoint enters the
		 * {Network.EndPoint.State.Connected} state.
		 *
		 * If the connection fails the endpoint enters the {Network.EndPoint.State.Error}
		 * state and an instance of {Exception.SocketError} is raised.
		 */
		class ConnectOperation : Network.Scheduler.Operation {
			/**
			 * Creates a new asynchronous operation to wait for `endpoint` connection.
			 */
			const def new(self, endpoint) {
				self.endpoint = endpoint
				self.endpoint.getScheduler().watch(self)
				return self
			}

			/**
			 * Deletes the operation and remove it from the scheduler.
			 */
			const def delete(self) {
				self.endpoint.getScheduler().remove(self)
			}

			/**
			 * Checks for the operation completion. The operation succeed if the underlying endpoint enter the
			 * {Network.EndPoint.State.Connected} state. It fails on error.
			 */
			const def check(self) {
				if defined self.error {
					self.endpoint.getScheduler().remove(self)
					self.done(self.error)
				} else {
					switch self.endpoint.getState() {
					case Network.EndPoint.State.Unknown:
						try {
							self.endpoint.connect()
						} catch error {
							self.error = error
						}
						break
					case Network.EndPoint.State.Connected:
						self.endpoint.getScheduler().remove(self)
						self.done()
						break
					default:
						break
					}
				}
			}

			/**
			 * Returns `true` if the connection was correctly established; otherwise returns `false`.
			 */
			const def get(self) {
				return self.status
			}

			/**
			 * Returns the end point's socket as a number or `none` if the end point has no socket.
			 */
			const def getSocket(const self) {
				return self.endpoint.getSocket()
			}

			/**
			 * Returns the events expected by the endpoint as mask of values from the {Network.Scheduler.PollEvent} enum.
			 */
			const def getEvents(const self) {
				const PollEvent = Network.Scheduler.PollEvent
				return PollEvent.Write | PollEvent.Error
			}

			/**
			 * Returns `true` if the channel performs I/O operations asynchronously (i.e. read or write data without
			 * blocking other channels); otherwise returns `false`. This method calls the {Network.EndPoint.isNonBlocking}
			 * method of the underlying object.
			 */
			const def isNonBlocking(const self) {
				return self.endpoint.isNonBlocking()
			}

			/**
			 * Sets the non blocking mode of the end point to `enabled`. Returns `true` if the mode was successfully
			 * changed; otherwise returns `false`.
			 */
			const def setNonBlocking(self, enabled) {
				return self.endpoint.setNonBlocking(enabled)
			}

			/**
			 * Notifies that the underlying end point is writable.
			 */
			const def notifyWritable(self) {
				try {
					self.status = self.endpoint.finalizeConnection()
				} catch error {
					self.error = error
				}
			}

			/**
			 * Notifies that the underlying end point has received an error.
			 */
			const def notifyError(self) {
				self.error = Exception.SocketError(self.endpoint)
				self.endpoint.setState(Network.EndPoint.State.Error)
			}

			/// Internal endpoint.
			- final endpoint = null

			/// Internal error.
			- final error = none

			/// Internal connection status.
			- final status = none
		}

		/**
		 * Scheduler operation used to receive data asynchronously.
		 *
		 * Instances of this operation are created by {Network.EndPoint.readAsync}.
		 *
		 * The operation attempts to read data from the endpoint using the
		 * synchronous receive mechanism. If no data is currently available,
		 * the operation registers interest in the socket readability event
		 * and suspends the current coroutine.
		 *
		 * Each time the coroutine resumes, additional data is read and appended
		 * to the internal receive buffer until the completion predicate returns
		 * `true`.
		 *
		 * The completion predicate receives the current buffer and determines
		 * when the operation should finish. This allows callers to implement
		 * custom read conditions such as:
		 *
		 * * reading a fixed number of bytes
		 * * reading until a delimiter is encountered
		 * * reading until the buffer is non-empty
		 *
		 * If the peer closes the connection before the completion condition
		 * is satisfied, the operation returns the data accumulated so far.
		 *
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		class ReadOperation : Network.Scheduler.Operation {
			/**
			 * Creates a new asynchronous operation to read data from `endpoint` until the `completion` predicate
			 * returns `true`.
			 * 
			 * The `completion` parameter is a function that receives the current
			 * receive buffer and returns `true` when the operation should complete.
			 */
			const def new(self, endpoint, completion) {
				self.endpoint = endpoint
				self.completion = completion
				self.buffer = Serializer.DataStream()
				self.endpoint.getScheduler().watch(self)
				return self
			}

			/**
			 * Deletes the operation and remove it from the scheduler.
			 */
			const def delete(self) {
				self.endpoint.getScheduler().remove(self)
			}

			/**
			 * Checks for the operation completion. The operation succeed if data is available and the completion
			 * predicate returns `true` for the current read buffer. It fails on error.
			 */
			const def check(self) {
				if defined self.error {
					self.endpoint.getScheduler().remove(self)
					self.done(self.error)
				} elif (self.completion)(self.buffer) {
					self.endpoint.getScheduler().remove(self)
					self.done()
				}
			}

			/**
			 * Returns the received data as an instance of {Serializer.DataStream}.
			 */
			const def get(self) {
				return self.buffer
			}

			/**
			 * Returns the end point's socket as a number or `none` if the end point has no socket.
			 */
			const def getSocket(const self) {
				return self.endpoint.getSocket()
			}

			/**
			 * Returns the events expected by the endpoint as mask of values from the {Network.Scheduler.PollEvent} enum.
			 */
			const def getEvents(const self) {
				const PollEvent = Network.Scheduler.PollEvent
				return PollEvent.Read | PollEvent.Close | PollEvent.Error
			}

			/**
			 * Returns `true` if the channel performs I/O operations asynchronously (i.e. read or write data without
			 * blocking other channels); otherwise returns `false`. This method calls the {Network.EndPoint.isNonBlocking}
			 * method of the underlying object.
			 */
			const def isNonBlocking(const self) {
				return self.endpoint.isNonBlocking()
			}

			/**
			 * Sets the non blocking mode of the end point to `enabled`. Returns `true` if the mode was successfully
			 * changed; otherwise returns `false`.
			 */
			const def setNonBlocking(self, enabled) {
				return self.endpoint.setNonBlocking(enabled)
			}

			/**
			 * Notifies that the underlying end point is readable.
			 */
			const def notifyReadable(self) {
				try {
					self.buffer << self.endpoint.read()
				} catch e {
					self.error = error
				}
			}

			/**
			 * Notifies that the underlying end point has received an error.
			 */
			const def notifyError(self) {
				self.error = Exception.SocketError(self.endpoint)
				self.endpoint.setState(Network.EndPoint.State.Error)
			}

			/// Internal endpoint.
			- final endpoint = null

			/// Internal combination condition.
			- final completion = null

			/// Internal error.
			- final error = none

			/// Internal read buffer.
			- final buffer = null
		}

		/**
		 * Scheduler operation used to send data asynchronously.
		 *
		 * Instances of this operation are created by {Network.EndPoint.writeAsync}.
		 *
		 * The operation attempts to send the provided {Serializer.DataStream}
		 * using the endpoint's synchronous write mechanism.
		 *
		 * Because network writes may be partial, the operation may need to
		 * perform multiple write attempts until the entire buffer has been
		 * transmitted.
		 *
		 * If the socket cannot currently accept more data, the operation
		 * registers interest in the socket writability event and suspends
		 * the current coroutine.
		 *
		 * When the coroutine resumes, the remaining portion of the buffer is
		 * sent until the operation completes.
		 *
		 * Returns an iterator containing `true` and the amount of sent data in
		 * bytes if the data was successfully sent to the peer; otherwise returns
		 * `false`.
		 *
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		class WriteOperation : Network.Scheduler.Operation {
			/**
			 * Creates a new asynchronous operation to send the data provided by `buffer` to `endpoint`.
			 */
			const def new(self, endpoint, buffer) {
				self.endpoint = endpoint
				self.buffer = Serializer.DataStream(buffer)
				self.endpoint.getScheduler().watch(self)
				return self
			}

			/**
			 * Deletes the operation and remove it from the scheduler.
			 */
			const def delete(self) {
				self.endpoint.getScheduler().remove(self)
			}

			/**
			 * Checks for the operation completion. The operation succeed if all the data in the buffer is sent.
			 * It fails on error.
			 */
			const def check(self) {
				if defined self.error {
					self.endpoint.getScheduler().remove(self)
					self.done(self.error)
				} elif self.buffer.isEmpty() {
					self.endpoint.getScheduler().remove(self)
					self.done()
				}
			}

			/**
			 * Returns an iterator containing `true` and the amount of sent data in
			 * bytes if the data was successfully sent to the peer; otherwise returns
			 * `false`.
			 */
			const def get(self) {
				return (self.status, self.count)
			}

			/**
			 * Returns the end point's socket as a number or `none` if the end point has no socket.
			 */
			const def getSocket(const self) {
				return self.endpoint.getSocket()
			}

			/**
			 * Returns the events expected by the endpoint as mask of values from the {Network.Scheduler.PollEvent} enum.
			 */
			const def getEvents(const self) {
				const PollEvent = Network.Scheduler.PollEvent
				return PollEvent.Write | PollEvent.Close | PollEvent.Error
			}

			/**
			 * Returns `true` if the channel performs I/O operations asynchronously (i.e. read or write data without
			 * blocking other channels); otherwise returns `false`. This method calls the {Network.EndPoint.isNonBlocking}
			 * method of the underlying object.
			 */
			const def isNonBlocking(const self) {
				return self.endpoint.isNonBlocking()
			}

			/**
			 * Sets the non blocking mode of the end point to `enabled`. Returns `true` if the mode was successfully
			 * changed; otherwise returns `false`.
			 */
			const def setNonBlocking(self, enabled) {
				return self.endpoint.setNonBlocking(enabled)
			}

			/**
			 * Notifies that the underlying end point is writable.
			 */
			const def notifyWritable(self) {
				try {
					let (status, count) = self.endpoint.write(self.buffer)
					self.status = status
					if self.status {
						self.buffer.remove(count)
						self.count += count
					}
				} catch error {
					self.error = error
				}
			}

			/**
			 * Notifies that the underlying end point has received an error.
			 */
			const def notifyError(self) {
				self.error = Exception.SocketError(self.endpoint)
				self.endpoint.setState(Network.EndPoint.State.Error)
			}

			/// Internal endpoint.
			- final endpoint = null

			/// Internal error.
			- final error = none

			/// Internal write buffer.
			- final buffer = null

			/// Internal write status.
			- final status = false

			/// Internal sent byte counter.
			- final count = 0
		}

		/**
		 * Scheduler operation used to accept incoming connections
		 * asynchronously.
		 *
		 * Instances of this operation are created by {Network.EndPoint.acceptAsync}.
		 *
		 * The operation attempts to accept a pending connection using the
		 * synchronous accept mechanism. If no connection is currently pending,
		 * the operation registers interest in the socket readability event and
		 * suspends the current coroutine.
		 *
		 * Once the operating system reports that the listening socket is
		 * readable, the coroutine resumes and the accept operation is
		 * attempted again.
		 *
		 * When a connection is successfully accepted, the operation returns a
		 * new endpoint instance representing the client connection.
		 *
		 * The returned endpoint is already initialized and ready for
		 * communication.
		 *
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		class AcceptOperation : Network.Scheduler.Operation {
			const def new(self, endpoint) {
				self.endpoint = endpoint
				self.endpoint.getScheduler().watch(self)
				return self
			}

			/**
			 * Deletes the operation and remove it from the scheduler.
			 */
			const def delete(self) {
				self.endpoint.getScheduler().remove(self)
			}

			/**
			 * Checks for the operation completion. The operation succeed if a connection is accepted.
			 * It fails on error.
			 */
			const def check(self) {
				if defined self.error {
					self.endpoint.getScheduler().remove(self)
					self.done(self.error)
				} elif defined self.client {
					self.endpoint.getScheduler().remove(self)
					self.done()
				}
			}

			/**
			 * Returns the accepted endpoint or `none` if no connection was established.
			 */
			const def get(self) {
				return self.client
			}

			/**
			 * Returns the end point's socket as a number or `none` if the end point has no socket.
			 */
			const def getSocket(const self) {
				return self.endpoint.getSocket()
			}

			/**
			 * Returns the events expected by the endpoint as mask of values from the {Network.Scheduler.PollEvent} enum.
			 */
			const def getEvents(const self) {
				const PollEvent = Network.Scheduler.PollEvent
				return PollEvent.Accept | PollEvent.Error
			}

			/**
			 * Returns `true` if the end point performs I/O operations without blocking; otherwise returns `false`.
			 */
			const def isNonBlocking(const self) {
				return self.endpoint.isNonBlocking()
			}

			/**
			 * Sets the non blocking mode of the end point to `enabled`. Returns `true` if the mode was successfully
			 * changed; otherwise returns `false`.
			 */
			const def setNonBlocking(self, enabled) {
				return self.endpoint.setNonBlocking(enabled)
			}

			/**
			 * Notifies that the end point has received a new connection request.
			 */
			const def notifyConnection(self) {
				try {
					self.client = self.endpoint.accept()
				} catch error {
					self.error = error
				}
			}

			/**
			 * Notifies that the underlying end point has received an error.
			 */
			const def notifyError(self) {
				self.error = Exception.SocketError(self.endpoint)
				self.endpoint.setState(Network.EndPoint.State.Error)
			}

			/// Internal endpoint.
			- final endpoint = null

			/// Internal error.
			- final error = none

			/// Internal accepted client connection endpoint.
			- final client = none
		}

		/**
		 * Scheduler operation used to close an endpoint asynchronously.
		 *
		 * Instances of this operation are created by {Network.EndPoint.closeAsync}.
		 *
		 * The operation attempts to close the underlying socket immediately.
		 * If the close cannot complete synchronously, the operation registers
		 * interest in the appropriate socket event and suspends the current
		 * coroutine until the operation finishes.
		 *
		 * Once the close operation completes successfully, the endpoint enters
		 * the {Network.EndPoint.State.Closed} state.
		 *
		 * The operation returns `true` when the endpoint has been closed.
		 *
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		class CloseOperation : Network.Scheduler.Operation {
			const def new(self, endpoint) {
				self.endpoint = endpoint
				self.endpoint.getScheduler().watch(self)
				return self
			}

			/**
			 * Deletes the operation and remove it from the scheduler.
			 */
			const def delete(self) {
				self.endpoint.getScheduler().remove(self)
			}

			/**
			 * Checks for the operation completion. The operation succeed if the underlying endpoint enter the
			 * {Network.EndPoint.State.Closed} state. It fails on error.
			 */
			const def check(self) {
				if defined self.error {
					self.endpoint.getScheduler().remove(self)
					self.done(self.error)
				} else {
					switch self.endpoint.getState() {
					case Network.EndPoint.State.Connected:
					case Network.EndPoint.State.Listening:
					case Network.EndPoint.State.Bound:
						try {
							if self.status = self.endpoint.close() {
								self.endpoint.getScheduler().remove(self)
								self.done()
							}
						} catch error {
							self.error = error
						}
						break
					case Network.EndPoint.State.Closed:
						self.endpoint.getScheduler().remove(self)
						self.done()
						break
					default:
						break
					}
				}
			}

			/**
			 * Returns `true` if the endpoint was correctly closed; otherwise returns `false`.
			 */
			const def get(self) {
				return self.status
			}

			/**
			 * Returns the end point's socket as a number or `none` if the end point has no socket.
			 */
			const def getSocket(const self) {
				return self.endpoint.getSocket()
			}

			/**
			 * Returns the events expected by the endpoint as mask of values from the {Network.Scheduler.PollEvent} enum.
			 */
			const def getEvents(const self) {
				const PollEvent = Network.Scheduler.PollEvent
				return PollEvent.Close | PollEvent.Error
			}

			/**
			 * Returns `true` if the channel performs I/O operations asynchronously (i.e. read or write data without
			 * blocking other channels); otherwise returns `false`. This method calls the {Network.EndPoint.isNonBlocking}
			 * method of the underlying object.
			 */
			const def isNonBlocking(const self) {
				return self.endpoint.isNonBlocking()
			}

			/**
			 * Sets the non blocking mode of the end point to `enabled`. Returns `true` if the mode was successfully
			 * changed; otherwise returns `false`.
			 */
			const def setNonBlocking(self, enabled) {
				return self.endpoint.setNonBlocking(enabled)
			}

			/**
			 * Notifies that the connection was closed by the peer.
			 */
			const def notifyClosed(self) {
				try {
					self.status = self.endpoint.finalizeClose()
				} catch error {
					self.error = error
				}
			}

			/**
			 * Notifies that the underlying end point has received an error.
			 */
			const def notifyError(self) {
				self.error = Exception.SocketError(self.endpoint)
				self.endpoint.setState(Network.EndPoint.State.Error)
			}

			/// Internal endpoint.
			- final endpoint = null
			
			/// Internal error.
			- final error = none

			/// Internal close status.
			- final status = none
		}

		/**
		 * Creates a new end point. The end point is managed by the `scheduler`
		 * object.
		 * 
		 * > This method initialize the internal end point's state and must be
		 * > called in the implementation class constructor.
		 */
		const def new(self, scheduler) {
			self.scheduler = scheduler
			self.state = Network.EndPoint.State.Unknown
			return self
		}

		/**
		 * Attempts to make a connection to the remote device. Returns `true` if
		 * connection succeed or if the connection request was successfully sent
		 * and is waiting for acknowledgment; otherwise returns `false`. On
		 * success, the end point should enter the {Network.EndPoint.State.Connected}
		 * or {Network.EndPoint.State.Connecting} state. On error, it should
		 * enter the {Network.EndPoint.State.Disconnected} state.
		 * 
		 * > This method is an abstract method and should be implemented.
		 */
		const def connect(self) {
			return false
		}

		/**
		 * Finalize the connection to the peer. Return `true` if the connection
		 * succeed; otherwise returns `false`. On success, the end point should
		 * enter the {Network.EndPoint.State.Connected} state. On error, it should
		 * enter the {Network.EndPoint.State.Disconnected} state.
		 * 
		 * > This method is an abstract method and should be implemented.
		 */
		const def finalizeConnection(self) {
			return false
		}

		/**
		 * Attempts to establish a connection to the remote device asynchronously.
		 *
		 * This method suspends the current coroutine until the connection attempt
		 * either succeeds or fails.
		 *
		 * Returns `true` if the connection was successfully established; otherwise
		 * returns `false`.
		 *
		 * The underlying synchronous connection attempt is performed by
		 * {@see connect}. If the connection cannot complete immediately, the
		 * operation is registered in the scheduler and resumed once the endpoint
		 * becomes writable or an error occurs.
		 *
		 * On success, the endpoint should enter the {Network.EndPoint.State.Connected} state.
		 *
		 * On failure, the endpoint should enter the {Network.EndPoint.State.Error} state.
		 */
		const async def connectAsync(self) {
			return await self.getScheduler().suspend(Network.EndPoint.ConnectOperation(self))
		}

		/**
		 * Returns all available data received from the peer as an instance of
		 * {Serializer.DataStream} or `none` if no data is available. The end
		 * point must be in the {Network.EndPoint.State.Connected} state.
		 * 
		 * > This method is an abstract method and should be implemented.
		 */
		const def read(self) {
			return none
		}

		/**
		 * Asynchronously receives data from the peer.
		 *
		 * The operation suspends the current coroutine until new data becomes
		 * available and the `completion` predicate returns `true`.
		 * 
		 * The `completion` parameter is a function that receives the current
		 * receive buffer and returns `true` when the operation should complete.
		 * By default the operation completes when at least one byte has been
		 * received.
		 * 
		 * Returns the received data as an instance of {Serializer.DataStream}.
		 * 
		 * If the peer closes the connection before the completion condition
		 * is met, the returned buffer may contain fewer bytes than expected.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const async def readAsync(self, completion = def(buffer) { return not buffer.isEmpty() }) {
			return await self.getScheduler().suspend(Network.EndPoint.ReadOperation(self, completion))
		}

		/**
		 * Sends the data described by the `data` parameter to the peer. The
		 * `data` parameter must be an instance of {Serializer.DataStream}.
		 * Returns an iterator containing `true` and the amount of sent data in
		 * bytes if the data was successfully sent to the peer; otherwise returns
		 * `false`. The end point must be in the {Network.EndPoint.State.Connected}
		 * state.
		 * 
		 * > This method is an abstract method and should be implemented.
		 */
		const def write(self, data) {
			return false
		}

		/**
		 * Asynchronously sends the data described by `data` to the peer.
		 *
		 * The `data` parameter must be an instance of {Serializer.DataStream}.
		 *
		 * The operation suspends the current coroutine until all bytes have been
		 * written or an error occurs. Partial writes may occur internally and
		 * the operation will continue sending the remaining data until the buffer
		 * is empty.
		 *
		 * Returns an iterator containing `true` and the amount of sent data in
		 * bytes if the data was successfully sent to the peer; otherwise returns
		 * `false`.
		 *
		 * The endpoint must be in the {Network.EndPoint.State.Connected} state.
		 *
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const async def writeAsync(self, data) {
			return await self.getScheduler().suspend(Network.EndPoint.WriteOperation(self, data))
		}

		/**
		 * Tells the end point to listen for incoming messages. Returns `true`
		 * on success; otherwise returns `false`. On success, the end point
		 * should enter the {Network.EndPoint.State.Bound} state. On error, it
		 * should enter the {Network.EndPoint.State.Disconnected} state.
		 * 
		 * > This method is an abstract method and should be implemented.
		 */
		const def bind(self) {
			return false
		}

		/**
		 * Tells the end point to listen for incoming connections. Returns `true`
		 * on success; otherwise returns `false`. On success, the end point should
		 * enter the {Network.EndPoint.State.Listening} state. On error, it should
		 * enter the {Network.EndPoint.State.Disconnected} state.
		 * 
		 * > This method is an abstract method and should be implemented.
		 */
		const def listen(self) {
			return false
		}

		/**
		 * Returns a new end point initialized for the next waiting connection
		 * if any; otherwise returns `none`. The waiting connection will then
		 * be accepted and dequeued. The end point must be in the
		 * {Network.EndPoint.State.Listening} state.
		 * 
		 * > This method is an abstract method and should be implemented.
		 */
		const def accept(self) {
			return none
		}

		/**
		 * Waits asynchronously for the next incoming connection.
		 *
		 * The current coroutine is suspended until a client connection becomes
		 * available or an error occurs.
		 *
		 * Returns a new endpoint instance representing the accepted client
		 * connection.
		 *
		 * The endpoint must be in the {Network.EndPoint.State.Listening} state.
		 *
		 * The returned endpoint is already initialized and ready for I/O
		 * operations.
		 *
		 * An instance of {Exception.SocketError} is raised if the accept
		 * operation fails.
		 */
		const async def acceptAsync(self) {
			return await self.getScheduler().suspend(Network.EndPoint.AcceptOperation(self))
		}

		/**
		 * Closes the communication with the peer if the end point was in the
		 * {Network.EndPoint.State.Connected} state or stops listening if the
		 * end point was in the {Network.EndPoint.State.Listening} state. Returns
		 * `true` if the socket was successfully closed; otherwise returns `false`
		 * and the socket should then be closed later using {@see finalizeClose}.
		 * On success, the end point should enter the {Network.EndPoint.State.Closed}
		 * or {Network.EndPoint.State.Closing} state.
		 * 
		 * > This method is an abstract method and should be implemented.
		 */
		const def close(self) {
			return false
		}

		/**
		 * Finalize the close to the peer. Return `true` if the close succeed;
		 * otherwise returns `false`. On success, the end point should
		 * enter the {Network.EndPoint.State.Closed} state. On error, it should
		 * enter the {Network.EndPoint.State.Error} state.
		 * 
		 * > This method is an abstract method and should be implemented.
		 */
		const def finalizeClose(self) {
			return false
		}

		/**
		 * Asynchronously closes the endpoint.
		 *
		 * If the endpoint is currently connected, this operation terminates the
		 * communication with the peer. If the endpoint is listening, it stops
		 * accepting new connections.
		 *
		 * The coroutine is suspended until the close operation completes or
		 * fails.
		 *
		 * Returns `true` if the endpoint was successfully closed.
		 *
		 * If the close operation cannot complete immediately, the scheduler
		 * will resume the coroutine once the underlying socket reports the
		 * appropriate close event.
		 *
		 * The endpoint will enter the {Network.EndPoint.State.Closed} state on success or
		 * {Network.EndPoint.State.Error} on error.
		 */
		const async def closeAsync(self) {
			return await self.getScheduler().suspend(Network.EndPoint.CloseOperation(self))
		}

		/**
		 * Returns the end point's socket as a number or `none` if the end point
		 * has no socket.
		 * 
		 * > This method is an abstract method and should be implemented.
		 */
		const def getSocket(const self) {
			return none
		}

		/**
		 * Returns the scheduler associated with the object.
		 */
		const def getScheduler(const self) {
			return self.scheduler
		}

		/**
		 * Returns `true` if the end point performs I/O operations without blocking; otherwise returns `false`.
		 */
		const def isNonBlocking(const self) {
			return false
		}

		/**
		 * Sets the non blocking mode of the end point to `enabled`. Returns
		 * `true` if the mode was successfully changed; otherwise returns
		 * `false`.
		 * 
		 * > This method is an abstract method and should be implemented.
		 */
		const def setNonBlocking(self, enabled) {
			return false
		}

		/**
		 * Returns the value of the endpoint's socket option described by
		 * `option`. The `option` parameter must be a value of the
		 * {Network.SocketOption} enum. If the option is not supported by the
		 * system, `none` is returned;
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def getSocketOption(self, %option) {
			if defined option and var socket = self.getSocket() {
				switch option {
				case is Network.SocketOption.RCVBUF:
				case is Network.SocketOption.SNDBUF:
				case is Network.SocketOption.RCVLOWAT:
				case is Network.SocketOption.SNDLOWAT:
				case is Network.SocketOption.TYPE:
					var (value, errno) = Network.EndPoint.g_lib.call('mint_socket_get_option_number', socket, option)
					if errno {
						raise Exception.SocketError(errno, self)
					}
					return value
				case is Network.SocketOption.BROADCAST:
				case is Network.SocketOption.DEBUG:
				case is Network.SocketOption.DONTROUTE:
				case is Network.SocketOption.KEEPALIVE:
				case is Network.SocketOption.OOBINLINE:
				case is Network.SocketOption.REUSEADDR:
				case is Network.SocketOption.REUSEPORT:
				case is Network.SocketOption.USELOOPBACK:
					var (value, errno) = Network.EndPoint.g_lib.call('mint_socket_get_option_boolean', socket, option)
					if errno {
						raise Exception.SocketError(errno, self)
					}
					return value
				case is Network.SocketOption.ERROR:
					var (value, errno) = Network.EndPoint.g_lib.call('mint_socket_get_option_number', socket, option)
					if errno {
						raise Exception.SocketError(errno, self)
					}
					return value ? Exception.SocketError(value, self) : none
				case is Network.SocketOption.LINGER:
					var (value, errno) = Network.EndPoint.g_lib.call('mint_socket_get_option_linger', socket, option)
					if errno {
						raise Exception.SocketError(errno, self)
					}
					return Network.SocketLinger(value)
				case is Network.SocketOption.RCVTIMEO:
				case is Network.SocketOption.SNDTIMEO:
					var (value, errno) = Network.EndPoint.g_lib.call('mint_socket_get_option_timeval', socket, option)
					if errno {
						raise Exception.SocketError(errno, self)
					}
					return Network.SocketTime(value)
				}
			}
		}

		/**
		 * Sets the value of the endpoint's socket option described by `option`
		 * to `value`. The `option` parameter must be a value of the
		 * {Network.SocketOption} enum. Returns `true` if the option is supported
		 * by the system; otherwise returns `false`.
		 * 
		 * An instance of {Exception.SocketError} is raised on error.
		 */
		const def setSocketOption(self, %option, value) {
			if defined option and var socket = self.getSocket() {
				switch option {
				case is Network.SocketOption.RCVBUF:
				case is Network.SocketOption.SNDBUF:
				case is Network.SocketOption.RCVLOWAT:
				case is Network.SocketOption.SNDLOWAT:
				case is Network.SocketOption.TYPE:
					if var errno = Network.EndPoint.g_lib.call('mint_socket_set_option_number', socket, option, value) {
						raise Exception.SocketError(errno, self)
					}
					return true
				case is Network.SocketOption.BROADCAST:
				case is Network.SocketOption.DEBUG:
				case is Network.SocketOption.DONTROUTE:
				case is Network.SocketOption.KEEPALIVE:
				case is Network.SocketOption.OOBINLINE:
				case is Network.SocketOption.REUSEADDR:
				case is Network.SocketOption.REUSEPORT:
				case is Network.SocketOption.USELOOPBACK:
					if var errno = Network.EndPoint.g_lib.call('mint_socket_set_option_boolean', socket, option, value) {
						raise Exception.SocketError(errno, self)
					}
					return true
				case is Network.SocketOption.ERROR:
					if var errno = Network.EndPoint.g_lib.call('mint_socket_set_option_number', socket, option, value ? value.getErrno() : 0) {
						raise Exception.SocketError(errno, self)
					}
					return true
				case is Network.SocketOption.LINGER:
					if var errno = Network.EndPoint.g_lib.call('mint_socket_set_option_linger', socket, option, value.to_linger()) {
						raise Exception.SocketError(errno, self)
					}
					return true
				case is Network.SocketOption.RCVTIMEO:
				case is Network.SocketOption.SNDTIMEO:
					if var errno = Network.EndPoint.g_lib.call('mint_socket_set_option_timeval', socket, option, value.to_timeval()) {
						raise Exception.SocketError(errno, self)
					}
					return true
				}
			}
			return false
		}

		/**
		 * Returns the current state of the end point as a value of
		 * {Network.EndPoint.State}.
		 */
		const def getState(const self) {
			return self.state
		}

		/**
		 * Updates the current endpoint state.
		 *
		 * The `state` parameter must be a value from the {Network.EndPoint.State} enumeration.
		 *
		 * If the state differs from the current one, the {@see onState} callback is invoked before the internal state
		 * is updated.
		 *
		 * Implementations may override {@see onState} to react to state transitions.
		 */
		const def setState(self, %state) {
			if self.state != state {
				self.onState(state)
				self.state = state
			}
		}

		/**
		 * Handles endpoint state transitions.
		 *
		 * This method can be overridden by subclasses to react to state changes.
		 *
		 * The `state` parameter represents the new state that will be applied to
		 * the endpoint. The previous state can still be retrieved using
		 * {@see getState} during the execution of this method.
		 *
		 * > [!WARNING]
		 * > Calling {@see setState} from within this method may cause an
		 * > infinite recursion and should generally be avoided.
		 */
		var def onState(self, %state) {}

		/// Global library handle.
		- @g_lib = lib('libmint-network')

		/// Internal scheduler object.
		- final scheduler = null

		/// Internal end point's state.
		- final %state = null
	}
}

var g_lib = lib('libmint-network')
g_lib.call('mint_socket_setup_options', Network.SocketOption)
