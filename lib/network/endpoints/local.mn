 * @module
 * This module provides the {Network.LocalEndpoint} abstraction for representing local IPC address.
 */

load network.endpoint

package Network {

	/**
	 * This class provides an address to access a peer process using a local socket.
	 */
	@class LocalEndpoint : Network.Endpoint {

		/**
		 * Creates a new end point for the local address described by `name`.
		 */
		const def new(self, name) {
			if self.d_ptr = Network.LocalEndpoint.g_lib.call('mint_local_endpoint_create', name) {
				self.d_ptr.delete = def [g_lib = Network.LocalEndpoint.g_lib] (self) {
					g_lib.call('mint_local_endpoint_delete', self)
				}
			}
			self.name = name
			return self
		}

		/**
		 * Returns the local address name.
		 */
		const def getName(const self) {
			return self.name
		}

		/**
		 * Returns the path to the local socket file or `none` if the backend does not support it.
		 */
		const def getPath(const self) {
			return Network.LocalEndpoint.g_lib.call('mint_local_endpoint_get_path', self.d_ptr)
		}

		/**
		 * Returns the pointer to the internal `struct sockaddr` instance.
		 */
        ~ override const def to_sockaddr(self) {
            return self.d_ptr
        }

        /// Global library handle.
		- @const g_lib = lib('libmint-network')

		/// Internal local serveur name.
		- final name = ''

		/// Object data.
		- final d_ptr = null
	}

}
