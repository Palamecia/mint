 * @module
 * This module provides the {Network.StdioEndpoint} abstraction for representing an endpoint reachable using stdin and
 * stdout.
 */

load network.endpoint

package Network {

    /**
	 * This class provides an address to access a peer process using stdin and stdout.
	 */
	@class StdioEndpoint : Network.Endpoint {
        /**
         * Creates a new end point for the `fdRead` and `fdWrite` handles. Those parameter may either be an handle using
		 * an instance of `mint::handle_t` (C++) or a file descriptor described as a number (like {System.stdin} and
		 * {System.stdout}). The `fdRead` provides the handle to read data from the peer (its stdout) and `fdWrite`
		 * provides the handle to write data to the peer (its stdin).
         */
		const def new(self, fdRead, fdWrite) {
			self.readHandle = Network.StdioEndpoint.g_lib.call('mint_stdio_endpoint_to_handle', fdRead)
            self.writeHandle = Network.StdioEndpoint.g_lib.call('mint_stdio_endpoint_to_handle', fdWrite)
			if defined self.readHandle and defined self.writeHandle {
				return self
			}
		}

		/**
		 * Returns a handle useable by {Network.Poller} to wait for data on the read end of the socket.
		 */
		const def getReadHandle(const self) {
			return self.readHandle
		}

		/**
		 * Returns a handle useable by {Network.Poller} to wait for data on the write end of the socket.
		 */
		const def getWriteHandle(const self) {
			return self.writeHandle
		}

		/// Global library handle.
		- @const g_lib = lib('libmint-network')

		/// Internal read handle.
		- final readHandle = none

		/// Internal write handle.
		- final writeHandle = none
    }

}
