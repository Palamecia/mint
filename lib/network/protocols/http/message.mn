 * @module
 * This module provides the {Network.Http.Message} class which implement the
 * structure of the messages used by {Network.Http.Serializer}.
 */

load serializer.data-stream
load serializer.text-stream
load serializer.string-stream
load codec.mime-types
load codec.iconv
load mint.string
load mint.regex
load mint.hash

package Network {
	package Http {
		/**
		 * This hash provides the mapping between an HTTP status code and its message.
		 */
		@const Status = {
		    100: "Continue",
		    101: "Switching Protocols",
		    103: "Early Hints",
		    200: "OK",
		    201: "Created",
		    202: "Accepted",
		    203: "Non-Authoritative Information",
		    204: "No Content",
		    205: "Reset Content",
		    206: "Partial Content",
		    300: "Multiple Choices",
		    301: "Moved Permanently",
		    302: "Found",
		    303: "See Other",
		    304: "Not Modified",
		    307: "Temporary Redirect",
		    308: "Permanent Redirect",
		    400: "Bad Request",
		    401: "Unauthorized",
		    402: "Payment Required",
		    403: "Forbidden",
		    404: "Not Found",
		    405: "Method Not Allowed",
		    406: "Not Acceptable",
		    407: "Proxy Authentication Required",
		    408: "Request Timeout",
		    409: "Conflict",
		    410: "Gone",
		    411: "Length Required",
		    412: "Precondition Failed",
		    413: "Payload Too Large",
		    414: "URI Too Long",
		    415: "Unsupported Media Type",
		    416: "Range Not Satisfiable",
		    417: "Expectation Failed",
		    418: "I'm a teapot",
		    422: "Unprocessable Entity",
		    425: "Too Early",
		    426: "Upgrade Required",
		    428: "Precondition Required",
		    429: "Too Many Requests",
		    431: "Request Header Fields Too Large",
		    451: "Unavailable For Legal Reasons",
		    500: "Internal Server Error",
		    501: "Not Implemented",
		    502: "Bad Gateway",
		    503: "Service Unavailable",
		    504: "Gateway Timeout",
		    505: "HTTP Version Not Supported",
		    506: "Variant Also Negotiates",
		    507: "Insufficient Storage",
		    508: "Loop Detected",
		    510: "Not Extended",
		    511: "Network Authentication Required"
		}
		
		/**
		 * This class provides a structure for the messages used by
		 * {Network.Http.Serializer} and the {Network.Http} protocol. It
		 * provides helpers for reading and writing messages informations and
		 * for messages encoding de decoding.
		 */
		@class Message {
			/**
			 * Creates a new empty message.
			 */
			const def new(self) {
				self.body = Serializer.DataStream()
				return self
			}

			/**
			 * Creates a new message described by `identifier`.
			 * 
			 * If `identifier` is an instance of {Network.Http.Message}, this
			 * instance is returned.
			 * 
			 * If `identifier` is a number, it is used as a status code to create
			 * a response message. The `complement` parameter can then provides a
			 * status message; otherwise the message will be guessed from the code.
			 * 
			 * If `identifier` is a number, it is used as an HTTP method to create
			 * a request message.  The `complement` parameter can then provides a
			 * target URI.
			 * 
			 * Otherwise, the creation fails.
			 */
			const def new(self, identifier, complement = none) {
				switch typeof identifier{
				case 'number':
					self.setStatus(identifier, complement)
					self.body = Serializer.DataStream()
					return self
				case 'string':
					self.setMethod(identifier, complement)
					self.body = Serializer.DataStream()
					return self
				case 'Network.Http.Message':
					return identifier
				}
			}

			/**
			 * Returns the status code of the message as a number.
			 */
			const def getStatusCode(const self) {
				return self.code
			}

			/**
			 * Returns the status message of the message as a string.
			 */
			const def getStatusText(const self) {
				return self.message				
			}

			/**
			 * Sets the status code of the message to `code`. If the `message`
			 * parameter is given, the value of the parameter will be used as
			 * the status message; otherwise the message will be guessed from
			 * the status code.
			 */
			const def setStatus(self, code, message = none) {
				if not defined message and code in Network.Http.Status {
					message = Network.Http.Status[code]
				}
				self.message = message
				self.code = code
			}

			/**
			 * Returns the target of the message as a string.
			 */
			const def getTarget(const self) {
				return self.target
			}

			/**
			 * Returns the method of the message as a string.
			 */
			const def getMethod(const self) {
				return self.method
			}

			/**
			 * Sets the method of the message to `method` on the given `target`.
			 * 
			 * The `method` parameter should be one of `'GET'`, `'HEAD'`,
			 * `'POST'`, `'PUT'`, `'DELETE'`, `'CONNECT'`, `'OPTIONS'`,
			 * `'TRACE'` or `'PATCH'`.
			 */
			const def setMethod(self, method, target) {
				self.method = method
				self.target = target
			}

			/**
			 * Returns the value of the field `name` of the header.
			 */
			const def getHeader(const self, name) {
				return self.headers.get(name)
			}

			/**
			 * Sets the field `name` of the header to `value`.
			 */
			const def setHeader(self, name, value) {
				self.headers[name] = value
			}

			/**
			 * Returns the body of the message as an instance of {Serializer.DataStream}.
			 */
			const def getBody(const self) {
				return self.body
			}

			/**
			 * Returns the body of the message as an instance of string.
			 */
			const def getBodyText(const self) {
				if let contentType = self.getHeader('Content-Type') {
					if self.isTextual() {
						let pos = contentType.indexOf('encoding=')
						if defined pos {
							let codec = Codec.Iconv(contentType.substring(pos + 9).trim())
							let (status, result) = codec.decode(self.body, 0)
							return status is Codec.Status.Success ? result : none
						}
						return self.body.getString(0)
					}
				}
			}

			/**
			 * Sets the body of the message to `body`. The `Content-Length` header
			 * will be automatically updated using the length of the body. If the
			 * `contentType` parameter is given, the value of the parameter will
			 * be used to setup the `Content-Type` header; otherwise the value
			 * will be guessed from the content of `body`.
			 */
			const def setBody(self, body, contentType = none) {
				if typeof body === 'string' {
					self.body = Serializer.StringStream(body).read()
				} else {
					self.body = Serializer.DataStream(body)
				}
				self.headers['Content-Length'] = self.body.size()
				if defined contentType {
					self.headers['Content-Type'] = contentType
				} else {
					self.headers['Content-Type'] = Codec.MimeTypes.fromData(body)
				}
			}

			/**
			 * Returns true if the message is textual; false otherwise.
			 */
			const def isTextual(const self) {
				if let contentType = self.getHeader('Content-Type') {
					return contentType.startsWith('text/') or contentType.startsWith('application/json')
				}
				return false
			}

			/**
			 * Returns the content of the message as a string including headers and body, with CRLF line endings
			 * converted to LF. Non-textual body content is represented as base64.
			 */
			const def toString(const self) {

				if not defined self.method {
					if not defined self.code {
						self.code = 200
					}
					if not defined self.message and self.code in Network.Http.Status {
						self.message = Network.Http.Status[self.code]
					}
				}

				let result = ''

				if self.method { // Request mode
					result << '%s %s %s\n' % (self.method, self.target, self.version)
				} else { // Response mode
					result << '%s %d %s\n' % (self.version, self.code, self.message)
				}

				if 'Content-Length' not in self.headers {
					result << 'Content-Length: %d\n' % self.body.size()
				}

				for let (key, value) in self.headers {
					switch typeof value {
					case 'none':
						break
					case 'array':
						for let item in value {
							result << '%s: %s\n' % (key, item)
						}
						break
					default:
						result << '%s: %s\n' % (key, value)
						break
					}
				}

				result << '\n'

				if self.isTextual() {
					if let bodyText = self.getBodyText() {
						result << bodyText
					}
				} else {
					result << self.body.toBase64()
				}

				return result
			}

			/**
			 * Returns the content of the message as an instance of {Serializer.DataStream}.
			 */
			const def encode(const self) {

				if not defined self.method {
					if not defined self.code {
						self.code = 200
					}
					if not defined self.message and self.code in Network.Http.Status {
						self.message = Network.Http.Status[self.code]
					}
				}

				let buffer = Serializer.DataStream()
				let stream = Serializer.TextStream(buffer)

				if self.method { // Request mode
					stream << '%s %s %s\r\n' % (self.method, self.target, self.version)
				} else { // Response mode
					stream << '%s %d %s\r\n' % (self.version, self.code, self.message)
				}

				if 'Content-Length' not in self.headers {
					stream << 'Content-Length: %d\r\n' % self.body.size()
				}

				for let (key, value) in self.headers {
					switch typeof value {
					case 'none':
						break
					case 'array':
						for let item in value {
							stream << '%s: %s\r\n' % (key, item)
						}
						break
					default:
						stream << '%s: %s\r\n' % (key, value)
						break
					}
				}

				stream << '\r\n'
				buffer << self.body
				return buffer
			}

			/**
			 * Creates an instance of {Network.Http.Message} from an instance of {Serializer.DataStream} given by
			 * `data`. The `length` parameter is the number of bytes to be used to create the message.
			 */
			@const def decode(data, length) {
				if length {

					let self = Network.Http.Message()
					let stream = data.getSome(length)
					let bodyStart =: for let i in 0...(length-4) {
						if stream.getString(i, 4) === '\r\n\r\n' {
							yield i + 4
							break
						}
					}

					if not defined bodyStart {
						bodyStart = length
					}

					let buffer = Serializer.TextStream(stream.readSome(bodyStart))
					let token = buffer.readWord()

					if token.startsWith('HTTP/') {
						self.version = token
						self.code = buffer.readWord().toNumber()
						self.message = buffer.readLine().trim()
					} else {
						self.method = token
						self.target = buffer.readWord()
						self.version = buffer.readLine().trim()
					}

					while let header = RegexMatch(/(.+):\s*(.+)?\r?/.match(buffer.readLine())) {
						let key = header.capturedText(1).trim()
						let value = header.capturedText(2).trim()
						if key in self.headers {
							if typeof self.headers[key] === 'array' {
								self.headers[key].push(value)
							} else {
								self.headers[key] = [self.headers[key], value]
							}
						} else {
							self.headers[key] = value
						}
					}

					self.body = stream
					return self
				}
			}

			/// Internal protocol version.
			- final version = 'HTTP/1.0'
			
			/// Internal header fields.
			- final headers = {}
			
			/// Internal message body.
			- final body = null

			/// Internal method (request only).
			- final method = none

			/// Internal target (request only).
			- final target = none

			// Internal message (response only).
			- final message = none

			// Internal status (response only).
			- final code = none
		}
	}
}
