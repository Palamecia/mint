 * @module
 * This module provides the HTTP server transports and request handlers exposed
 * by {Network.Http.Server}, {Network.Http.AsyncServer} and their associated
 * helper classes. The implementation is built around the channel abstraction and
 * the runtime scheduler.
 */

load mint.function
load system.directory
load network.channel
load network.serializers.server
load network.protocols.http.message
load network.protocols.http.serializer

package Network {
	package Http {
		/**
		 * Stores the default configuration values used by HTTP server instances.
		 */
		@class ServerConfiguration {
			/// Server's request resolver.
			var resolver = none

			/// Server's default HTTP attributes.
			var attributes = {}
		}

		/**
		 * Base class for request resolvers. A resolver is responsible for translating an incoming message into a
		 * callback that can be invoked to serve the request.
		 */
		@class Resolver {
			/**
			 * Resolves the given `message` into a callback that can be invoked to serve the request. The `message`
			 * parameter is an instance of {Network.Http.Message}. If a matching route is found, the corresponding
			 * callback is returned; otherwise `none` is returned.
			 */
			const def resolve(self, message) {
				return none
			}
		}

		/**
		 * A route-based resolver inspired by Express. It stores handlers by method
		 * and path and returns the matching callback for a request message.
		 */
		@class Router : Network.Http.Resolver {
			/**
			 * Creates a new router instance with the given `routes`. The `routes` parameter should be a dictionary of
			 * dictionaries where the first level keys are HTTP methods and the second level keys are paths. The values
			 * are callbacks that will be invoked when a request matches the method and path.
			 */
			const def new(self, routes = {}) {
				self.routes = routes
				return self
			}

			/**
			 * Registers a new route for the given `method` and `path`. The `callback` parameter is the function that
			 * will be invoked when a request matches the method and path. The callback should accept two parameters:
			 * the client context and the request message.
			 */
			const def route(self, method, path, callback) {
				let routes = self.routes.get(method)
				if routes is none {
					routes = {}
					self.routes[method] = routes
				}
				routes[path] = callback
				return self
			}

			/**
			 * Registers a new route for all HTTP methods and the given `path`. The `callback` parameter is the function
			 * that will be invoked when a request matches the path. The callback should accept two parameters: the
			 * client context and the request message.
			 */
			const def use(self, path, callback) {
				return self.all(path, callback)
			}

			/**
			 * Registers a new route for all HTTP methods and the given `path`. The `callback` parameter is the function
			 * that will be invoked when a request matches the path. The callback should accept two parameters: the
			 * client context and the request message.
			 */
			const def all(self, path, callback) {
				let routes = self.routes.get('ALL')
				if routes is none {
					routes = {}
					self.routes['ALL'] = routes
				}
				routes[path] = callback
				return self
			}

			/**
			 * Registers a new route for the 'GET' method and the given `path`. The `callback` parameter is the function
			 * that will be invoked when a request matches the method and path. The callback should accept two parameters:
			 * the client context and the request message.
			 */
			const def get(self, path, callback) {
				return self.route('GET', path, callback)
			}

			/**
			 * Registers a new route for the 'HEAD' method and the given `path`. The `callback` parameter is the function
			 * that will be invoked when a request matches the method and path. The callback should accept two parameters:
			 * the client context and the request message.
			 */
			const def head(self, path, callback) {
				return self.route('HEAD', path, callback)
			}

			/**
			 * Registers a new route for the 'POST' method and the given `path`. The `callback` parameter is the function
			 * that will be invoked when a request matches the method and path. The callback should accept two parameters:
			 * the client context and the request message.
			 */
			const def post(self, path, callback) {
				return self.route('POST', path, callback)
			}

			/**
			 * Registers a new route for the 'PUT' method and the given `path`. The `callback` parameter is the function
			 * that will be invoked when a request matches the method and path. The callback should accept two parameters:
			 * the client context and the request message.
			 */
			const def put(self, path, callback) {
				return self.route('PUT', path, callback)
			}

			/**
			 * Registers a new route for the 'DELETE' method and the given `path`. The `callback` parameter is the function
			 * that will be invoked when a request matches the method and path. The callback should accept two parameters:
			 * the client context and the request message.
			 */
			const def del(self, path, callback) {
				return self.route('DELETE', path, callback)
			}

			/**
			 * Registers a new route for the 'CONNECT' method and the given `path`. The `callback` parameter is the function
			 * that will be invoked when a request matches the method and path. The callback should accept two parameters:
			 * the client context and the request message.
			 */
			const def connect(self, path, callback) {
				return self.route('CONNECT', path, callback)
			}

			/**
			 * Registers a new route for the 'OPTIONS' method and the given `path`. The `callback` parameter is the function
			 * that will be invoked when a request matches the method and path. The callback should accept two parameters:
			 * the client context and the request message.
			 */
			const def options(self, path, callback) {
				return self.route('OPTIONS', path, callback)
			}

			/**
			 * Registers a new route for the 'TRACE' method and the given `path`. The `callback` parameter is the function
			 * that will be invoked when a request matches the method and path. The callback should accept two parameters:
			 * the client context and the request message.
			 */
			const def trace(self, path, callback) {
				return self.route('TRACE', path, callback)
			}

			/**
			 * Registers a new route for the 'PATCH' method and the given `path`. The `callback` parameter is the function
			 * that will be invoked when a request matches the method and path. The callback should accept two parameters:
			 * the client context and the request message.
			 */
			const def patch(self, path, callback) {
				return self.route('PATCH', path, callback)
			}

			/**
			 * Resolves the given `message` into a callback that can be invoked to serve the request. The `message`
			 * parameter is an instance of {Network.Http.Message}. If a matching route is found, the corresponding
			 * callback is returned; otherwise `none` is returned.
			 */
			const def resolve(self, message) {
				let target = message.getTarget()
				let method = message.getMethod()
				if let allRoutes = self.routes.get('ALL') {
					if let callback = allRoutes.get(target) {
						return callback
					}
				}
				if let methodRoutes = self.routes.get(method) {
					if let callback = methodRoutes.get(target) {
						return callback
					}
				}
				return none
			}

			/// Internal routes table.
			- final routes = {}
		}

		/**
		 * Static file resolver providing a simple implementation of a request resolver that serves static files from a
		 * given root directory.
		 */
		@class StaticResolver : Network.Http.Resolver {
			/**
			 * Creates a new static resolver that serves files from the given `rootDirectory`. The `rootDirectory`
			 * parameter should be a string representing the path to the root directory or an instance of
			 * {System.Directory}.
			 */
			const def new(self, rootDirectory = System.Directory.current()) {
				self.rootDirectory = System.Directory(rootDirectory)
				return self
			}

			/**
			 * Resolves the given `message` into a callback that can be invoked to serve the request. The `message`
			 * parameter is an instance of {Network.Http.Message}. If a matching route is found, the corresponding
			 * callback is returned; otherwise `none` is returned.
			 */
			const def resolve(self, message) {
				switch message.getMethod() {
				case 'GET':
					return Callback(self, self.onGetRequest)
				case 'HEAD':
					return Callback(self, self.onHeadRequest)
				case 'POST':
					return Callback(self, self.onPostRequest)
				case 'PUT':
					return Callback(self, self.onPutRequest)
				case 'DELETE':
					return Callback(self, self.onDeleteRequest)
				case 'OPTIONS':
					return Callback(self, self.onOptionsRequest)
				default:
					return none
				}
			}

			/**
			 * Returns the file targeted by the given `target` path inside the configured root directory.
			 */
			const def resolveFile(const self, target) {
				var path = target
				if path is none or path == '' or path == '/' {
					path = 'index.html'
				} else {
					while path.startsWith('/') {
						path = path[1...path.size()]
					}
				}
				let file = self.rootDirectory.getFile(path)
				if file.isDirectory() and file.exists() {
					file = self.rootDirectory.getFile(path + '/index.html')
				}
				return file
			}

			/**
			 * Handles a `GET` request by serving the file described by the request target.
			 */
			const def onGetRequest(self, client, message) {
				var response = Network.Http.Message()
				let file = self.resolveFile(message.getTarget())
				if file.exists() {
					if let stream = file.open('r') {
						response.setBody(stream.read())
					} else {
						response.setStatus(403)
					}
				} else {
					response.setStatus(404)
				}
				client.write(response)
			}

			/**
			 * Handles a `HEAD` request by serving the target file headers without a response body.
			 */
			const def onHeadRequest(self, client, message) {
				var response = Network.Http.Message()
				let file = self.resolveFile(message.getTarget())
				if file.exists() {
					if let stream = file.open('r') {
						response.setBody(stream.read())
					} else {
						response.setStatus(403)
					}
				} else {
					response.setStatus(404)
				}
				response.setBody('')
				client.write(response)
			}

			/**
			 * Handles a `POST` request by rejecting unsupported mutations.
			 */
			const def onPostRequest(self, client, message) {
				var response = Network.Http.Message(405, 'Method Not Allowed')
				response.setHeader('Allow', 'GET, HEAD, OPTIONS, PUT, DELETE')
				client.write(response)
			}

			/**
			 * Handles a `PUT` request by creating or updating the target file.
			 */
			const def onPutRequest(self, client, message) {
				var file = self.resolveFile(message.getTarget())
				var directory = file.getDirectory()
				var response = Network.Http.Message()
				if directory.exists() {
					if file.exists() {
						if let stream = file.open('w') {
							stream.write(message.getBody())
							if file.size() {
								response.setStatus(200)
							} else {
								response.setStatus(204)
							}
							response.setHeader('Content-Location', message.getTarget())
						} else {
							response.setStatus(403)
						}
					} else {
						if let stream = file.open('w') {
							stream.write(message.getBody())
							response.setStatus(201)
							response.setHeader('Content-Location', message.getTarget())
						} else {
							response.setStatus(403)
						}
					}
				} else {
					response.setStatus(404)
				}
				client.write(response)
			}

			/**
			 * Handles a `DELETE` request by removing the target file.
			 */
			const def onDeleteRequest(self, client, message) {
				var response = Network.Http.Message()
				let file = self.resolveFile(message.getTarget())
				if file.exists() {
					file.remove()
					response.setStatus(204)
				} else {
					response.setStatus(404)
				}
				client.write(response)
			}

			/**
			 * Handles an `OPTIONS` request by advertising the supported methods.
			 */
			const def onOptionsRequest(self, client, message) {
				var response = Network.Http.Message(204, 'No Content')
				response.setHeader('Allow', 'GET, HEAD, OPTIONS, PUT, DELETE')
				response.setHeader('Content-Length', 0)
				client.write(response)
			}

			/**
			 * Returns the root directory used by the resolver as an instance of {System.Directory}.
			 */
			const def getRootDirectory(const self) {
				return self.rootDirectory
			}

			/**
			 * Sets the root directory used by the resolver to the given `rootDirectory`.
			 */
			const def setRootDirectory(self, rootDirectory) {
				self.rootDirectory = System.Directory(rootDirectory)
			}
			
			/// Internal root directory.
			- final rootDirectory = null
		}

		/**
		 * Static file resolver for asynchronous request handling.
		 */
		@class AsyncStaticResolver : Network.Http.Resolver {
			const def new(self, rootDirectory = System.Directory.current()) {
				self.rootDirectory = System.Directory(rootDirectory)
				return self
			}

			/**
			 * Resolves the given `message` into a callback that can be invoked to serve the request. The `message`
			 * parameter is an instance of {Network.Http.Message}. If a matching route is found, the corresponding
			 * callback is returned; otherwise `none` is returned.
			 */
			const def resolve(self, message) {
				switch message.getMethod() {
				case 'GET':
					return AsyncCallback(self, self.onGetRequest)
				case 'HEAD':
					return AsyncCallback(self, self.onHeadRequest)
				case 'POST':
					return AsyncCallback(self, self.onPostRequest)
				case 'PUT':
					return AsyncCallback(self, self.onPutRequest)
				case 'DELETE':
					return AsyncCallback(self, self.onDeleteRequest)
				case 'OPTIONS':
					return AsyncCallback(self, self.onOptionsRequest)
				default:
					return none
				}
			}

			/**
			 * Returns the file targeted by the given `target` path inside the configured root directory.
			 */
			const def resolveFile(const self, target) {
				var path = target
				if path is none or path == '' or path == '/' {
					path = 'index.html'
				} else {
					while path.startsWith('/') {
						path = path[1...path.size()]
					}
				}
				let file = self.rootDirectory.getFile(path)
				if file.isDirectory() and file.exists() {
					file = self.rootDirectory.getFile(path + '/index.html')
				}
				return file
			}

			/**
			 * Handles a `GET` request by serving the file described by the request target.
			 */
			const async def onGetRequest(self, client, message) {
				var response = Network.Http.Message()
				let file = self.resolveFile(message.getTarget())
				if file.exists() {
					if let stream = file.openAsync(client.getScheduler(), 'r') {
						response.setBody(await stream.read())
					} else {
						response.setStatus(403)
					}
				} else {
					response.setStatus(404)
				}
				await client.write(response)
			}

			/**
			 * Handles a `HEAD` request by serving the target file headers without a response body.
			 */
			const async def onHeadRequest(self, client, message) {
				var response = Network.Http.Message()
				let file = self.resolveFile(message.getTarget())
				if file.exists() {
					if let stream = file.openAsync(client.getScheduler(), 'r') {
						response.setBody(await stream.read())
					} else {
						response.setStatus(403)
					}
				} else {
					response.setStatus(404)
				}
				response.setBody('')
				await client.write(response)
			}

			/**
			 * Handles a `POST` request by rejecting unsupported mutations.
			 */
			const async def onPostRequest(self, client, message) {
				var response = Network.Http.Message(405, 'Method Not Allowed')
				response.setHeader('Allow', 'GET, HEAD, OPTIONS, PUT, DELETE')
				await client.write(response)
			}

			/**
			 * Handles a `PUT` request by creating or updating the target file.
			 */
			const async def onPutRequest(self, client, message) {
				var file = self.resolveFile(message.getTarget())
				var directory = file.getDirectory()
				var response = Network.Http.Message()
				if directory.exists() {
					if file.exists() {
						if let stream = file.openAsync(client.getScheduler(), 'w') {
							await stream.write(message.getBody())
							if file.size() {
								response.setStatus(200)
							} else {
								response.setStatus(204)
							}
							response.setHeader('Content-Location', message.getTarget())
						} else {
							response.setStatus(403)
						}
					} else {
						if let stream = file.openAsync(client.getScheduler(), 'w') {
							await stream.write(message.getBody())
							response.setStatus(201)
							response.setHeader('Content-Location', message.getTarget())
						} else {
							response.setStatus(403)
						}
					}
				} else {
					response.setStatus(404)
				}
				await client.write(response)
			}

			/**
			 * Handles a `DELETE` request by removing the target file.
			 */
			const async def onDeleteRequest(self, client, message) {
				var response = Network.Http.Message()
				let file = self.resolveFile(message.getTarget())
				if file.exists() {
					file.remove()
					response.setStatus(204)
				} else {
					response.setStatus(404)
				}
				await client.write(response)
			}

			/**
			 * Handles an `OPTIONS` request by advertising the supported methods.
			 */
			const async def onOptionsRequest(self, client, message) {
				var response = Network.Http.Message(204, 'No Content')
				response.setHeader('Allow', 'GET, HEAD, OPTIONS, PUT, DELETE')
				response.setHeader('Content-Length', 0)
				await client.write(response)
			}

			/**
			 * Returns the root directory used by the resolver as an instance of {System.Directory}.
			 */
			const def getRootDirectory(const self) {
				return self.rootDirectory
			}

			/**
			 * Sets the root directory used by the resolver to the given `rootDirectory`.
			 */
			const def setRootDirectory(self, rootDirectory) {
				self.rootDirectory = System.Directory(rootDirectory)
			}

			/// Internal root directory.
			- final rootDirectory = null
		}

		/**
		 * Base class for HTTP request handlers that process incoming client messages.
		 */
		@class AbstractRequestHandler {

		}

		/**
		 * This class provides the synchronous server-side HTTP transport. It can be
		 * watched by a {Network.Poller} or driven through the runtime scheduler by
		 * the underlying channel.
		 */
		@class Server {
			/**
			 * Creates a new server context for the given `socket`. The `socket` parameter must implement the
			 * {Network.Socket} interface.
			 * 
			 * The `RequestHandler` can provide a class that will be used to create clients context on client
			 * connection.
			 */
			const def new(self, socket, RequestHandler = Network.Http.RequestHandler) {
				self.configuration = Network.Http.ServerConfiguration()
				self.configuration.resolver = Network.Http.StaticResolver(System.Directory.current())
				self.channel = Network.EventChannel(socket, Network.ServerSerializer)
				self.channel.onState = def [self] (_, channel, %state) {
					self.onState(self, state)
				}
				self.channel.onMessage = def [self, RequestHandler] (_, channel) {
					self.onAccept(RequestHandler(channel.read(), self.getConfiguration().clone()))
				}
				self.channel.onOpen = def [self] (_, channel) {
					self.onOpen(self)
				}
				self.channel.onClose = def [self] (_, channel) {
					self.onClose(self)
				}
				return self
			}

			/**
			 * Makes the server watched by `poller`. The `poller` parameter should be an instance of {Network.Poller}
			 * that will be used to watch for network events on the server. {Network.Poller.watch} will be
			 * automatically called for the server and also all the create client contexts.
			 */
			const def watchedBy(self, poller) {
				self.onAccept = def [self, poller] (_, client) {
					client.onClose = def [self, poller] (_, client) {
						poller.unwatch(client)
					}
					poller.watch(client)
				}
				poller.watch(self)
				return self
			}

			/**
			 * Tells the channel to listen for incoming connections on address configured by `endpoint`. Returns `true`
			 * on success; otherwise returns `false`. This method calls the {Network.EventChannel.listen} method of the
			 * underlying channel.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def listen(self, endpoint) {
				try {
					return self.channel.listen(endpoint)
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Stops listening if the context was opened with {@see listen}. This method calls the
			 * {Network.EventChannel.close} method of the underlying channel. If the socket was successfully closed,
			 * {@see onClose} is called; otherwise the socket will be closed later.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def close(self) {
				try {
					return self.channel.close()
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Returns the context's socket's handle as an instance of `mint::handle_t`. This method calls the
			 * {Network.EventChannel.getHandle} method of the underlying channel.
			 */
			const def getHandle(const self) {
				return self.channel.getHandle()
			}

			/**
			 * Returns the underlying end point object. This method calls the
			 * {Network.EventChannel.getEndpoint} method of the underlying
			 * channel.
			 */
			const def getEndpoint(const self) {
				return self.channel.getEndpoint()
			}

			/**
			 * Returns the current state of the context as a value of
			 * {Network.Socket.State}. This method calls the
			 * {Network.EventChannel.getState} method of the underlying
			 * channel.
			 */
			const def getState(const self) {
				return self.channel.getState()
			}

			/**
			 * Returns the events expected by the context as mask of values from the
			 * {Network.PollEvent} enum. This method calls the
			 * {Network.EventChannel.getEvents} method of the underlying
			 * channel.
			 */
			const def getEvents(const self) {
				return self.channel.getEvents()
			}

			/**
			 * Returns `true` if the channel performs I/O operations asynchronously
			 * (i.e. read or write data without blocking other channels); otherwise
			 * returns `false`. This method calls the
			 * {Network.EventChannel.isNonBlocking} method of the underlying
			 * channel.
			 */
			const def isNonBlocking(const self) {
				return self.channel.isNonBlocking()
			}

			/**
			 * Sets the non blocking mode of the channel to `enabled`. This method
			 * calls the {Network.EventChannel.setNonBlocking} method of
			 * the underlying channel. Returns `true` if the mode was successfully
			 * changed; otherwise returns `false`.
			 * 
			 * > [!WARNING]
			 * > Disable the non blocking mode on a context can slow down any network
			 * > I/O operations of the application. Other channels will not be able
			 * > to perform I/O operations until the current operation's
			 * > acknowledgment by the peer.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def setNonBlocking(self, enabled) {
				try {
					return self.channel.setNonBlocking(enabled)
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Returns the server's configuration as an instance of {Network.Http.ServerConfiguration}.
			 */
			const def getConfiguration(const self) {
				return self.configuration
			}

			/**
			 * Sets the server's configuration to `configuration`. The `configuration` parameter should be an instance
			 * of {Network.Http.ServerConfiguration}.
			 */
			const def setConfiguration(self, configuration) {
				self.configuration = configuration
			}

			/**
			 * Notifies the context that the underlying channel is readable. This
			 * method calls the {Network.EventChannel.notifyReadable}
			 * method of the underlying channel.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def notifyReadable(self) {
				try {
					self.channel.notifyReadable()
				} catch error {
