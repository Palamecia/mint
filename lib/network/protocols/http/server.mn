		/**
		 * This class provides an asynchronous implementation of the server side of the HTTP protocol. It can be used
		 * with the {Runtime.Scheduler} class.
		 */
		@class AsyncServer {
			/**
			 * Creates a new server context for the given `socket`. The `socket` parameter must implement the
			 * {Network.Socket} interface.
			 * 
			 * The `RequestHandler` can provide a class that will be used to create clients context on client
			 * connection.
			 */
			const def new(self, socket, RequestHandler = Network.Http.AsyncRequestHandler) {
				self.RequestHandler = RequestHandler
				self.configuration = Network.Http.ServerConfiguration()
				self.configuration.resolver = Network.Http.StaticResolver(System.Directory.current())
				self.channel = Network.AsyncChannel(socket, Network.AsyncServerSerializer)
				return self
			}

			/**
			 * Tells the channel to listen for incoming connections on address configured by `endpoint`. Returns `true`
			 * on success; otherwise returns `false`. This method calls the {Network.AsyncChannel.listen} method of the
			 * underlying channel.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def listen(self, endpoint) {
				try {
					return self.channel.listen(endpoint)
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Returns the next message object in the reply queue or `none` if no more message is available.
			 * 
			 * This method suspends the current coroutine until the connection attempt either succeeds or fails.
			 *
			 * The message objects are created from a {Serializer.DataStream} using the serializer class. The serializer
			 * must receive enough data from the peer to construct a message using the {Network.Socket.read} method of the
			 * underlying socket.
			 */
			const async def accept(self) {
				try {
					return (self.RequestHandler)(await self.channel.read(), self.getConfiguration().clone())
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Stops listening for incoming connections.
			 *
			 * Returns `true` if the server was successfully closed.
			 *
			 * This method calls the {Network.AsyncChannel.close} method of the underlying channel.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def close(self) {
				try {
					return self.channel.close()
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * This method can be rebound to handle client connection events. The
			 * `client` parameter is the handler that received the event. This
			 * method can be used to begin exchanges with the peer.
			 */
			var async def onAccept(self, client) {
				self.channel.getScheduler().spawn(client.run())
			}

			/**
			 * Runs the asynchronous server loop. The loop will accept incoming connections and call {@see onAccept} for
			 * each connection. The loop will continue until the channel is closed or an error occurs.
			 */
			const async def run(self) {
				while self.channel.isOpen() {
					if let client = await self.accept() {
						await self.onAccept(client)
					} else {
						break
					}
				}
			}

			/**
			 * Returns the scheduler associated with the object. This method calls the
			 * {Network.AsyncChannel.getScheduler} method of the underlying object.
			 */
			const def getScheduler(const self) {
				return self.channel.getScheduler()
			}
	
			/**
			 * Returns the server's configuration as an instance of {Network.Http.ServerConfiguration}.
			 */
			const def getConfiguration(const self) {
				return self.configuration
			}

			/**
			 * Sets the server's configuration to `configuration`. The `configuration` parameter should be an instance
			 * of {Network.Http.ServerConfiguration}.
			 */
			const def setConfiguration(self, configuration) {
				self.configuration = configuration
			}

			/// Internal request handler class.
			-final const RequestHandler = none
			
			/// Internal listening channel.
			- final channel = null
			
			/// Internal configuration.
			- final configuration = null
		}
	
		/**
		 * This class provides a base implementation to handle {Network.Http.AsyncServer}'s clients' requests.
		 */
		@class AsyncRequestHandler : Network.Http.AbstractRequestHandler {
			/**
			 * Creates a new handler for the given `socket` client. The `socket` parameter must implement the
			 * {Network.Socket} interface. The `configuration` parameter is the default configuration provided by the
			 * {Network.Http.AsyncServer}.
			 */
			const def new(self, socket, configuration) {
				self.channel = Network.AsyncChannel(socket, Network.Http.AsyncSerializer)
				self.configuration = configuration
				return self
			}

			/**
			 * Pushes the message object described by `data` to the request queue and asynchronously sends it to the
			 * peer.
			 */
			const async def write(self, data) {
				switch typeof data {
				case 'Network.Http.Message':
					return await self.channel.write(data)
				default:
					let message = Network.Http.Message()
					for name, value in self.attributes {
						message.setHeader(name, value)
					}
					message.setBody(data)
					return await self.channel.write(message)
				}
			}

			/**
			 * Asynchronously receives the next message from the peer.
			 */
			const async def read(self) {
				return await self.channel.read()
			}

			/**
			 * Closes the communication with the peer.
			 * 
			 * Returns `true` if the context was successfully closed.
			 *
			 * This method calls the {Network.AsyncChannel.close} method of the underlying channel.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def close(self) {
				try {
					return self.channel.close()
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Runs the asynchronous server loop. The loop will read messages from the underlying channel and call
			 * {@see onMessage} for each message received. The loop will continue until the channel is closed or an
			 * error occurs.
			 */
			const async def run(self) {
				while self.channel.isOpen() {
					if let message = await self.channel.read() {
						await self.onMessage(self, message)
					} else {
						break
					}
				}
			}

			/**
			 * This method can be rebound to handle a message. The `client` parameter is the context that received the
			 * message and the `message` parameter is the message that was received.
			 */
			var async def onMessage(self, client, message) {
				if let resolver = self.configuration.resolver {
					if let callback = resolver.resolve(message) {
						return await callback(self, message)
					}
				}
				return await self.onBadRequest(client, message)
			}

			/**
			 * This method can be rebound to handle unresolved requests. The `client` parameter is the context that
			 * received the event. The `message` parameter is the message containing the request.
			 */
			var async def onBadRequest(self, client, message) {
				var response = Network.Http.Message()
				response.setStatus(400)
				client.write(response)
			}

			/**
			 * Returns the scheduler associated with the object. This method calls the
			 * {Network.AsyncChannel.getScheduler} method of the underlying object.
			 */
			const def getScheduler(const self) {
				return self.channel.getScheduler()
			}

			/// Internal channel.
			- final channel = null
			
			/// Internal configuration.
			- final configuration = null
		}
	}
}
