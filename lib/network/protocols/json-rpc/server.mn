 * @module
 * This module provides the JSON-RPC server transports and request handlers
 * exposed by {Network.JsonRpc.Server}, {Network.JsonRpc.AsyncServer}, and
 * {Network.JsonRpc.RequestHandler}. The classes wrap the underlying channel
 * abstraction and can be used either directly or through the runtime scheduler.
 */

load network.channel
load network.protocols.json-rpc.serializer
load network.protocols.json-rpc.exception
load network.protocols.json-rpc.message
load mint.string

package Network {
	package JsonRpc {
		/**
		 * Stores the default configuration values used by JSON-RPC server instances.
		 */
		@class ServerConfiguration {
			/// Server's default HTTP attributes.
			var attributes = {}
		}

		/**
		 * Base class for JSON-RPC request handlers that process incoming client messages.
		 */
		@class AbstractRequestHandler {
			/**
			 * Returns the name of the method from the handler that must be called for the JSON-RPC method identified
			 * by `method`.
			 * 
			 * The method name is created by replacing each non alpha numeric character from the method with `'_'` and
			 * adding the `'rpc_'` prefix.
			 */
			@const def toMethodSymbol(method) {
				var callMethod = 'rpc_'
				for let ch in method {
					if ch.isAlnum() {
						callMethod << ch
					} else {
						callMethod << '_'
					}
				}
				return callMethod
			}

			/**
			 * This method can be rebound to handle notification messages. The `method`
			 * parameter is the method of the notification. The `params` parameter is a
			 * hash containing the parameters of the notification.
			 * 
			 * The default implementation calls the handler's method return by {@see
			 * toMethodSymbol} for the notification method.
			 */
			var def onRpcNotification(self, method, params) {
				const callMethod = Network.JsonRpc.AbstractRequestHandler.toMethodSymbol(method)
				if callMethod not in membersof self {
					raise Network.JsonRpc.MethodNotFound(method)
				}
				self.${callMethod}(params)
			}

			/**
			 * This method can be rebound to handle request messages. The `id`
			 * parameter is the identifier of the message. The `method` parameter
			 * is the method of the request. The `params` parameter is a hash
			 * containing the parameters of the request. The method can return
			 * a value that will be used as the result of the request.
			 * 
			 * The default implementation calls the handler's method return by {@see
			 * toMethodSymbol} for the request method.
			 */
			var def onRpcRequest(self, id, method, params) {
				const callMethod = Network.JsonRpc.AbstractRequestHandler.toMethodSymbol(method)
				if callMethod not in membersof self {
					raise Network.JsonRpc.MethodNotFound(method)
				}
				return self.${callMethod}(params)
			}

			/**
			 * This method can be rebound to handle rezsponse messages. The `id`
			 * parameter is the identifier of the message. The `result` parameter
			 * is the result of the request if any or `none`. The `error` parameter
			 * is a hash containing the error encontred when handling the request
			 * if any or `none`.
			 * 
			 * The default implementation does nothing.
			 */
			var def onRpcResponse(self, id, result, error) {

			}
		}

		/**
		 * This class provides the event-driven server-side JSON-RPC transport. It
		 * can be used with a {Network.Poller} or directly through the runtime
		 * scheduler exposed by the underlying channel.
		 */
		@class Server {
			/**
			 * Creates a new server context for the given `socket`. The `socket` parameter must implement the
			 * {Network.Socket} interface.
			 * 
			 * The `RequestHandler` can provide a class that will be used to create clients context on client
			 * connection.
			 */
			const def new(self, socket, RequestHandler = Network.JsonRpc.RequestHandler) {
				self.configuration = Network.Http.ServerConfiguration()
				self.channel = Network.EventChannel(socket, Network.ServerSerializer)
				self.channel.onState = def [self] (_, channel, %state) {
					self.onState(self, state)
				}
				self.channel.onMessage = def [self, RequestHandler] (_, channel) {
					self.onAccept(RequestHandler(channel.read(), self.getConfiguration().clone()))
				}
				self.channel.onOpen = def [self] (_, channel) {
					self.onOpen(self)
				}
				self.channel.onClose = def [self] (_, channel) {
					self.onClose(self)
				}
				return self
			}

			/**
			 * Makes the server watched by `poller`. The `poller` parameter should be an instance of {Network.Poller}
			 * that will be used to watch for network events on the server. {Network.Poller.watch} will be
			 * automatically called for the server and also all the create client contexts.
			 */
			const def watchedBy(self, poller) {
				self.onAccept = def [self, poller] (_, client) {
					client.onClose = def [self, poller] (_, client) {
						poller.unwatch(client)
					}
					poller.watch(client)
				}
				poller.watch(self)
				return self
			}

			/**
			 * Tells the channel to listen for incoming connections on address configured by `endpoint`. Returns `true`
			 * on success; otherwise returns `false`. This method calls the {Network.EventChannel.listen} method of the
			 * underlying channel.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def listen(self, endpoint) {
				try {
					return self.channel.listen(endpoint)
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Stops listening if the context was openned with {@see listen}.
			 * This method calls the {Network.EventChannel.close}
			 * method of the underlying channel. If the socket was successfully closed,
			 * {@see onClose} is called; otherwise the socket will be closed later.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def close(self) {
				try {
					return self.channel.close()
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Returns the context's socket's handle as an instance of `mint::handle_t`. This method calls the
			 * {Network.EventChannel.getHandle} method of the underlying channel.
			 */
			const def getHandle(const self) {
				return self.channel.getHandle()
			}

			/**
			 * Returns the underlying end point object. This method calls the
			 * {Network.EventChannel.getEndpoint} method of the underlying
			 * channel.
			 */
			const def getEndpoint(const self) {
				return self.channel.getEndpoint()
			}

			/**
			 * Returns the current state of the context as a value of
			 * {Network.Socket.State}. This method calls the
			 * {Network.EventChannel.getState} method of the underlying
			 * channel.
			 */
			const def getState(const self) {
				return self.channel.getState()
			}

			/**
			 * Returns the events expected by the context as mask of values from the
			 * {Network.PollEvent} enum. This method calls the
			 * {Network.EventChannel.getEvents} method of the underlying
			 * channel.
			 */
			const def getEvents(const self) {
				return self.channel.getEvents()
			}

			/**
			 * Returns `true` if the channel performs I/O operations asynchronously
			 * (i.e. read or write data without blocking other channels); otherwise
			 * returns `false`. This method calls the
			 * {Network.EventChannel.isNonBlocking} method of the underlying
			 * channel.
			 */
			const def isNonBlocking(const self) {
				return self.channel.isNonBlocking()
			}

			/**
			 * Sets the non blocking mode of the channel to `enabled`. This method
			 * calls the {Network.EventChannel.setNonBlocking} method of
			 * the underlying channel. Returns `true` if the mode was successfully
			 * changed; otherwise returns `false`.
			 * 
			 * > [!WARNING]
			 * > Disable the non blocking mode on a context can slow down any network
			 * > I/O operations of the application. Other channels will not be able
			 * > to perform I/O operations until the current operation's
			 * > acknowledgment by the peer.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def setNonBlocking(self, enabled) {
				try {
					return self.channel.setNonBlocking(enabled)
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Returns the server's configuration as an instance of {Network.JsonRpc.ServerConfiguration}.
			 */
			const def getConfiguration(const self) {
				return self.configuration
			}

			/**
			 * Sets the server's configuration to `configuration`. The `configuration` parameter should be an instance
			 * of {Network.JsonRpc.ServerConfiguration}.
			 */
			const def setConfiguration(self, configuration) {
				self.configuration = configuration
			}

			/**
			 * Notifies the context that the underlying channel is readable. This
			 * method calls the {Network.EventChannel.notifyReadable}
			 * method of the underlying channel.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def notifyReadable(self) {
				try {
					self.channel.notifyReadable()
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Notifies the channel that the underlying end point is writable. This
			 * method calls the {Network.EventChannel.notifyWritable}
			 * method of the underlying channel.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def notifyWritable(self) {
				try {
					self.channel.notifyWritable()
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Notifies the channel that the underlying end point has received
			 * a new connection request. This method calls the
			 * {Network.EventChannel.notifyConnection} method of the
			 * underlying channel.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def notifyConnection(self) {
				try {
					self.channel.notifyConnection()
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Notifies the channel that the connection was closed by the peer. This
			 * method calls the {Network.EventChannel.notifyClosed} method
			 * of the underlying channel.
			 * 
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def notifyClosed(self) {
				try {
					self.channel.notifyClosed()
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Notifies the channel that the underlying end point has received an error.
			 * This method calls the {Network.EventChannel.notifyClosed} method
			 * of the underlying channel and an instance of {Exception.SocketError}
			 * is raised.
			 */
			const def notifyError(self) {
				try {
					self.channel.notifyError()
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * This method can be rebound to handle client connection events. The
			 * `client` parameter is the handler that received the event. This
			 * method can be used to begin exchanges with the peer.
			 */
			var def onAccept(self, client) {}

			/**
			 * This method can be rebound to handle state change events. The `server`
			 * parameter is the context that received the event and the `state` parameter
			 * is the state that will be applied to the underlying channel. The previous
			 * state can still be accessed with {@see getState} until the end of the method.
			 * 
			 * > [!WARNING]
			 * > Calling {Network.Endpoint.setState} in this method can result in an
			 * > infinite loop.
			 */
			var def onState(self, server, %state) {}
			
			/**
			 * This method can be rebound to handle connection success events. The
			 * `server` parameter is the context that received the event. This
			 * method can be used to begin exchanges with the peer.
			 */
			var def onOpen(self, server) {}
			
			/**
			 * This method can be rebound to handle close events. The `server`
			 * parameter is the context that received the event. This can be used
			 * to cleanup a context or try to reconnect when the connection was
			 * closed by the peer.
			 */
			var def onClose(self, server) {}

			/// Internal channel.
			- final channel = null

			/// Internal default configuration.
			- final configuration = null
		}

		/**
		 * This class provides a base implementation to handle requests received by
		 * {Network.JsonRpc.Server}.
		 */
		@class RequestHandler : Network.JsonRpc.AbstractRequestHandler {
			/**
			 * Creates a new handler for the given `socket` client. The `socket` parameter must implement the
			 * {Network.Socket} interface. The `configuration` parameter is the default configuration provided by the
			 * {Network.JsonRpc.Server}.
			 */
			const def new(self, socket, configuration) {
				self.channel = Network.EventChannel(socket, Network.JsonRpc.Serializer)
				self.channel.onState = def [self] (_, channel, %state) {
					self.onState(self, state)
				}
				self.channel.onMessage = def [self] (_, channel) {
					self.onMessage(self)
				}
				self.channel.onOpen = def [self] (_, channel) {
					self.onOpen(self)
				}
				self.channel.onClose = def [self] (_, channel) {
					self.onClose(self)
				}
				self.configuration = configuration
				return self
			}

			/**
			 * Pushes the message object described by `data` to the request queue.
			 * This method calls the {Network.EventChannel.write} method
			 * of the underlying channel.
			 * 
			 * The `data` parameter can be an instance of {Network.JsonRpc.Message};
			 * otherwise an instance will be created depending on the type of the
			 * parameter using {Network.JsonRpc.Message.fromString} for a string
			 * or {Network.JsonRpc.Message.new} for a hash. Attributes can be
			 * added to default created messages using {@see setDefaultAttributes}.
			 */
			const def write(self, data) {
				switch typeof data {
				case 'Network.JsonRpc.Message':
					return self.channel.write(data)
				case 'string':
					return self.channel.write(Network.JsonRpc.Message.fromString(data, self.configuration.attributes))
				default:
					return self.channel.write(Network.JsonRpc.Message(data, self.configuration.attributes))
				}
			}

			/**
			 * Returns the next message object in the reply queue or `none` if no
			 * more message is available. This method calls the
			 * {Network.EventChannel.read} method of the underlying channel.
			 */
			const def read(self) {
				return self.channel.read()
			}

			/**
			 * Closes the communication with the peer. This method calls the
			 * {Network.EventChannel.close} method of the underlying channel.
			 * If the socket was successfully closed, {@see onClose} is called;
			 * otherwise the socket will be closed later.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def close(self) {
				try {
					return self.channel.close()
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Returns the handler's socket's handle as an instance of `mint::handle_t`. This method calls the
			 * {Network.EventChannel.getHandle} method of the underlying channel.
			 */
			const def getHandle(const self) {
				return self.channel.getHandle()
			}

			/**
			 * Returns the underlying end point object. This method calls the
			 * {Network.EventChannel.getEndpoint} method of the underlying
			 * channel.
			 */
			const def getEndpoint(const self) {
				return self.channel.getEndpoint()
			}

			/**
			 * Returns the current state of the handler as a value of
			 * {Network.Socket.State}. This method calls the
			 * {Network.EventChannel.getState} method of the underlying
			 * channel.
			 */
			const def getState(const self) {
				return self.channel.getState()
			}

			/**
			 * Returns the events expected by the handler as mask of values from the
			 * {Network.PollEvent} enum. This method calls the
			 * {Network.EventChannel.getEvents} method of the underlying
			 * channel.
			 */
			const def getEvents(const self) {
				return self.channel.getEvents()
			}

			/**
			 * Returns `true` if the channel performs I/O operations asynchronously
			 * (i.e. read or write data without blocking other channels); otherwise
			 * returns `false`. This method calls the
			 * {Network.EventChannel.isNonBlocking} method of the underlying
			 * channel.
			 */
			const def isNonBlocking(const self) {
				return self.channel.isNonBlocking()
			}

			/**
			 * Sets the non blocking mode of the channel to `enabled`. This method
			 * calls the {Network.EventChannel.setNonBlocking} method of
			 * the underlying channel. Returns `true` if the mode was successfully
			 * changed; otherwise returns `false`.
			 * 
			 * > [!WARNING]
			 * > Disable the non blocking mode on a context can slow down any network
			 * > I/O operations of the application. Other channels will not be able
			 * > to perform I/O operations until the current operation's
			 * > acknowledgment by the peer.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def setNonBlocking(self, enabled) {
				try {
					return self.channel.setNonBlocking(enabled)
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Returns the handler's configuration as an instance of {Network.JsonRpc.ServerConfiguration}.
			 */
			const def getConfiguration(const self) {
				return self.configuration
			}

			/**
			 * Sets the handler's configuration to `configuration`. The `configuration` parameter should be an instance
			 * of {Network.JsonRpc.ServerConfiguration}.
			 */
			const def setConfiguration(self, configuration) {
				self.configuration = configuration
			}

			/**
			 * Notifies the context that the underlying channel is readable. This
			 * method calls the {Network.EventChannel.notifyReadable}
			 * method of the underlying channel.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def notifyReadable(self) {
				try {
					self.channel.notifyReadable()
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Notifies the channel that the underlying end point is writable. This
			 * method calls the {Network.EventChannel.notifyWritable}
			 * method of the underlying channel.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def notifyWritable(self) {
				try {
					self.channel.notifyWritable()
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Notifies the channel that the connection was closed by the peer. This
			 * method calls the {Network.EventChannel.notifyClosed} method
			 * of the underlying channel.
			 * 
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def notifyClosed(self) {
				try {
					self.channel.notifyClosed()
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Notifies the channel that the underlying end point has received an error.
			 * This method calls the {Network.EventChannel.notifyClosed} method
			 * of the underlying channel and an instance of {Exception.SocketError}
			 * is raised.
			 */
			const def notifyError(self) {
				try {
					self.channel.notifyError()
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * This method can be rebound to handle message events. The `client`
			 * parameter is the context that received the event. The messages can
			 * be accessed using the {@see read} method.
			 * 
			 * The default implementation calls {@see onRpcNotification},
			 * {@see onRpcRequest} or {@see onRpcResponse} for each received
			 * message depending on its type.
			 * 
			 * > [!NOTE]
			 * > This method can be called for one or more messages and will not be
			 * > called until the underlying end point receive more data.
			 * > The {@see read} method should then be called by this method until
			 * > `none` is returned.
			 */
			var def onMessage(self, client) {
				
				const JsonRpcVersion = '2.0'

				while let message = client.read() {

					let body = message.getBody()

					if 'jsonrpc' not in body or body['jsonrpc'] != JsonRpcVersion {
						return none
					}

					if 'id' not in body {
						self.onRpcNotification(body.get('method'), body.get('params'))
					} elif 'method' not in body {
						self.onRpcResponse(body.get('id'), body.get('result'), body.get('error'))
					} else {
						try {
							let result = self.onRpcRequest(body.get('id'), body['method'], body.get('params'))
							if defined result {
								self.write(Network.JsonRpc.Message({
									"jsonrpc": JsonRpcVersion,
									"result": result,
									"id": body.get('id')
								}))
							}
						} catch error {
							self.write(Network.JsonRpc.Message({
								'jsonrpc': JsonRpcVersion,
								'id': body.get('id'),
								'error': error.toHash()
							}))
						}
					}
				}
			}

			/**
			 * This method can be rebound to handle state change events. The `client`
			 * parameter is the context that received the event and the `state` parameter
			 * is the state that will be applied to the underlying channel. The previous
			 * state can still be accessed with {@see getState} until the end of the method.
			 * 
			 * > [!WARNING]
			 * > Calling {Network.Endpoint.setState} in this method can result in an
			 * > infinite loop.
			 */
			var def onState(self, client, %state) {}

			/**
			 * This method can be rebound to handle connection success events. The
			 * `client` parameter is the context that received the event. This
			 * method can be used to begin exchanges with the peer.
			 */
			var def onOpen(self, client) {}

			/**
			 * This method can be rebound to handle close events. The `client`
			 * parameter is the context that received the event. This can be used
			 * to cleanup a context or try to reconnect when the connection was
			 * closed by the peer.
			 */
			var def onClose(self, client) {}

			/// Internal channel.
			- final channel = null
			
			/// Internal default configuration.
			- final configuration = null
		}

		/**
		 * This class provides an asynchronous implementation of the server-side
		 * JSON-RPC transport. It can be used with {Runtime.Scheduler} and Mint
		 * coroutines.
		 */
		@class AsyncServer {
			/**
			 * Creates a new asynchronous server context for the given `endpoint`.
			 * The `endpoint` parameter must implement the {Network.Socket} interface.
			 *
			 * The `RequestHandler` parameter can provide a class that will be used to
			 * create client contexts on incoming connections.
			 */
			const def new(self, endpoint, RequestHandler = Network.JsonRpc.AsyncRequestHandler) {
				self.RequestHandler = RequestHandler
				self.channel = Network.AsyncChannel(endpoint, Network.AsyncServerSerializer)
				return self
			}

			/**
			 * Tells the channel to listen for incoming connections on address
			 * configured by `endpoint`. Returns `true` on success; otherwise
			 * returns `false`.
			 */
			const def listen(self, endpoint) {
				try {
					return self.channel.listen(endpoint)
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
			}

			/**
			 * Accepts the next incoming connection and returns a request handler for it.
			 */
			const async def accept(self) {
				try {
					return (self.RequestHandler)(await self.channel.read(), self.getConfiguration().clone())
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
				return none
			}

			/**
			 * Stops listening for incoming connections.
			 *
			 * Returns `true` if the server was successfully closed.
			 *
			 * This method calls the {Network.AsyncChannel.close} method of the underlying channel.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def close(self) {
				try {
					return self.channel.close()
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
				return false
			}

			/**
			 * This method can be rebound to handle client connection events. The
			 * `client` parameter is the handler that received the event. This
			 * method can be used to begin exchanges with the peer.
			 */
			var async def onAccept(self, client) {
				self.channel.getScheduler().spawn(client.run())
			}

			/**
			 * Runs the asynchronous server loop. The loop will accept incoming connections and call {@see onAccept} for
			 * each connection. The loop will continue until the channel is closed or an error occurs.
			 */
			const async def run(self) {
				while self.channel.isOpen() {
					if let client = await self.accept() {
						await self.onAccept(client)
					} else {
						break
					}
				}
			}

			/**
			 * Returns the scheduler associated with the object. This method calls the
			 * {Network.AsyncChannel.getScheduler} method of the underlying object.
			 */
			const def getScheduler(const self) {
				return self.channel.getScheduler()
			}
	
			/**
			 * Returns the server's configuration as an instance of {Network.Http.ServerConfiguration}.
			 */
			const def getConfiguration(const self) {
				return self.configuration
			}

			/**
			 * Sets the server's configuration to `configuration`. The `configuration` parameter should be an instance
			 * of {Network.Http.ServerConfiguration}.
			 */
			const def setConfiguration(self, configuration) {
				self.configuration = configuration
			}

			/// Internal request handler class.
			-final const RequestHandler = none
			
			/// Internal listening channel.
			- final channel = null
			
			/// Internal configuration.
			- final configuration = null
		}

		/**
		 * This class provides an asynchronous request handler for
		 * {Network.JsonRpc.AsyncServer}.
		 */
		@class AsyncRequestHandler : Network.JsonRpc.AbstractRequestHandler {
			/**
			 * Creates a new handler for the given `socket` client. The `socket` parameter must implement the
			 * {Network.Socket} interface. The `configuration` parameter is the default configuration provided by the
			 * {Network.JsonRpc.AsyncServer}.
			 */
			const def new(self, socket, configuration) {
				self.channel = Network.AsyncChannel(socket, Network.JsonRpc.AsyncSerializer)
				self.configuration = configuration
				return self
			}

			/**
			 * Pushes the message object described by `data` to the request queue and asynchronously sends it to the
			 * peer.
			 */
			const async def write(self, data) {
				switch typeof data {
				case 'Network.JsonRpc.Message':
					return await self.channel.write(data)
				case 'string':
					return await self.channel.write(Network.JsonRpc.Message.fromString(data, self.configuration.attributes))
				default:
					return await self.channel.write(Network.JsonRpc.Message(data, self.configuration.attributes))
				}
			}

			/**
			 * Asynchronously receives the next message from the peer.
			 */
			const async def read(self) {
				return await self.channel.read()
			}

			/**
			 * Closes the communication with the peer.
			 * 
			 * Returns `true` if the context was successfully closed.
			 *
			 * This method calls the {Network.AsyncChannel.close} method of the underlying channel.
			 * 
			 * An instance of {Exception.SocketError} is raised on error.
			 */
			const def close(self) {
				try {
					return self.channel.close()
				} catch error {
					if typeof error === 'Exception.SocketError' {
						raise in Exception.SocketError(error.getErrno(), self)
					} else {
						raise
					}
				}
				return false
			}

			/**
			 * This method can be rebound to handle a message. The `client` parameter is the context that received the
			 * message and the `message` parameter is the message that was received.
			 */
			var async def onMessage(self, message) {

				const JsonRpcVersion = '2.0'

				let body = message.getBody()

				if 'jsonrpc' not in body or body['jsonrpc'] != JsonRpcVersion {
					return none
				}

				if 'id' not in body {
					self.onRpcNotification(body.get('method'), body.get('params'))
				} elif 'method' not in body {
					self.onRpcResponse(body.get('id'), body.get('result'), body.get('error'))
				} else {
					try {
						let result = self.onRpcRequest(body.get('id'), body['method'], body.get('params'))
						if defined result {
							await self.write(Network.JsonRpc.Message({
								"jsonrpc": JsonRpcVersion,
								"result": result,
								"id": body.get('id')
							}))
						}
					} catch error {
						await self.write(Network.JsonRpc.Message({
							'jsonrpc': JsonRpcVersion,
							'id': body.get('id'),
							'error': error.toHash()
						}))
					}
				}
			}

			/**
			 * Runs the asynchronous server loop. The loop will read messages from the underlying channel and call
			 * {@see onMessage} for each message received. The loop will continue until the channel is closed or an
			 * error occurs.
			 */
			const async def run(self) {
				while self.channel.isOpen() {
					if let message = await self.channel.read() {
						await self.onMessage(self, message)
					} else {
						break
					}
				}
			}

			/**
			 * Returns the scheduler associated with the object. This method calls the
			 * {Network.AsyncChannel.getScheduler} method of the underlying object.
			 */
			const def getScheduler(const self) {
				return self.channel.getScheduler()
			}

			/// Internal channel.
			- final channel = null
			
			/// Internal configuration.
			- final configuration = null
		}
	}
}
