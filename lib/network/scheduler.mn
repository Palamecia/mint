 * @module
 * This module provides the {Network.Scheduler} class which manages synchronization
 * between the network devices.
 */

load exception.network
load mint.function
load mint.lockguard
load system.thread

package Network {
	/**
	 * This class manages synchronization between the network devices.
	 */
	class Scheduler {
		/**
		 * This enum describe the events that can be watched on a specific channel.
		 */
		enum PollEvent {
			/// This event is set when the endpoint has some waiting data to read.
			Read   = 0x0001
			/// This event is set when the data can be sent to the endpoint.
			Write  = 0x0002
			/// This event is set when a new connection is detected.
			Accept = 0x0004
			/// This event is set when an error is detected.
			Error  = 0x0008
			/// This event is set when the connection is closed by the peer.
			Close  = 0x0010
		}

		/**
		 * This class describe the polling state of a specific channel.
		 */
		class PollDescriptor {
			/**
			 * Creates a new context for the channel given by `channel`. The
			 * `channel` object must provide a `getSocket` method returning the
			 * socket as a number.
			 */
			const def new(self, channel) {
				var socket = channel.getSocket()
				if defined socket {
					self.handle = self.g_lib.call('mint_scheduler_pollfd_new', socket)
					self.handle.delete = def [g_lib = Network.Scheduler.PollDescriptor.g_lib] (self) {
						g_lib.call('mint_scheduler_pollfd_delete', self)
					}
					return self
				}
			}

			/**
			 * Returns the handle of the channel used by {Network.Scheduler}.
			 */
			const def getHandle(const self) {
				return self.handle
			}

			/**
			 * Returns the events activated on the channel as a mask of value from
			 * the {Network.Scheduler.PollEvent} enum.
			 * 
			 * Only events passed to {@see setRequestedEvents} can be activated.
			 */
			const def getEvents(const self) {
				return self.g_lib.call('mint_scheduler_get_revents', self.handle)
			}

			/**
			 * Returns the events requested on the channel as a mask of value from
			 * the {Network.Scheduler.PollEvent} enum.
			 */
			const def getRequestedEvents(const self) {
				return self.g_lib.call('mint_scheduler_get_events', self.handle)
			}

			/**
			 * Sets requested events to `events` on the channel. The `events`
			 * parameter must be a mask of values from the {Network.Scheduler.PollEvent}
			 * enum.
			 */
			const def setRequestedEvents(self, events) {
				self.g_lib.call('mint_scheduler_set_events', self.handle, events)
			}

			/**
			 * Waits until the activation of a requested event of the channel or
			 * until `timeout` milliseconds if no event become activated during
			 * this period.
			 * 
			 * Returns `true` if an event was activated; otherwise returns `false`.
			 * 
			 * After a call to this method, the value returned by {@see getEvents}
			 * is updated.
			 */
			const def poll(self, timeout = 500) {
				return Network.Scheduler.poll([self], timeout)
			}

			/// Global library handle.
			- @g_lib = lib('libmint-network')

			/// Internal channel handle.
			- final handle = null
		}

		/**
		 * This class represents the state of an asynchronous operation.
		 */
		class Promise {
			/**
			 * Creates a new promise for the result of the `coroutine` operation.
			 */
			const def new(self, scheduler, coroutine) {
				self.scheduler = scheduler
				self.coroutine = coroutine
				return self
			}

			/**
			 * Starts the associated operation.
			 */
			const async def start(self) {
				self.result = await self.coroutine
				self.scheduler.complete(self)
			}

			/**
			 * Takes the associated operation's result and returns it. If the result is not yet available, the method
			 * returns `none`.
			 */
			const def get(self) {
				return self.result
			}

			/**
			 * Takes the associated operation's result and returns it. If the result is not yet available, the method
			 * returns `none`.
			 */
			const def await(self) {
				return self.get()
			}

			/**
			 * Takes the associated operation's result and returns it. If the result is not yet available, the method
			 * returns `none`.
			 */
			const def ()(self) {
				return self.get()
			}

			/**
			 * Returns `true` if `other` is equal to this promise; otherwise returns `false`.
			 */
			const def ==(const self, const other) {
				return self is other
			}

			/**
			 * Returns `false` if `other` is equal to this promise; otherwise returns `true`.
			 */
			const def !=(const self, const other) {
				return not (self is other)
			}

			/// Internal associated scheduler.
			- final scheduler = null

			/// Internal associated coroutine.
			- final coroutine = null

			/// Internal result.
			- final result = none
		}

		/**
		 * This class describe an asynchronous operation.
		 * 
		 * Operation objects represent asynchronous tasks executed by {Network.Scheduler}.
		 *
		 * An operation encapsulates the logic required to perform a specific
		 * asynchronous action such as connecting, reading, writing or
		 * accepting connections.
		 *
		 * The lifecycle of an operation is typically:
		 *
		 *  1. Created by an endpoint asynchronous method
		 *  2. Submitted to the scheduler using {Network.Scheduler.suspend}
		 *  3. Executed until the operation blocks
		 *  4. Suspended until the required socket event occurs
		 *  5. Resumed by the scheduler
		 *  6. Completed when the operation's result is available
		 *
		 * This design allows asynchronous operations to be expressed in a
		 * sequential style using coroutines while the scheduler handles the
		 * underlying event loop and I/O readiness notifications.
		 */
		class Operation {
			/**
			 * Returns `true` if `other` is equal to this operation; otherwise returns `false`.
			 */
			const def ==(const self, const other) {
				return self is other
			}

			/**
			 * Returns `false` if `other` is equal to this operation; otherwise returns `true`.
			 */
			const def !=(const self, const other) {
				return not (self is other)
			}

			/**
			 * Starts the asynchronous operation. The `callback` function will be called on completion and will resume
			 * `coroutine`.
			 */
			const def start(self, coroutine, callback) {
				self.coroutine = coroutine
				self.callback = callback
			}

			/**
			 * Checks for completion.
			 */
			const def check(self) {
				self.done()
			}

			/**
			 * Returns the operation result.
			 */
			const def get(self) {
				return none
			}

			/**
			 * Notify for completion.
			 */
			# final const def done(self, error = none) {
			    self.callback(self, self.coroutine, error)
			}

			/// Internal associated coroutine.
			- final coroutine = null

			/// Internal completion callback.
			- final callback = null
		}

		/**
		 * Creates a new scheduler for network operations.
		 */
		const def new(self) {
			self.mutex = System.Mutex()
			return self
		}

		/**
		 * Waits until the activation of a requested event of a channel from
		 * `fdset` or until `timeout` milliseconds if no event become activated
		 * during this period. The `fdset` parameter must be an array of
		 * {Network.Scheduler.PollDescriptor}.
		 * 
		 * Returns `true` if an event was activated; otherwise returns `false`.
		 * 
		 * After a call to this method, the values returned by
		 * {Network.Scheduler.PollDescriptor.getEvents} are updated.
		 */
		@const def poll(fdset, timeout) {
			var handleSet = [for let fd in fdset => fd.getHandle()]
			return Network.Scheduler.g_lib.call('mint_scheduler_poll', handleSet, timeout)
		}

		/**
		 * Adds a `channel` to the scheduler. The `channel` object must provides the
		 * `getSocket` method. The same interface than {Network.AsynchronousChannel}
		 * is also expected to automaticaly update the object on events. Returns
		 * `true` if the channel is successfully watched; otherwise returns `false`.
		 */
		const def watch(self, channel) {
			var lock = LockGuard(self.mutex)
			if channel in self.channels {
				return true
			}
			if not channel.setNonBlocking(true) {
				return false
			}
			self.channels[channel] = Network.Scheduler.PollDescriptor(channel)
			return true
		}

		/**
		 * Removes the `channel` from the scheduler. Returns `true` if `channel`
		 * is watched by the scheduler; otherwise returns `false`.
		 */
		const def remove(self, channel) {
			var lock = LockGuard(self.mutex)
			if channel in self.channels {
				self.channels.remove(channel)
				return true
			}
			return false
		}

		/**
		 * Schedules a `coroutine` for execution. Returns an instance of {Network.Scheduler.Promise} associated to
		 * the `coroutine` object.
		 * 
		 * The coroutine is added to the scheduler's ready queue and will be
		 * executed during the next iteration of the event loop.
		 *
		 * Coroutines spawned using this method run concurrently with other
		 * scheduled coroutines.
		 *
		 * The scheduler does not guarantee execution order beyond fairness
		 * between ready coroutines.
		 */
		const def spawn(self, coroutine) {
			let promise = Network.Scheduler.Promise(self, coroutine)
			self.waiting.push(promise)
			return promise
		}

		/**
		 * Removes a completed promise from the running set.
		 */
		const def complete(self, promise) {
			self.running.remove(self.running.indexOf(promise))
		}

		/**
		 * Suspends the current coroutine and registers an asynchronous `operation`.
		 * 
		 * This method is typically called internally by asynchronous endpoint
		 * methods such as {Network.EndPoint.readAsync} or {Network.EndPoint.writeAsync}.
		 *
		 * When invoked:
		 *
		 *  1. The current coroutine is suspended
		 *  2. The operation is registered with the scheduler
		 *  3. The scheduler continues executing other coroutines
		 *
		 * The operation is responsible for indicating when it is ready to
		 * resume. Once the required condition is met (for example, a socket
		 * becomes readable), the scheduler resumes the suspended coroutine.
		 *
		 * The result of the operation is returned to the coroutine when it
		 * resumes.
		 *
		 * This mechanism allows asynchronous operations to be written in a
		 * sequential style using `await`.
		 */
		const async def suspend(self, operation) {

			let coroutine = Network.Scheduler.g_lib.call('mint_scheduler_current_coroutine')
			if not defined coroutine {
				raise Exception.InvalidNetworkOperation('suspend must be called inside a coroutine', self)
			}

			self.operations.push(operation)

			operation.start(coroutine, Callback(self, self.operationCompletion))
			Network.Scheduler.g_lib.call('mint_scheduler_suspend', coroutine)
			return operation.get()
		}

		/**
		 * Resumes `coroutine`. If `error` is defined, the object is imediaimmediately raised after it.
		 */
		- const def operationCompletion(self, operation, coroutine, error = none) {
		    self.operations.remove(self.operations.indexOf(operation))
			if defined error {
				Network.Scheduler.g_lib.call('mint_scheduler_raise', coroutine, error)
			} else {
				Network.Scheduler.g_lib.call('mint_scheduler_resume', coroutine)
			}
		}

		/**
		 * Waits until the activation of a requested event of a watched channel
		 * or until `timeout` milliseconds if no event become activated during
		 * this period. The watched events on a channel are selected using the
		 * {Network.AsynchronousChannel.getEvents} method. Any activated event
		 * on a channel will then be notified to the channel using the
		 * corresponding method:
		 * 
		 * | Event | AsynchronousChannel method |
		 * | ----- | -------------------------- |
		 * | {Network.Scheduler.PollEvent.Read} | {Network.AsynchronousChannel.notifyReadable} |
		 * | {Network.Scheduler.PollEvent.Write} | {Network.AsynchronousChannel.notifyWritable} |
		 * | {Network.Scheduler.PollEvent.Accept} | {Network.AsynchronousChannel.notifyConnection} |
		 * | {Network.Scheduler.PollEvent.Error} | {Network.AsynchronousChannel.notifyError} |
		 * | {Network.Scheduler.PollEvent.Close} | {Network.AsynchronousChannel.notifyClosed} |
		 * 
		 * Returns `true` if an event was activated; otherwise returns `false`.
		 * 
		 * After a call to this method, the values returned by
		 * {Network.Scheduler.PollDescriptor.getEvents} are updated.
		 */
		const def pollEvents(self, timeout = 500) {

			var lock = LockGuard(self.mutex)
			var channelset = []
			var fdset = []

			for let (channel, fd) in self.channels {
				if not defined fd {
					if fd = Network.Scheduler.PollDescriptor(channel) {
						self.channels[channel] = fd
					} else {
						continue
					}
				}
				if let events = channel.getEvents() {
					fd.setRequestedEvents(events)
					channelset.push([channel, fd])
					fdset.push(fd)
				}
			}

			lock = none

			if not Network.Scheduler.poll(fdset, timeout) {
				return false
			}

			for let (channel, fd) in channelset {
				let const revents = fd.getEvents()
				if revents & Network.Scheduler.PollEvent.Read and defined channel.notifyReadable {
					channel.notifyReadable()
				}
				if revents & Network.Scheduler.PollEvent.Write and defined channel.notifyWritable {
					channel.notifyWritable()
				}
				if revents & Network.Scheduler.PollEvent.Accept and defined channel.notifyConnection {
					channel.notifyConnection()
				}
				if revents & Network.Scheduler.PollEvent.Error and defined channel.notifyError {
					channel.notifyError()
				}
				if revents & Network.Scheduler.PollEvent.Close {
					self.channels[channel] = none
					if defined channel.notifyClosed {
						channel.notifyClosed()
					}
				}
			}

			return true
		}

		/**
		 * Checks for suspended operations completion. Each completed operation will resume their coroutine.
		 */
		const def checkOperations(self) {
			for let operation in self.operations {
				operation.check()
			}
		}

		/*
		 * Execute a single iteration of the event loop.
		 *
		 * Ready coroutines are executed until they suspend or complete, pending operations are progressed, and I/O
		 * events are processed. Coroutines whose operations have completed are scheduled for execution.
		 * 
		 * The `timeout` parameter is forwarded to {@see pollEvents} to stop event handling if no event is activated
		 * until the specified amount of time (in milliseconds) and check for suspended operations completion.
		 */
		const def synchronize(self, timeout = 500) {
			if self.waiting.isEmpty() {
				self.pollEvents(timeout)
				self.checkOperations()
			} else {
				let promise = self.waiting.shift()
				self.running.push(promise)
				Network.Scheduler.g_lib.call('mint_scheduler_spawn', promise.start())
			}
		}

		/**
		 * Runs the synchronization loop synchronously. This loop calls {@see synchronize} until no more channel is
		 * watched. The `timeout` parameter is forwarded to the called method.
		 */
		const def run(self, timeout = 500) {
			while not self.channels.isEmpty() {
				self.synchronize(timeout)
			}
		}

		/**
		 * Runs the synchronization loop synchronously. This loop calls {@see pollEvents} and {@see checkOperations}
		 * until a coroutine added with {Network.Scheduler.spawn} is completed. The `timeout` parameter is forwarded
		 * to the called method.
		 */
		const def runOne(self, timeout = 500) {
			if not self.waiting.isEmpty() {
				let promise = self.waiting.shift()
				self.running.push(promise)
				Network.Scheduler.g_lib.call('mint_scheduler_spawn', promise.start())
			} 
			while not self.operations.isEmpty() {
				self.pollEvents(timeout)
				self.checkOperations()
			}
		}

		/**
		 * Runs the synchronization loop synchronously. This loop calls {@see synchronize} until all coroutines added
		 * with {Network.Scheduler.spawn} is completed. The `timeout` parameter is forwarded to the called method.
		 */
		const def runAll(self, timeout = 500) {
			while not self.operations.isEmpty() or not self.waiting.isEmpty() {
				self.synchronize(timeout)
			}
		}

		/// Global library handle.
		- @g_lib = lib('libmint-network')

		/// Internal channel access mutex.
		- final mutex = null

		/// Internal channels context.
		- final channels = {}

		/// Internal list of waiting coroutines.
		- final waiting = []

		/// Internal list of running promises.
		- final running = []

		/// Internal list of waiting operations.
		- final operations = []
	}

	/**
	 * This class manages synchronization between the network devices in a thread.
	 */
	class SchedulerThread : Network.Scheduler {
		/**
		 * Creates a new scheduler for threaded network operations.
		 */
		const def new(self) {
			if Network.Scheduler.new(self) {
				self.thread = System.Thread(self, self.synchronizationLoop)
				return self
			}
		}

		/**
		 * Starts the synchronization loop in a separate thread. This loop calls
		 * {@see synchronize} forever until {@see stopSynchronizationLoop} is
		 * called. The `timeout` parameter is forwarded to the called method.
		 */
		const def startSynchronizationLoop(self, timeout = 500) {
			self.loopRunning = true
			self.thread.start(timeout)
		}

		/**
		 * Stops the synchronization loop thread.
		 */
		const def stopSynchronizationLoop(self) {
			self.loopRunning = false
			self.thread.join()
		}

		/**
		 * Runs the synchronization loop. This loop calls {@see synchronize}
		 * forever until {@see stopSynchronizationLoop} is called. The `timeout`
		 * parameter is forwarded to the called method.
		 */
		# const def synchronizationLoop(self, timeout) {
			while self.loopRunning {
				self.synchronize(timeout)
			}
		}

		/// Internal synchronization loop state.
		- final loopRunning = false

		/// Internal synchronization thead handle.
		- final thread = null
	}

}
