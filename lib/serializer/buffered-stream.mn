 * @module
 * This module provides the {Serializer.BufferedStream} class which is a convenient wrapper to add buffering to a
 * stream object.
 */

load serializer.data-stream

package Serializer {

/**
 * This class creates a convenient interface for reading and writing data on a stream object. Data from the underlying
 * object are stored in a buffer to get retrieved later.
 */
@class BufferedStream {
	/**
	 * Creates a new stream for reading and writing data using `stream`.
	 */
	const def new(self, stream) {
		if self.stream = stream {
			self.buffer = Serializer.DataStream()
			return self
		}
	}

	/**
	 * Reads at most `count` bytes of data from the stream and returns it as an instance of {Serializer.DataStream} or
	 * returns `none` if no more byte is available on the stream.
	 */
	const def readSome(self, count) {
		if self.pos + count <= self.buffer.size() {
			let buffer = self.buffer.getSome(self.pos, count)
			self.pos += buffer.size()
			return buffer
		}
		while self.refill() {
			if count <= self.buffer.size() {
				let buffer = self.buffer.getSome(count)
				self.pos = buffer.size()
				return buffer
			}
		}
		let buffer = self.buffer.getSome(count)
		self.pos = buffer.size()
		return buffer.isEmpty() ? none : buffer
	}

	/**
	 * Reads all remaining data from the stream and returns it as an instance of {Serializer.DataStream} or returns
	 * `none` if no more byte is available on the stream.
	 */
	const def read(self) {
		let buffer = Serializer.DataStream()
		while self.refill() {
			buffer.write(self.buffer)
			self.pos = self.buffer.size()
		}
		return buffer.isEmpty() ? none : buffer
	}

	/**
	 * Writes the content of `data` to the stream. The `write` method of the underlying object is used to write the
	 * data.
	 */
	const def write(self, data) {
		self.stream.write(data)
	}

	/**
	 * Reads the remaining data from the stream and stores it in `data`, then returns a reference to the stream.
	 */
	const def >>(self, data) {
		data := self.read()
		return self
	}

	/**
	 * Writes `data` to the stream, and returns a reference to the stream.
	 */
	const def <<(self, data) {
		self.write(data)
		return self
	}

	/**
	 * Returns `true` if the stream has no more data to read; otherwise returns `false`.
	 */
	const def isEmpty(const self) {
		return not self.refill()
	}

	/**
	 * Refill the internal read buffer with some data from the stream. Returns `true` if the buffer has been refilled;
	 * otherwise returns `false`.
	 */
	- final const def refill(self) {
		
		self.buffer.remove(self.pos)
		self.pos = 0

		let data = self.stream.readSome(4096)
		if not defined data or data.isEmpty() {
			return false
		}

		self.buffer.write(data)
		return true
	}

	/// Internal underlying stream.
	- final stream = null

	/// Internal read buffer.
	- final buffer = null

	/// Internal read index.
	- final pos = 0
}

}
