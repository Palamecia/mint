 * @module
 * This module provides the {Serializer.StringStream} class which allow to use
 * a string object as a stream.
 */

load mint.lang
load mint.type
load mint.math
load mint.string

package Serializer {

/**
 * This class provides an interface to use an instance of string as a stream.
 */
@class StringStream {
	/**
	 * Creates a new stream on the `str` object. If the object is an instance
	 * of string, it will be directly used to be updated on write operations;
	 * otherwise the object is cast to string using the `toString` method. The
	 * written data can then only be retrieved by read operations.
	 */
	const def new(self, str) {
		switch typeof str {
		case 'string':
			self.charBuffer = str
			break
		default:
			self.charBuffer = str.toString()
			break
		}
		return self
	}

	/**
	 * Returns at most `count` bytes from the string as an instance of {Serializer.DataStream}.
	 */
	const def readSome(self, count) {
		if self.bytePos < self.charBuffer.utf8ByteCount() {
			count = min(count, self.charBuffer.utf8ByteCount() - self.bytePos)
			let buffer = Serializer.DataStream.fromUtf8Bytes(self.charBuffer, self.bytePos, count)
			self.bytePos += buffer.size()
			return buffer
		}
	}

	/**
	 * Returns all remaining data from the string as an instance of {Serializer.DataStream}.
	 */
	const def read(self) {
		if self.bytePos < self.charBuffer.utf8ByteCount() {
			let buffer = Serializer.DataStream.fromUtf8Bytes(self.charBuffer, self.bytePos, self.charBuffer.utf8ByteCount() - self.bytePos)
			self.bytePos += buffer.size()
			return buffer
		}
	}

	/**
	 * Appends `data` to the end of the string. The `data` parameter should be an instance of {Serializer.DataStream}
	 * encoding the string as an UTF-8 sequence of bytes.
	 */
	const def write(self, data) {
		self.charBuffer << data.getString(0)
	}

	/**
	 * Reads the remaining data from the stream and stores it in `data`, then returns a reference to the stream.
	 */
	const def >>(self, data) {
		data := self.read()
		return self
	}

	/**
	 * Writes the string `data` to the stream, and returns a reference to the stream.
	 */
	const def <<(self, data) {
		self.write(data)
		return self
	}

	/**
	 * Returns the whole edited string.
	 */
	const def toString(const self) {
		return self.charBuffer
	}

	/**
	 * Returns `true` if the current edited string has no more data to read;
	 * otherwise returns `false`.
	 */
	const def isEmpty(const self) {
		return self.bytePos == self.charBuffer.utf8ByteCount()
	}

	/// Global library handle
	- @const g_lib = lib('libmint-serializer')
	
	/// Internal read char buffer.
	- final charBuffer = null

	/// Internal read byte buffer offset.
	- final bytePos = 0
}

}
