 * @module
 * This module provides the {Serializer.TextStream} class which implement a stream interface for reading and writing
 * text on any kind of object.
 */

load mint.lang
load mint.string
load codec.codec
load exception.codec
load serializer.data-stream
load serializer.string-stream

package Serializer {

/**
 * This class provides an interface to use any object as a stream for reading and writing text.
 */
@class TextStream {
	/**
	 * Creates a new stream on the `stream` object.
	 * 
	 * If the `stream` object provides both `readSome`, `read` and `write` methods, the object is used as is; otherwise
	 * an instance of {Serializer.BufferedStream} is created to provide these methods.
	 * 
	 * The `codec` parameter is used to specify the text codec to use for reading and writing text.
	 * 
	 * If `stream` is not a valid object, `none` is returned.
	 */
	const def new(self, stream, codec = Codec.TextCodec()) {
		if stream {
			self.codec = codec
			self.byteBuffer = Serializer.DataStream()
			if defined stream.readSome and defined stream.read and defined stream.write {
				self.stream = stream
			} else {
				self.stream = Serializer.StringStream(stream)
			}
			if defined self.stream.isEmpty {
				self.isSourceExhausted = def(self) {
					return self.stream.isEmpty()
				}
			} elif defined self.stream.isOver {
				self.isSourceExhausted = def(self) {
					return self.stream.isOver()
				}
			} elif defined self.stream.atEnd {
				self.isSourceExhausted = def(self) {
					return self.stream.atEnd()
				}
			}
			return self
		}
	}

	/**
	 * Returns the codec that is current assigned to the stream. If the stream use the default codec (UTF-8), `null` is
	 * returned.
	 */
	const def getCodec(const self) {
		return self.codec
	}

	/**
	 * Sets the codec for this stream to `codec`. The codec is used for decoding any data that is read from the file,
	 * and for encoding any data that is written.
	 */
	const def setCodec(self, codec) {
		self.codec = codec
	}

	/**
	 * Reads the next character from the stream, and returns it as a string or returns `none` if no more character is
	 * available on the stream. Data is read until a valid character is decoded or if the end of stream is detected.
	 */
	const def readChar(self) {
		if self.charPos == self.charBuffer.size() {
			if not self.decode() {
				return none
			}
		}
		return self.charBuffer[self.charPos++]
	}

	/**
	 * Reads a word from the stream, and returns it as a string or returns `none` if no more character is available on
	 * the stream. Words are separated by whitespace (i.e., all characters for which {isSpace} returns `true`). Leading
	 * whitespace are skipped.
	 */
	const def readWord(self) {
		let word = ''
		while true {
			if self.charPos == self.charBuffer.size() {
				if not self.decode() {
					return word.isEmpty() ? none : word
				}
			}
			let char = self.charBuffer[self.charPos++]
			if char.isSpace() {
				if not word.isEmpty() {
					return word
				}
			} else {
				word += char
			}
		}
	}

	/**
	 * Reads data from the stream until `delim` is found and returns it as a string or returns `none` if no more
	 * character is available on the stream. The delimiter is consumed but is not included in the returned string. Data
	 * is read until the delimiter is read or if the end of stream is detected.
	 */
	const def readUntil(self, delim) {
		let index = self.charBuffer.indexOf(delim, self.charPos)
		if defined index {
			let text = self.charBuffer[self.charPos...index]
			self.charPos = index + delim.size()
			return text
		}
		let text = self.charBuffer.substring(self.charPos)
		self.charPos = self.charBuffer.size()
		while self.decode() {
			index = self.charBuffer.indexOf(delim)
			if defined index {
				text += self.charBuffer[0...index]
				self.charPos = index + delim.size()
				return text
			}
			self.charPos = self.charBuffer.size()
		}
		return text.isEmpty() ? none : text
	}

	/**
	 * Reads the next line from the stream, and returns it as a string or returns `none` if no more character is
	 * available on the stream. Data is read until a `'\n'` character is read or if the end of stream is detected.
	 */
	const def readLine(self) {
		let index = self.charBuffer.indexOf('\n', self.charPos)
		if defined index {
			let line = self.charBuffer[self.charPos...index]
			self.charPos = index + 1
			return line
		}
		let line = self.charBuffer.substring(self.charPos)
		self.charPos = self.charBuffer.size()
		while self.decode() {
			index = self.charBuffer.indexOf('\n')
			if defined index {
				line += self.charBuffer[0...index]
				self.charPos = index + 1
				return line
			}
			self.charPos = self.charBuffer.size()
		}
		return line.isEmpty() ? none : line
	}

	/**
	 * Returns an iterator on each remaining lines of the stream.
	 */
	const def readLines(self) {
		while not self.isEmpty() {
			yield self.readLine()
		}
	}

	/**
	 * Reads all remaining data from the stream, and returns it as a string or returns `none` if no more character is
	 * available on the stream.
	 */
	const def read(self) {
		if self.charPos == self.charBuffer.size() {
			if not self.decode() {
				return none
			}
		}
		let text = self.charBuffer.substring(self.charPos)
		self.charPos = self.charBuffer.size()
		while self.decode() {
			text += self.charBuffer
			self.charPos = self.charBuffer.size()
		}
		return text
	}

	/**
	 * Writes the content of `data` to the stream.
	 * 
	 * The `write` method of the underlying object is used to write the data.
	 */
	const def write(self, data) {
		let pos = 0
		let (status, encoded) = self.codec.encode(data.toString(), pos)
		switch status {
		case is Codec.Status.Success:
			return self.stream.write(encoded)
		case is Codec.Status.NeedMoreInput:
			return self.stream.write(encoded)
		case is Codec.Status.InvalidSequence:
			self.stream.write(encoded)
			raise Exception.InvalidByteSequence(self.codec.getEncoding(), pos)
		}
	}

	/**
	 * Reads a word from the stream and stores it in `data`, then returns a reference to the stream. Words are separated
	 * by whitespace (i.e., all characters for which {isSpace} returns `true`).
	 * 
	 * Leading whitespace are skipped.
	 */
	const def >>(self, data) {
		data := self.readWord()
		return self
	}

	/**
	 * Writes the string `data` to the stream, and returns a reference to the stream. The string is first encoded using
	 * the assigned codec (the default is UTF-8) before it is written to the stream.
	 */
	const def <<(self, data) {
		self.write(data)
		return self
	}

	/**
	 * Returns `true` if the stream has no more data to read; otherwise returns `false`.
	 * 
	 * The underlying stream may be checked with one of those methods in the following order: `isEmpty`, `isOver` or
	 * `atEnd`. If none of these methods are defined, `false` is returned.
	 */
	const def isEmpty(const self) {
		if self.bytePos < self.byteBuffer.size() {
			return false
		}
		if self.charPos < self.charBuffer.size() {
			return false
		}
		return self.isSourceExhausted()
	}

	/**
	 * Refill the internal read byte buffer with some data from the stream. Returns `true` if raw data were added to the
	 * read buffer; otherwise returns `false`.
	 */
	- final const def refill(self) {

		self.byteBuffer.remove(self.bytePos)
		self.bytePos = 0

		let data = self.stream.readSome(4096)
		if not defined data or data.isEmpty() {
			return false
		}

		self.byteBuffer.write(data)
		return true
	}

	/**
	 * Refill the internal read char buffer with some data from the codec. Returns `true` if decoded data were added to
	 * the read buffer; otherwise returns `false`.
	 */
	- final const def decode(self) {

		if self.charPos {
			self.charBuffer = self.charBuffer.substring(self.charPos)
			self.charPos = 0
		}

		while self.charBuffer.isEmpty() {

			if self.bytePos == self.byteBuffer.size() {
				if not self.refill() {
					return false
				}
			}

			let (status, decoded) = self.codec.decode(self.byteBuffer, self.bytePos)
			self.charBuffer += decoded

			switch status {
			case is Codec.Status.Success:
				return not decoded.isEmpty()
			case is Codec.Status.NeedMoreInput:
				if self.isEmpty() {
					return not decoded.isEmpty()
				}
				self.refill()
				if not decoded.isEmpty() {
					return true
				}
				break
			case is Codec.Status.InvalidSequence:
                raise Exception.InvalidByteSequence(self.codec.getEncoding(), self.bytePos)
			}
		}

		return false
	}

	/// Internal underlying stream.
	- final stream = null

	/// Internal text codec.
	- final codec = null

	/// Internal read byte buffer.
	- final byteBuffer = null

	/// Internal read byte buffer offset.
	- final bytePos = 0

	/// Internal read char buffer.
	- final charBuffer = ''

	/// Internal read char buffer offset.
	- final charPos = 0

	/// Internal callback for {@see isEmpty}.
	- final isSourceExhausted = def(self) {
		return false
	}
}

}
