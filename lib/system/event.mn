 * @module
 * This module provides the {System.Event} class which provides a basic event
 * implementation.
 */

load mint.type

package System {
	/**
	 * This class provides a basic event implementation that can only be set or reset.
	 * 
	 * > This type is not copyable
	 */
	@class Event {
		/**
		 * Creates a new event. The created event is not set.
		 * 
		 * If no event can be created, `none` is returned.
		 */
		const def new(self) {
		    if self.d_ptr = System.Event.g_lib.call('mint_event_create') {
				self.d_ptr.delete = def [g_lib = System.Event.g_lib](self) {
					g_lib.call('mint_event_delete', self)
				}
		    	return self
		    }
		}

		/**
		 * Disable object copy.
		 */
		- const clone

		/**
		 * Returns `true` if the event is set; otherwise returns `false`.
		 */
		const def isSet(const self) {
			return System.Event.g_lib.call('mint_event_is_set', self.d_ptr)
		}

		/**
		 * Sets the event.
		 */
		const def set(self) {
			return System.Event.g_lib.call('mint_event_set', self.d_ptr)
		}

		/**
		 * Resets the event.
		 */
		const def clear(self) {
			System.Event.g_lib.call('mint_event_clear', self.d_ptr)
		}

		/**
		 * Waits until the event is set. If `timeout` is given, the wait stop after
		 * `timeout` milliseconds if the event is still not set.
		 * 
		 * Returns `true` if the event is set; otherwise returns `false` if the
		 * wait timed out.
		 * 
		 * After a call to this method, the event is reset.
		 */
		const def wait(self, timeout = none) {
			return System.Event.g_lib.call('mint_event_wait', self.d_ptr, timeout)
		}

		/**
		 * Returns the handle used by {System.Event}.
		 */
		const def getHandle(const self) {
			return System.Event.g_lib.call('mint_event_get_handle', self.d_ptr)
		}

		/**
		 * Returns the event's poll event as an instance of `mint::poll_event_t`.
		 */
		const def getPollEvent(const self) {
			return self.d_ptr
		}

		/**
		 * Reset the internal event state
		 */
		const def reset(self) {
			self.clear()
		}

		/// Global library handle.
		- @const g_lib = lib('libmint-system')

		/// Object data.
		- final d_ptr = null
	}
}
