load mint.lang
load mint.function
load system.date
load system.directory
load system.filesystem
load exception.system
load runtime.operation

package System {

	/**
	 * This class provides informations about a file in the file system like path,
	 * size, rights, ...
	 */
	@class File {

		/**
		 * This enum is used by the {System.File.permission} function to report the
		 * permissions and ownership of a file. The values may be OR-ed together to
		 * test multiple permissions and ownership values.
		 */
		enum Permission {
			/// The file is readable by the owner of the file.
			ReadOwner	= 0x4000
			/// The file is writable by the owner of the file.
			WriteOwner	= 0x2000
			/// The file is executable by the owner of the file.
			ExecOwner	= 0x1000
			/// The file is readable by the user.
			ReadUser	= 0x0400
			/// The file is writable by the user.
			WriteUser	= 0x0200
			/// The file is executable by the user.
			ExecUser	= 0x0100
			/// The file is readable by the group.
			ReadGroup	= 0x0040
			/// The file is writable by the group.
			WriteGroup	= 0x0020
			/// The file is executable by the group.
			ExecGroup	= 0x0010
			/// The file is readable by anyone.
			ReadOther	= 0x0004
			/// The file is writable by anyone.
			WriteOther	= 0x0002
			/// The file is executable by anyone.
			ExecOther	= 0x0001
		}

		/**
		 * Creates a new instance pointing to the file specified by the given `path`.
		 * 
		 * If `path` is already an instance of {System.File}, this instance
		 * is returned.
		 * 
		 * If `path` provides a `toFile` method, this method is used to create the
		 * returned value; otherwise the variable is used as a string to get the
		 * target file path.
		 */
		const def new(self, path) {
			if typeof path == 'System.File' {
				return path
			}
			if defined path.toFile {
				return path.toFile()
			}
			if defined path {
				self.path = System.File.g_lib.call('mint_directory_to_native_path', path)
				return self
			}
		}

		/**
		 * Returns the base name of the file without the path.
		 */
		const def getBaseName(const self) {
			if self.path.isEmpty() {
				return ''
			}
			var start = self.path.lastIndexOf(System.FileSystem.SeparatorPattern)
			if not defined start {
				start = 0
			} else {
				start++
			}
			var stop = self.path.indexOf('.', start)
			if not defined stop {
				stop = self.path.size()
			}
			return self.path[start...stop]
		}

		/**
		 * Returns the base name of the file without the path including each parts
		 * after a `.` (dot) character before the last suffix.
		 */
		const def getCompleteBaseName(const self) {
			var start = self.path.lastIndexOf(System.FileSystem.SeparatorPattern)
			if not defined start {
				start = 0
			} else {
				start++
			}
			var stop = self.path.lastIndexOf('.')
			if not defined stop or stop < start {
				stop = self.path.size()
			}
			return self.path[start...stop]
		}

		/**
		 * Returns the suffix (extension) of the file.
		 */
		const def getSuffix(const self) {
			var start = self.path.lastIndexOf(System.FileSystem.SeparatorPattern)
			var stop = self.path.size()
			if not defined start {
				start = self.path.lastIndexOf('.')
				if not defined start {
					return ''
				}
				return self.path[start...stop]
			}
			var pos = self.path.lastIndexOf('.')
			if not defined pos or pos < start {
				return ''
			}
			pos++
			return self.path[pos...stop]
		}

		/**
		 * Returns the suffix (extension) of the file including each parts
		 * after a `.` (dot) character after the base name.
		 */
		const def getCompleteSuffix(const self) {
			var start = self.path.lastIndexOf(System.FileSystem.SeparatorPattern)
			var stop = self.path.size()
			if defined start {
				start = self.path.indexOf('.', start)
				if not defined start {
					return ''
				}
				start++
				return self.path[start...stop]
			}
			start = self.path.indexOf('.')
			if not defined start {
				return ''
			}
			start++
			return self.path[start...stop]
		}

		/**
		 * Returns the name of the file, excluding the path.
		 */
		const def getName(const self) {
			if isDefined(var index = self.path.lastIndexOf(System.FileSystem.SeparatorPattern)) {
				return self.path[(index + 1)...self.path.size()]
			}
			return self.path
		}

		/**
		 * Returns the file name, including the path (which may be absolute or relative).
		 */
		const def getPath(const self) {
			return self.path
		}

		/**
		 * Returns an absolute path including the file name.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def getAbsolutePath(const self) {
			let (path, errno) = System.File.g_lib.call('mint_directory_absolute_path', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return path
		}

		/**
		 * Returns a canonical path including the file name.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def getCanonicalPath(const self) {
			let (path, errno) = System.File.g_lib.call('mint_directory_canonical_path', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return path
		}

		/**
		 * Returns the absolute path to the file or directory a symbolic link
		 * points to, or the object's path if it is not a symbolic link.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def readSymlink(const self) {
			let (path, errno) = System.File.g_lib.call('mint_file_read_symlink', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return path
		}

		/**
		 * Returns the path of the object's parent directory as a {System.Directory}
		 * object.
		 */
		const def getDirectory(const self) {
			if self.isDirectory() {
				return System.Directory(self.path)
			}
			if isDefined(index = self.path.lastIndexOf(System.FileSystem.SeparatorPattern)) {
				return System.Directory(self.path[0...index])
			}
			return System.Directory.current()
		}

		/**
		 * Returns the date when the file was created / born.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def getBirthDate(const self) {
			let (date, errno) = System.File.g_lib.call('mint_file_birth_time', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return System.Date.fromMillisecondsSinceEpoch(date)
		}

		/**
		 * Returns the date when the file was last read (accessed).
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def getLastReadDate(const self) {
			let (date, errno) = System.File.g_lib.call('mint_file_last_read_time', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return System.Date.fromMillisecondsSinceEpoch(date)
		}

		/**
		 * Returns the date when the file was last write (modified).
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def getLastWriteDate(const self) {
			let (date, errno) = System.File.g_lib.call('mint_file_last_write_time', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return System.Date.fromMillisecondsSinceEpoch(date)
		}

		/**
		 * Returns `true` if the file exists; otherwise returns `false`.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def exists(const self) {
			let (result, errno) = System.File.g_lib.call('mint_file_exists', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return result
		}

		/**
		 * Returns the file size in bytes. If the file does not exist or cannot
		 * be fetched, `0` is returned.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def size(const self) {
			let (result, errno) = System.File.g_lib.call('mint_file_size', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return result
		}

		/**
		 * Converts the file's path to an absolute path if it is not already in that form.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def makeAbsolute(self) {
			self.path = self.getAbsolutePath()
		}

		/**
		 * Converts the file's path to a canonical path if it is not already in that form.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def makeCanonical(self) {
			self.path = self.getCanonicalPath()
		}

		/**
		 * Returns `true` if the file path is absolute, otherwise returns `false` (i.e. the path is relative).
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def isAbsolute(const self) {
			return self.path == self.getAbsolutePath()
		}

		/**
		 * Returns `true` if the file path is canonical; otherwise returns `false`.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def isCanonical(const self) {
			return self.path == self.getCanonicalPath()
		}

		/**
		 * Returns `true` if the file path is relative, otherwise returns `false` (i.e. the path is absolute).
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def isRelative(const self) {
			return self.path != self.getAbsolutePath()
		}

		/**
		 * Returns `true` if this object points to a regular file or to a symbolic
		 * link to a regular file. Returns `false` if the object points to something
		 * which isn't a file, such as a directory.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def isRegularFile(const self) {
			let (result, errno) = System.File.g_lib.call('mint_file_is_regular_file', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return result
		}

		/**
		 * Returns `true` if this object points to a directory or to a symbolic
		 * link to a directory; otherwise returns `false`.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def isDirectory(const self) {
			let (result, errno) = System.File.g_lib.call('mint_file_is_directory', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return result
		}

		/**
		 * Returns `true` if this object points to a symbolic link; otherwise returns `false`.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def isSymlink(const self) {
			let (result, errno) = System.File.g_lib.call('mint_file_is_symlink', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return result
		}

		/**
		 * Returns `true` if this object points to a bundle or to a symbolic link
		 * to a bundle on macOS and iOS; otherwise returns `false`.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def isBundle(const self) {
			let (result, errno) = System.File.g_lib.call('mint_file_is_bundle', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return result
		}

		/**
		 * Returns `true` if the object points to a directory or to a symbolic link
		 * to a directory which is the root directory; otherwise returns `false`.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def isRoot(const self) {
			let (result, errno) = System.File.g_lib.call('mint_file_is_root', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return result
		}

		/**
		 * Returns `true` if the user can read the file; otherwise returns `false`.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def isReadable(const self) {
			let (result, errno) = System.File.g_lib.call('mint_file_is_readable', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return result
		}

		/**
		 * Returns `true` if the user can write to the file; otherwise returns `false`.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def isWritable(const self) {
			let (result, errno) = System.File.g_lib.call('mint_file_is_writable', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return result
		}

		/**
		 * Returns `true` if the file is executable; otherwise returns `false`.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def isExecutable(const self) {
			let (result, errno) = System.File.g_lib.call('mint_file_is_executable', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return result
		}

		/**
		 * Returns `true` if this is a hidden file; otherwise returns `false`.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def isHidden(const self) {
			let (result, errno) = System.File.g_lib.call('mint_file_is_hidden', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return result
		}

		/**
		 * Returns the owner of the file. On systems where files do not have owners,
		 * or if an error occurs, an empty string is returned.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def getOwner(const self) {
			let (name, errno) = System.File.g_lib.call('mint_file_owner', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return name
		}

		/**
		 * Returns the id of the owner of the file.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def getOwnerId(const self) {
			let (id, errno) = System.File.g_lib.call('mint_file_owner_id', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return id
		}

		/**
		 * Returns the group of the file. On systems where files do not have groups,
		 * or if an error occurs, an empty string is returned.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def getGroup(const self) {
			let (name, errno) = System.File.g_lib.call('mint_file_group', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return name
		}

		/**
		 * Returns the id of the group the file belongs to.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def getGroupId(const self) {
			let (id, errno) = System.File.g_lib.call('mint_file_group_id', self.path)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return id
		}

		/**
		 * Tests for file permissions. The permissions argument can be several
		 * flags of type {System.File.Permission} OR-ed together to check for
		 * permission combinations.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def permission(const self, permissions) {
			let (result, errno) = System.File.g_lib.call('mint_file_permission', self.path, permissions)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return result
		}

		// TODO : getters and setters on permissions

		/**
		 * Creates a symbolic link named `target` that points to the file 
		 * currently specified by this object.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def createSymlink(self, target) {
			if var errno = System.File.g_lib.call('mint_file_create_symlink', self.path, target) {
				raise Exception.SystemError(errno, self)
			}
		}

		/**
		 * Creates a copy named `target` of the the file currently specified by
		 * this object.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def copy(self, target) {
			if var errno = System.File.g_lib.call('mint_file_copy', self.path, target) {
				raise Exception.SystemError(errno, self)
			}
		}

		/**
		 * Renames the file currently specified by this object to `name`.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def rename(self, name) {
			if var errno = System.File.g_lib.call('mint_file_rename', self.path, name) {
				raise Exception.SystemError(errno, self)
			}
		}

		/**
		 * Removes the file currently specified by this object.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def remove(self) {
			if var errno = System.File.g_lib.call('mint_file_remove', self.path) {
				raise Exception.SystemError(errno, self)
			}
		}

		/**
		 * Opens the file using `mode`, returning an instance of {System.FileStream} if successful; otherwise `none`.
		 * 
		 * The `mode` parameter can be one of the following strings :
		 * | String | Meaning                                                                                                                                                                                      |
		 * |--------|----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------|
		 * | `'r+'` | Open a file for update (both for input and output). The file must exist.                                                                                                                     |
		 * | `'r' ` | Open file for input operations. The file must exist.                                                                                                                                         |
		 * | `'w' ` | Create an empty file for output operations. If a file with the same name already exists, its contents are discarded and the file is treated as a new empty file.                             |
		 * | `'w+'` | Create an empty file and open it for update (both for input and output). If a file with the same name already exists its contents are discarded and the file is treated as a new empty file. |
		 * | `'a' ` | Open file for output at the end of a file. Output operations always write data at the end of the file, expanding it. The file is created if it does not exist.                               |
		 * | `'a+'` | Open a file for update (both for input and output) with all output operations writing data at the end of the file. The file is created if it does not exist.                                 |
		 * 
		 * The `'b'` character can be added at the second position of any string to open the file in binary mode.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def open(self, mode = 'r') {
			try {
				let stream = System.FileStream()
				if stream.open(self.getAbsolutePath(), mode) {
					return stream
				}
			} catch error {
				if typeof error === 'Exception.SystemError' {
					raise in Exception.SystemError(error.getErrno(), self)
				} else {
					raise
				}
			}
		}

		/**
		 * Opens the file using `mode`, returning an instance of {System.AsyncFileStream} bound to `scheduler` if
		 * successful; otherwise `none`. The `scheduler` parameter an instance of {Runtime.Scheduler} used to schedule
		 * asynchronous operations on the file.
		 * 
		 * The `mode` parameter can be one of the following strings :
		 * | String | Meaning                                                                                                                                                                                      |
		 * |--------|----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------|
		 * | `'r+'` | Open a file for update (both for input and output). The file must exist.                                                                                                                     |
		 * | `'r' ` | Open file for input operations. The file must exist.                                                                                                                                         |
		 * | `'w' ` | Create an empty file for output operations. If a file with the same name already exists, its contents are discarded and the file is treated as a new empty file.                             |
		 * | `'w+'` | Create an empty file and open it for update (both for input and output). If a file with the same name already exists its contents are discarded and the file is treated as a new empty file. |
		 * | `'a' ` | Open file for output at the end of a file. Output operations always write data at the end of the file, expanding it. The file is created if it does not exist.                               |
		 * | `'a+'` | Open a file for update (both for input and output) with all output operations writing data at the end of the file. The file is created if it does not exist.                                 |
		 * 
		 * The `'b'` character can be added at the second position of any string to open the file in binary mode.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def openAsync(self, scheduler, mode = 'r') {
			try {
				let stream = System.AsyncFileStream(scheduler)
				if stream.open(self.getAbsolutePath(), mode) {
					return stream
				}
			} catch error {
				if typeof error === 'Exception.SystemError' {
					raise in Exception.SystemError(error.getErrno(), self)
				} else {
					raise
				}
			}
		}

		/// Global library handle.
		- @const g_lib = lib('libmint-system')

		/// Internal file path.
		- final path = ''
	}

	/**
	 * This class provides a stream interface to read and write data to a file.
	 * 
	 * > This type is not copyable
	 */
	@class FileStream {

		/**
		 * Destroy the instance and close the file handle if it is open.
		 */
		const def delete(self) {
			if self.isOpen() {
				self.close()
			}
		}

		/**
		 * Disable object copy.
		 */
		- const clone

		/**
		 * Opens the file pointed by `path` using `mode`, returning `true` if successful; otherwise `false`.
		 * 
		 * The `mode` parameter can be one of the following strings :
		 * | String | Meaning                                                                                                                                                                                      |
		 * |--------|----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------|
		 * | `'r+'` | Open a file for update (both for input and output). The file must exist.                                                                                                                     |
		 * | `'r' ` | Open file for input operations. The file must exist.                                                                                                                                         |
		 * | `'w' ` | Create an empty file for output operations. If a file with the same name already exists, its contents are discarded and the file is treated as a new empty file.                             |
		 * | `'w+'` | Create an empty file and open it for update (both for input and output). If a file with the same name already exists its contents are discarded and the file is treated as a new empty file. |
		 * | `'a' ` | Open file for output at the end of a file. Output operations always write data at the end of the file, expanding it. The file is created if it does not exist.                               |
		 * | `'a+'` | Open a file for update (both for input and output) with all output operations writing data at the end of the file. The file is created if it does not exist.                                 |
		 * 
		 * The `'b'` character can be added at the second position of any string to open the file in binary mode.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def open(self, path, mode = 'r') {
			if self.d_ptr is null {
				let (file, errno) = System.FileStream.g_lib.call('mint_file_open', path, mode)
				if errno {
					raise Exception.SystemError(errno, self)
				}
				if self.d_ptr = file {
					return true
				}
			}
			return false
		}

		/**
		 * Flushes buffered modifications and closes the file.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def close(self) {
			if not self.isOpen() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBADF, self)
			}
			var errno = System.FileStream.g_lib.call('mint_file_close', self.d_ptr)
			self.d_ptr = null
			if errno {
				raise Exception.SystemError(errno, self)
			}
		}

		/**
		 * Returns `true` if the file is open; otherwise returns `false`.
		 */
		const def isOpen(const self) {
			return self.d_ptr != null
		}

		/**
		 * Returns `true` if the end of the file has been reached; otherwise returns `false`.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def atEnd(const self) {
			if not self.isOpen() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBADF, self)
			}
			return System.FileStream.g_lib.call('mint_file_at_end', self.d_ptr)
		}

		/**
		 * Returns the position that data is written to or read from.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def tell(const self) {
			if not self.isOpen() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBADF, self)
			}
			let (errno, pos) = System.FileStream.g_lib.call('mint_file_tell', self.d_ptr)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return pos
		}

		/**
		 * Sets the position that data is written to or read from to `pos`.
		 * 
		 * If `pos` is in the range `0...self.size()`, the position is moved
		 * relatively from the begin of the file.
		 * 
		 * If `pos` is in the range `-1..-self.size()`, the position is moved
		 * relatively from the end of the file.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def seek(self, pos) {
			if not self.isOpen() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBADF, self)
			}
			if var errno = System.FileStream.g_lib.call('mint_file_seek', self.d_ptr, pos) {
				raise Exception.SystemError(errno, self)
			}
		}

		/**
		 * Sets the position that data is written to or read from to the beginning
		 * of the file.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def rewind(self) {
			if not self.isOpen() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBADF, self)
			}
			if var errno = System.FileStream.g_lib.call('mint_file_seek', self.d_ptr, 0) {
				raise Exception.SystemError(errno, self)
			}
		}

		/**
		 * Returns the file's handle as an instance of `mint::handle_t` or `none` if the file has no handle.
		 */
		const def getHandle(const self) {
			if self.isOpen() {
				return System.FileStream.g_lib.call('mint_file_get_handle', self.d_ptr)
			}
		}

		/**
		 * Returns at most `count` bytes of data from the file as an instance of {Serializer.DataStream} or `none`
		 * if no data is available.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def readSome(self, count) {
			if not self.isOpen() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBADF, self)
			}
			let stream = Serializer.DataStream()
			if let errno = System.FileStream.g_lib.call('mint_file_read_some', self.d_ptr, stream.to_std_vector_uint8_t(), count) {
				raise Exception.SystemError(errno, self)
			}
			return stream
		}

		/**
		 * Returns all remaining data from the file as an instance of {Serializer.DataStream} or `none` if no data is
		 * available.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def read(self) {
			if not self.isOpen() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBADF, self)
			}
			let stream = Serializer.DataStream()
			if let errno = System.FileStream.g_lib.call('mint_file_read', self.d_ptr, stream.to_std_vector_uint8_t()) {
				raise Exception.SystemError(errno, self)
			}
			return stream
		}

		/**
		 * Writes the content of `data` to the file. The `data` parameter must be an instance of
		 * {Serializer.DataStream}. Returns the number of bytes that were actually written.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def write(self, data) {
			if not self.isOpen() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBADF, self)
			}
			let stream = Serializer.DataStream(data)
			let (errno, written) = System.FileStream.g_lib.call('mint_file_write', self.d_ptr, stream.to_std_vector_uint8_t())
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return written
		}

		/**
		 * Flushes any buffered data to the file.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def flush(self) {
			if not self.isOpen() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBADF, self)
			}
			if errno = System.FileStream.g_lib.call('mint_file_flush', self.d_ptr) {
				raise Exception.SystemError(errno, self)
			}
		}

		/// Global library handle.
		- @const g_lib = lib('libmint-system')

		/// Object data.
		- final d_ptr = null
	}

	/**
	 * Creates a new {System.FileStream} to represent the file with the specified `path`.
	 * The file is then opened with the given `mode`. Returns the file on success;
	 * otherwise returns `null`.
	 */
	@def open(path, mode = 'r') {
		var file = System.File(path)
		try {
			if let stream = file.open(mode) {
				return stream
			}
		} catch error {
			return null
		}
		return null
	}

	/**
	 * This class provides a stream interface to read and write data to a file asynchronously.
	 * 
	 * > This type is not copyable
	 */
	@class AsyncFileStream {
		/**
		 * Scheduler operation used to read some data from a file asynchronously.
		 *
		 * Instances of this operation are created by {System.AsyncFileStream.readWord}.
		 *
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		class ReadSomeOperation : Runtime.Operation {
			const def new(self, stream, count) {
				self.stream = stream
				self.count = count
				self.buffer = Serializer.DataStream()
				return self
			}

			# override const def setup(self, scheduler) {
				return System.AsyncFileStream.WriteOperation.g_lib.call('mint_file_read_some_async', self, scheduler.to_async_runtime(), self.stream.getHandle(), self.buffer.to_std_vector_uint8_t(), self.count)
			}

			/**
			 * Checks for the operation completion.
			 */
			override const def check(self, result) {
				if let errno = result {
					raise Exception.SystemError(errno, self.stream)
				}
				return true
			}

			/**
			 * Returns the word that was actually read.
			 */
			override const def get(self) {
				return self.buffer
			}

			/// Global library handle.
			- @const g_lib = lib('libmint-system')

			/// Internal stream.
			- final stream = null

			/// Internal byte count.
			- final count = 0

			/// Internal read buffer.
			- final buffer = null
		}

		/**
		 * Scheduler operation used to read all the remaining data from a file asynchronously.
		 *
		 * Instances of this operation are created by {System.AsyncFileStream.readWord}.
		 *
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		class ReadOperation : Runtime.Operation {
			const def new(self, stream) {
				self.stream = stream
				self.buffer = Serializer.DataStream()
				return self
			}

			# override const def setup(self, scheduler) {
				return System.AsyncFileStream.ReadOperation.g_lib.call('mint_file_read_async', self, scheduler.to_async_runtime(), self.stream.getHandle(), self.buffer.to_std_vector_uint8_t())
			}

			/**
			 * Checks for the operation completion.
			 */
			override const def check(self, result) {
				if let errno = result {
					raise Exception.SystemError(errno, self.stream)
				}
				return true
			}

			/**
			 * Returns the word that was actually read.
			 */
			override const def get(self) {
				return self.buffer
			}

			/// Global library handle.
			- @const g_lib = lib('libmint-system')

			/// Internal stream.
			- final stream = null

			/// Internal read buffer.
			- final buffer = null
		}

		/**
		 * Scheduler operation used to write data into a file asynchronously.
		 *
		 * Instances of this operation are created by {System.AsyncFileStream.write}.
		 *
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		class WriteOperation : Runtime.Operation {
			const def new(self, stream, buffer) {
				self.stream = stream
				self.buffer = Serializer.DataStream(buffer)
				return self
			}

			# override const def setup(self, scheduler) {
				return System.AsyncFileStream.WriteOperation.g_lib.call('mint_file_write_async', self, scheduler.to_async_runtime(), self.stream.getHandle(), self.buffer.to_std_vector_uint8_t())
			}

			/**
			 * Checks for the operation completion.
			 */
			override const def check(self, result) {
				let (errno, written) = result
				if errno {
					raise Exception.SystemError(errno, self.stream)
				}
				self.written = written
				return true
			}

			/**
			 * Returns the number of bytes that were actually written.
			 */
			override const def get(self) {
				return self.written
			}

			/// Global library handle.
			- @const g_lib = lib('libmint-system')

			/// Internal stream.
			- final stream = null

			/// Internal write buffer.
			- final buffer = null

			/// Internal written byte count.
			- final written = none
		}

		/**
		 * Scheduler operation used to flush buffered file's modifications asynchronously.
		 *
		 * Instances of this operation are created by {System.AsyncFileStream.flush}.
		 *
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		class FlushOperation : Runtime.Operation {
			const def new(self, stream) {
				self.stream = stream
				return self
			}

			# override const def setup(self, scheduler) {
				return System.AsyncFileStream.FlushOperation.g_lib.call('mint_file_flush_async', self, scheduler.to_async_runtime(), self.stream.getHandle())
			}

			/**
			 * Checks for the operation completion.
			 */
			override const def check(self, result) {
				if let errno = result {
					raise Exception.SystemError(errno, self.stream)
				}
				return true
			}

			/// Global library handle.
			- @const g_lib = lib('libmint-system')

			/// Internal stream.
			- final stream = null
		}

		/**
		 * Creates a new file stream bound to `scheduler`. The `scheduler` parameter an instance of {Runtime.Scheduler}
		 * used to schedule asynchronous operations on the file.
		 */
		const def new(self, scheduler) {
			self.scheduler = scheduler
			return self
		}

		/**
		 * Destroy the instance and close the file handle if it is open.
		 */
		const def delete(self) {
			if self.isOpen() {
				self.close()
			}
		}

		/**
		 * Disable object copy.
		 */
		- const clone

		/**
		 * Opens the file pointed by `path` using `mode`, returning `true` if successful; otherwise `false`.
		 * 
		 * The `mode` parameter can be one of the following strings :
		 * | String | Meaning                                                                                                                                                                                      |
		 * |--------|----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------|
		 * | `'r+'` | Open a file for update (both for input and output). The file must exist.                                                                                                                     |
		 * | `'r' ` | Open file for input operations. The file must exist.                                                                                                                                         |
		 * | `'w' ` | Create an empty file for output operations. If a file with the same name already exists, its contents are discarded and the file is treated as a new empty file.                             |
		 * | `'w+'` | Create an empty file and open it for update (both for input and output). If a file with the same name already exists its contents are discarded and the file is treated as a new empty file. |
		 * | `'a' ` | Open file for output at the end of a file. Output operations always write data at the end of the file, expanding it. The file is created if it does not exist.                               |
		 * | `'a+'` | Open a file for update (both for input and output) with all output operations writing data at the end of the file. The file is created if it does not exist.                                 |
		 * 
		 * The `'b'` character can be added at the second position of any string to open the file in binary mode.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def open(self, path, mode = 'r') {
			if self.d_ptr is null {
				let (file, errno) = System.AsyncFileStream.g_lib.call('mint_file_open_async', path, mode)
				if errno {
					raise Exception.SystemError(errno, self)
				}
				if self.d_ptr = file {
					self.scheduler.watch(self)
					return true
				}
			}
			return false
		}

		/**
		 * Flushes buffered modifications and closes the file.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def close(self) {
			if not self.isOpen() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBADF, self)
			}
			var errno = System.AsyncFileStream.g_lib.call('mint_file_close_async', self.d_ptr)
			self.d_ptr = null
			if errno {
				raise Exception.SystemError(errno, self)
			}
		}

		/**
		 * Returns `true` if the file is open; otherwise returns `false`.
		 */
		const def isOpen(const self) {
			return self.d_ptr != null
		}

		/**
		 * Returns `true` if the end of the file has been reached; otherwise returns `false`.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def atEnd(const self) {
			if not self.isOpen() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBADF, self)
			}
			return System.AsyncFileStream.g_lib.call('mint_file_at_end_async', self.d_ptr)
		}

		/**
		 * Returns the position that data is written to or read from.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def tell(const self) {
			if not self.isOpen() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBADF, self)
			}
			let (errno, pos) = System.AsyncFileStream.g_lib.call('mint_file_tell_async', self.d_ptr)
			if errno {
				raise Exception.SystemError(errno, self)
			}
			return pos
		}

		/**
		 * Sets the position that data is written to or read from to `pos`.
		 * 
		 * If `pos` is in the range `0...self.size()`, the position is moved
		 * relatively from the begin of the file.
		 * 
		 * If `pos` is in the range `-1..-self.size()`, the position is moved
		 * relatively from the end of the file.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def seek(self, pos) {
			if not self.isOpen() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBADF, self)
			}
			if var errno = System.AsyncFileStream.g_lib.call('mint_file_seek_async', self.d_ptr, pos) {
				raise Exception.SystemError(errno, self)
			}
		}

		/**
		 * Sets the position that data is written to or read from to the beginning
		 * of the file.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const def rewind(self) {
			if not self.isOpen() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBADF, self)
			}
			if var errno = System.AsyncFileStream.g_lib.call('mint_file_seek_async', self.d_ptr, 0) {
				raise Exception.SystemError(errno, self)
			}
		}

		/**
		 * Returns the scheduler associated with the file.
		 */
		const def getScheduler(const self) {
			return self.scheduler
		}

		/**
		 * Returns the file's handle as an instance of `mint::handle_t` or `none` if the file has no handle.
		 */
		const def getHandle(const self) {
			if self.isOpen() {
				return self.d_ptr
			}
		}

		/**
		 * Returns at most `count` bytes of data from the file as an instance of {Serializer.DataStream} or `none`
		 * if no data is available.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const async def readSome(self, count) {
			if not self.isOpen() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBADF, self)
			}
			return await self.scheduler.suspend(System.AsyncFileStream.ReadSomeOperation(self, count))
		}

		/**
		 * Returns all remaining data from the file as an instance of {Serializer.DataStream} or `none` if no data is
		 * available.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const async def read(self) {
			if not self.isOpen() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBADF, self)
			}
			return await self.scheduler.suspend(System.AsyncFileStream.ReadOperation(self))
		}

		/**
		 * Writes the content of `data` to the file. The `data` parameter must be an instance of
		 * {Serializer.DataStream}. Returns the number of bytes that were actually written.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const async def write(self, data) {
			if not self.isOpen() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBADF, self)
			}
			return await self.scheduler.suspend(System.AsyncFileStream.WriteOperation(self, self.codec, data))
		}

		/**
		 * Flushes any buffered data to the file.
		 * 
		 * An instance of {Exception.SystemError} is raised on error.
		 */
		const async def flush(self) {
			if not self.isOpen() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBADF, self)
			}
			await self.scheduler.suspend(System.AsyncFileStream.FlushOperation(self))
		}

		/// Global library handle.
		- @const g_lib = lib('libmint-system')

		/// Internal scheduler.
		- final scheduler = null

		/// Internal file codec.
		- final codec = null

		/// Object data.
		- final d_ptr = null
	}

	/**
	 * Creates a new {System.AsyncFileStream} to represent the file with the specified `path`.
	 * The file is then opened with the given `mode`. Returns the file on success;
	 * otherwise returns `null`.
	 */
	@def openAsync(scheduler, path, mode = 'r') {
		var file = System.File(path)
		try {
			if let stream = file.openAsync(scheduler, mode) {
				return stream
			}
		} catch error {
			return null
		}
		return null
	}

}
