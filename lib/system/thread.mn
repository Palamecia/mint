load mint.function
load exception.system

package System {

	/**
	 * This class protect an object, data structure or section of code so that
	 * only one thread can access it at a time. The purpose of this class is to
	 * be used with instances of {System.Thread} to synchronize two or more
	 * threads.
	 * 
	 * The {LockGuard} class can be used to ensure that the mutex is correctly
	 * locked and unlocked by a section of code.
	 */
	@class Mutex {
		/**
		 * This enum describe the behavior of the mutex.
		 */
		enum Kind {
			/**
			 * Normal mutex must be unlocked before an other lock is performed.
			 * If the thread try to re-lock an already locked normal mutex, the
			 * mutex will deadlock.
			 */
			Normal
			/**
			 * Recursive mutex can be locked recursively by the same thread but
			 * must be unlocked the same amount of times to allow other threads
			 * to lock it.
			 */
			Recursive
		}

		/**
		 * Creates a new mutex. The `kind` parameter describe the behavior of
		 * the mutex an must be an instance of {System.Mutex.Kind}.
		 */
		const def new(self, kind = System.Mutex.Kind.Normal) {
			self.d_ptr = System.Mutex.g_lib.call('mint_mutex_create', kind)
			self.d_ptr.delete = def [g_lib = System.Mutex.g_lib] (self) {
				g_lib.call('mint_mutex_delete', self)
			}
			return self
		}

		/**
		 * Locks the mutex. If another thread has locked the mutex then this
		 * call will block until that thread has unlocked it.
		 * 
		 * If the mutex use the {System.Mutex.Kind.Recursive} behavior, this
		 * method can be called multiple times in the same thread; otherwise
		 * multiple calls will cause a dead-lock.
		 */
		const def lock(self) {
			System.Mutex.g_lib.call('mint_mutex_lock', self.d_ptr)
		}

		/**
		 * Unlocks the mutex. Attempting to unlock a mutex in a different thread
		 * to the one that locked it results in an error. Unlocking a mutex that
		 * is not locked results in undefined behavior.
		 */
		const def unlock(self) {
			System.Mutex.g_lib.call('mint_mutex_unlock', self.d_ptr)
		}

		/**
		 * Attempts to {@see lock} the mutex. This function returns `true` if
		 * the lock was obtained; otherwise it returns `false`.
		 */
		const def tryLock(self) {
			return System.Mutex.g_lib.call('mint_mutex_try_lock', self.d_ptr)
		}

		/**
		 * Returns the behavior of this mutex as a value from {System.Mutex.Kind}.
		 */
		const def getKind(const self) {
			return System.Mutex.g_lib.call('mint_mutex_get_kind', self.d_ptr)
		}

		/// Global library handle.
		- @const g_lib: library = lib('libmint-system')

		/// Object data.
		- final d_ptr = null
	}

	/**
	 * This class manages one thread of control within the script. A thread can
	 * be associated with any function or object method that will be executed
	 * alongside the other threads by calling the {@see start} method. Once
	 * started, the thread will continue until the end of the function.
	 * 
	 * > This type is not copyable
	 */
	@class Thread {
		/**
		 * Creates a new thread that will execute the `func` function.
		 */
		const def new(self, %func) {
			self.function = func
			return self
		}

		/**
		 * Creates a new thread that will execute the `member` method of `object`.
		 */
		const def new(self, object, %member) {
			self.object = object
			self.function = member
			return self
		}

		/**
		 * Waite the end of the called function before object destruction.
		 */
		const def delete(self) {
			if self.isRunning() and self.id != System.Thread.g_lib.call('mint_thread_current_id') {
				self.join()
			}
		}

		/**
		 * Disable object copy.
		 */
		- const clone

		/**
		 * Returns an instance of {System.Thread} for the current thread.
		 */
		@const def current() {
			var thread = System.Thread(none)
			thread.id = System.Thread.g_lib.call('mint_thread_current_id')
			return thread
		}

		/**
		 * Starts the associated function in a new thread. The parameters passed
		 * to this method are forwarded to the called function.
		 *
		 * Raises {Exception.SystemError} with:
		 *  - `EINVAL` if no function is associated with this thread,
		 *  - `EBUSY` if the thread is already running a joinable thread,
		 *  - the system error code if the thread could not be started.
		 */
		const def start(self, ...) {

			if not defined self.function {
				raise Exception.SystemError(Exception.SystemError.Errno.EINVAL, self)
			}

			if self.isJoinable() {
				raise Exception.SystemError(Exception.SystemError.Errno.EBUSY, self)
			}

			let (threadId, errno) = defined self.object \
				? System.Thread.g_lib.call('mint_thread_start_member', self.object, self.function, va_args) \
				: System.Thread.g_lib.call('mint_thread_start', self.function, va_args)

			if errno {
				raise Exception.SystemError(errno, self)
			}
			self.id = threadId
			return self
		}

		/**
		 * Returns the thread-id of the object thread or `none` if not started.
		 */
		const def getId(const self) {
			return self.id
		}

		/**
		 * Returns `true` if the thread is running; otherwise returns `false`.
		 */
		const def isRunning(const self) {
			if defined self.id {
				return System.Thread.g_lib.call('mint_thread_is_running', self.id)
			}
			return false
		}

		/**
		 * Returns `true` if the thread is joinable; otherwise returns `false`.
		 */
		const def isJoinable(const self) {
			if defined self.id {
				return System.Thread.g_lib.call('mint_thread_is_joinable', self.id)
			}
			return false
		}

		/**
		 * Waite for the thread to finish.
		 * 
		 * Raises {Exception.SystemError} on error.
		 */
		const def join(self) {
			if defined self.id {
				if let errno = System.Thread.g_lib.call('mint_thread_join', self.id) {
					raise Exception.SystemError(errno, self)
				}
			}
		}

		/// Global library handle.
		- @const g_lib: library = lib('libmint-system')

		/// Internal thread id.
		- final id = none

		/// Internal associated object.
		- final object = none

		/// Internal associated function.
		- final %function = null
	}

	/**
	 * This class represents the state of an asynchronous operation.
	 */
	@class Promise {
		/**
		 * Creates a new promise for the result of the `func` function.
		 */
		const def new(self, %func) {
			self.function = func
			return self
		}

		/**
		 * Creates a new promise for the result of the `member` method of `object`.
		 */
		const def new(self, object, %member) {
			self.object = object
			self.function = member
			return self
		}

		/**
		 * Starts the associated function in a new thread. The parameters passed
		 * to this method are forwarded to the called function.
		 *
		 * Returns the promise itself.
		 *
		 * Raises {Exception.SystemError} with:
		 *  - `EINVAL` if no function is associated with this promise,
		 *  - `EBUSY` if the promise has already been started,
		 *  - the system error code if the thread could not be started.
		 */
		const def start(self, ...) {

			if not defined self.function {
				raise Exception.SystemError(Exception.SystemError.Errno.EINVAL, self)
			}

			if self.d_ptr is not null {
				raise Exception.SystemError(Exception.SystemError.Errno.EBUSY, self)
			}

			let (d_ptr, errno) = (defined self.object) \
				? System.Promise.g_lib.call('mint_promise_start_member', self.object, self.function, va_args) \
				: System.Promise.g_lib.call('mint_promise_start', self.function, va_args)

			if errno {
				raise Exception.SystemError(errno, self)
			}
			self.attach(d_ptr)
			return self
		}

		/**
		 * Starts the associated coroutine in a new thread.
		 *
		 * Returns the promise itself.
		 *
		 * Raises {Exception.SystemError} with:
		 *  - `EINVAL` if no function is associated with this promise, or if it is a member function (not a coroutine),
		 *  - `EBUSY` if the promise has already been started,
		 *  - the system error code if the thread could not be started.
		 */
		const def spawn(self) {

		    if not defined self.function or defined self.object {
		        raise Exception.SystemError(Exception.SystemError.Errno.EINVAL, self)
		    }

		    if self.d_ptr is not null {
		        raise Exception.SystemError(Exception.SystemError.Errno.EBUSY, self)
		    }

		    let (d_ptr, errno) = System.Promise.g_lib.call('mint_promise_spawn', self.function)
		    if errno {
		        raise Exception.SystemError(errno, self)
		    }
		    self.attach(d_ptr)
		    return self
		}

		/**
		 * Installs the native cleanup on a freshly created handle. The `d_ptr`
		 * parameter must be the valid handle returned by the native start functions.
		 */
		- final const def attach(self, d_ptr) {
		    d_ptr.delete = def [g_lib = System.Promise.g_lib] (self) {
		        g_lib.call('mint_promise_wait', self)
		        g_lib.call('mint_promise_delete', self)
		    }
		    self.d_ptr = d_ptr
		}

		/**
		 * Waits until the associated function completion or until `time`
		 * milliseconds have passed. Returns `true` if the associated function
		 * was completed or `false` on timeout. The associated function must have
		 * been started by a call to {@see start} otherwise the method immediately
		 * returns `false`.
		 */
		const def wait(self, time) {
			if self.d_ptr {
				return System.Promise.g_lib.call('mint_promise_wait_for', self.d_ptr, time)
			}
			return false
		}

		/**
		 * Waits until the associated function completion. The associated function
		 * must have been started by a call to {@see start} otherwise the method
		 * immediately returns.
		 */
		const def wait(self) {
			if self.d_ptr {
				System.Promise.g_lib.call('mint_promise_wait', self.d_ptr)
			}
		}

		/**
		 * Returns `true` if the object thread have been started and a result is
		 * or will be available; otherwise returns `false`.
		 */
		const def isValid(self) {
			if self.d_ptr {
				return System.Promise.g_lib.call('mint_promise_is_valid', self.d_ptr)
			}
			return false
		}

		/**
		 * Takes the associated function's result and returns it. If the result
		 * is not yet available, the method waits until the associated function
		 * completion. The associated function must have been started by a call
		 * to {@see start} otherwise the method immediately returns. After this
		 * method's call, the object will not be valid anymore.
		 */
		const def get(self) {
			if self.d_ptr and System.Promise.g_lib.call('mint_promise_is_valid', self.d_ptr) {
				System.Promise.g_lib.call('mint_promise_wait', self.d_ptr)
				return System.Promise.g_lib.call('mint_promise_get', self.d_ptr)
			}
		}

		/**
		 * Takes the associated function's result and returns it. If the result
		 * is not yet available, the method waits until the associated function
		 * completion. The associated function must have been started by a call
		 * to {@see start} otherwise the method immediately returns. After this
		 * method's call, the object will not be valid anymore.
		 */
		const def await(self) {
			return self.get()
		}

		/**
		 * Takes the associated function's result and returns it. If the result
		 * is not yet available, the method waits until the associated function
		 * completion. The associated function must have been started by a call
		 * to {@see start} otherwise the method immediately returns. After this
		 * method's call, the object will not be valid anymore.
		 */
		const def ()(self) {
			return self.get()
		}

		/// Global library handle.
		- @const g_lib: library = lib('libmint-system')

		/// Object data.
		- final d_ptr = null

		/// Internal associated object.
		- final object = none

		/// Internal associated function.
		- final %function = null
	}

	/**
	 * This class represents the eventual completion (or failure) of an
	 * asynchronous operation and its resulting value.
	 * 
	 * Instances of this class are meant to be used only once. Once created,
	 * the execution of the asynchronous operation is automatically started.
	 * Other operations can be performed on completion using {@see then}.
	 * 
	 * Example:
	 * ```mn
	 * System.Future(def (a, b) {
	 *     return a + b
	 * }, i, j).then(def (r) {
	 *     return r + 5
	 * }).then(def (r) {
	 *     print('The result is %d\n' % (r / 2))
	 * })
	 * ```
	 */
	@class Future {
		/**
		 * Creates a new future that will execute the `func` function with the
		 * given parameters asynchronously.
		 *
		 * Raises {Exception.SystemError} with:
		 *  - `EINVAL` if `func` is not callable,
		 *  - the system error code if the underlying thread could not be started.
		 */
		const def new(self, %func, ...) {
			self.state = System.Future.State.Pending
			self.promise = System.spawnMethod(self, System.Future.resolve, func, *va_args)
			return self
		}

		/**
		 * Chains a new future to be executed once the current result is known.
		 * 
		 * The `onFulfilled` parameter must be a function taking one parameter
		 * that will be called with the future's result on success (i.e. the
		 * value was obtained with `return`).
		 * 
		 * The `onRejected` parameter can be a function taking one parameter
		 * that will be called with the future's result on error (i.e. the
		 * value was obtained with `raise`).
		 * 
		 * The created future is returned by the method to be chained.
		 */
		const def then(self, %onFulfilled, %onRejected = none) {
			return System.Future(Callback(self, System.Future.continuation), onFulfilled, onRejected)
		}

		/**
		 * This method is equivalent to {@see then} but only provides function
		 * to be called on error.
		 */
		const def except(self, %onRejected) {
			return System.Future(Callback(self, System.Future.continuation), none, onRejected)
		}

		/**
		 * This method is equivalent to {@see then} but provides the same function
		 * to be called on success or error.
		 */
		const def finally(self, %onComplet) {
			return System.Future(Callback(self, System.Future.continuation), onComplet, onComplet)
		}

		/**
		 * Performs the resolution of the future's function. Once resolved, the
		 * future will be either in the {System.Future.State.Fulfilled} state
		 * and {@see value} will contains the function's result, or in the
		 * {System.Future.State.Rejected} state and {@see value} will contains
		 * the function's exception.
		 */
		- final const def resolve(self, %func, ...) {
			try {
				self.value = func(*va_args)
				self.state = System.Future.State.Fulfilled
			} catch error {
				self.value = error
				self.state = System.Future.State.Rejected
			}
			return self.value
		}

		/**
		 * Performs the resolution of a chained future. If `self` is in the
		 * {System.Future.State.Fulfilled} state, the `onFulfilled` parameter
		 * is called with the future's result; if `self` is in the
		 * {System.Future.State.Rejected} state, the `onRejected` parameter
		 * is called with the future's error. If the required parameter is set
		 * to `none`, the value (result or error) is returned; otherwise the
		 * returned value is the result of the function call.
		 */
		- final const def continuation(self, %onFulfilled, %onRejected) {
			var value = self.getValue()
			switch self.state {
			case is System.Future.State.Fulfilled:
				if defined onFulfilled {
					return onFulfilled(value)
				} else {
					return value
				}
			case is System.Future.State.Rejected:
				if defined onRejected {
					return onRejected(value)
				} else {
					return value
				}
			}
		}

		/**
		 * Returns the resulting value of the asynchronous operation.
		 */
		- final const def getValue(self) {
			if defined self.value {
				return self.value
			}
			return self.promise.get()
		}

		/**
		 * This enum describes the state of the future.
		 */
		- enum State {
			/// Initial state, neither fulfilled nor rejected.
			Pending
			/// The operation was completed successfully.
			Fulfilled
			/// The operation failed.
			Rejected
		}

		/// Internal state.
		- final %state = null

		/// Internal value.
		- final value = none

		/// Internal promise.
		- final promise = null
	}

	/**
	 * Returns an instance of {System.Promise} for the result of the given `func`
	 * function. The extra parameters passed to this function are forwarded to the
	 * called function. The promise object is started by this function.
	 *
	 * Raises {Exception.SystemError} if the promise could not be started.
	 */
	@def spawn(%func, ...) {
	    return System.Promise(func).start(...va_args)
	}

	/**
	 * Returns an instance of {System.Promise} for the result of the given `func`
	 * method called on the `self` object. The extra parameters passed to this
	 * function are forwarded to the called method. The promise object is started
	 * by this function.
	 *
	 * Raises {Exception.SystemError} if the promise could not be started.
	 */
	@def spawnMethod(self, %func, ...) {
	    return System.Promise(self, func).start(...va_args)
	}

	/**
	 * Returns an instance of {System.Promise} for the result of the given `coroutine`
	 * coroutine. The promise object is started by this function.
	 *
	 * Raises {Exception.SystemError} if the promise could not be started.
	 */
	@def spawnAsync(coroutine) {
	    return System.Promise(coroutine).spawn()
	}

	/**
	 * Yields execution of the current thread to another runnable thread, if any.
	 * Note that the operating system decides to which thread to switch.
	 */
	@def [g_lib: library = lib('libmint-system')] wait() {
		return g_lib.call('mint_thread_wait')
	}

	/**
	 * Forces the current thread to sleep for `time` milliseconds.
	 */
	@def [g_lib: library = lib('libmint-system')] sleep(const time) {
		return g_lib.call('mint_thread_sleep', time)
	}
}
