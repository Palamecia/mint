 * @module
 * This module provides the {System.Timer} class which provides an awaitable timer
 * implementation.
 */

load mint.type

package System {
	/**
	 * This class provides an awaitable timer implementation that trigger an event
	 * when the timer timeout.
	 * 
	 * The timer's clock can be adjusted by using a value of the
	 * {System.Timer.ClockType} enum.
	 * 
	 * > This type is not copyable
	 */
	@class Timer {
		/**
		 * This enum describe the clock precision.
		 */
		enum ClockType {
			Monotonic = 0
		}
		
		/**
		 * Creates a new timer. The created timer is not started.
		 * 
		 * The `clockType` can be a value of {System.Timer.ClockType} that
		 * describe the timer's clock precision.
		 * 
		 * If no timer can be created, `none` is returned.
		 */
	    const def new(self, clockType = System.Timer.ClockType.Monotonic) {
		    if self.d_ptr = System.Timer.g_lib.call('mint_timer_create', clockType) {
				self.d_ptr.delete = def [g_lib = System.Timer.g_lib](self) {
					g_lib.call('mint_timer_delete', self)
				}
		    	return self
		    }
		}

		/**
		 * Disable object copy.
		 */
		- const clone

		/**
		 * Starts or restarts a timer that will timeout after a delay of `delay` milliseconds.
		 */
		const def start(self, delay) {
			System.Timer.g_lib.call('mint_timer_start', self.d_ptr, self.delay = delay)
		}

		/**
		 * Starts or restarts a timer that will timeout after a delay of `delay` milliseconds then every `period`
		 * milliseconds.
		 */
		const def start(self, delay, period) {
			System.Timer.g_lib.call('mint_timer_start_periodic', self.d_ptr, self.delay = delay, self.period = period)
		}

		/**
		 * Restarts the timer with the same timeout delay than the previous
		 * call to {@see start}. The timeout event is reset.
		 * 
		 * Returns `true` if a previous timeout delay can be found; otherwise
		 * `false` is returned and the timer is not started.
		 */
		const def restart(self) {
			if defined self.delay {
				System.Timer.g_lib.call('mint_timer_reset', self.d_ptr)
				if defined self.period {
					System.Timer.g_lib.call('mint_timer_start_periodic', self.d_ptr, self.delay, self.period)
				} else {
					System.Timer.g_lib.call('mint_timer_start', self.d_ptr, self.delay)
				}
				return true
			}
			return false
		}

		/**
		 * Returns the timer delay in milliseconds as a number.
		 */
		const def getDelay(const self) {
			return self.delay
		}

		/**
		 * Returns the timer period in milliseconds as a number.
		 */
		const def getPeriod(const self) {
			return self.period
		}

		/**
		 * Returns `true` if the timer is running; otherwise returns `false`.
		 */
		const def isRunning(const self) {
			return System.Timer.g_lib.call('mint_timer_is_running', self.d_ptr)
		}

		/**
		 * Returns `true` if the timer is periodic; otherwise returns `false`.
		 */
		const def isPeriodic(const self) {
			return defined self.period
		}

		/**
		 * Stops the timer.
		 */
		const def stop(self) {
			System.Timer.g_lib.call('mint_timer_stop', self.d_ptr)
		}

		/**
		 * Resets the timeout event.
		 */
		const def clear(self) {
			System.Timer.g_lib.call('mint_timer_clear', self.d_ptr)
		}

		/**
		 * Waits until the timer timeout. If `timeout` is given, the wait
		 * stop after `timeout` milliseconds if the timer has still not timed
		 * out.
		 * 
		 * Returns `true` if the timer timed out; otherwise returns `false` if
		 * the wait timed out.
		 * 
		 * After a call to this method, the event is reset.
		 */
		const def wait(self, timeout = none) {
			return System.Timer.g_lib.call('mint_timer_wait', self.d_ptr, timeout)
		}

		/**
		 * Returns the handle used by {System.Poller}.
		 */
		const def getHandle(const self) {
			return System.Timer.g_lib.call('mint_timer_get_handle', self.d_ptr)
		}

		/**
		 * Returns the event's poll event as an instance of `mint::poll_event_t`.
		 */
		const def getPollEvent(const self) {
			return System.Timer.g_lib.call('mint_timer_get_poll_event', self.d_ptr)
		}

		/**
		 * Reset the internal event state
		 */
		const def reset(self) {
			self.clear()
		}

		/// Global library handle.
		- @const g_lib = lib('libmint-system')

		/// Object data.
		- final d_ptr = null

		/// Internal timer delay.
		- final delay = none

		/// Internal timer period.
		- final period = none
	}
}
