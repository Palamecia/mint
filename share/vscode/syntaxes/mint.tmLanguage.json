{
  "name": "mint",
  "scopeName": "source.mn",
  "fileTypes": [
    "mn"
  ],
  "patterns": [
    {
      "include": "#stmt_rule"
    },
		{
			"name": "comment.line.shebang.mn",
			"match": "\\A(#!).*(?=$)",
			"captures": {
				"1": {
					"name": "punctuation.definition.comment.mn"
				}
			}
		}
  ],
  "repository": {
    "stmt_rule": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "\\b(assert)\\b(?!\\$)",
          "name": "keyword.mn"
        },
        {
          "match": "\\b(try|catch|raise)\\b(?!\\$)",
          "name": "keyword.control.trycatch.mn"
        },
        {
          "match": "\\b(break|continue|while)\\b(?!\\$)",
          "name": "keyword.control.loop.mn"
        },
        {
          "match": "\\b(for)\\b(?!\\$)",
          "name": "keyword.control.loop.mn"
        },
        {
          "match": "\\b(exit|return|yield)\\b(?!\\$)",
          "name": "keyword.control.flow.mn"
        },
        {
          "match": "\\b(case|default|switch)\\b(?!\\$)",
          "name": "keyword.control.switch.mn"
        },
        {
          "match": "\\b(if|elif|else)\\b(?!\\$)",
          "name": "keyword.control.conditional.mn"
        },
        {
          "match": "\\b(print)\\b(?!\\$)",
          "name": "keyword.control.print.mn"
        },
        {
          "include": "#declaration"
        }
      ]
    },
		"declaration": {
			"name": "meta.declaration.mn",
			"patterns": [
        {
          "include": "#load_rule"
        },
        {
          "include": "#package_rule"
        },
        {
          "include": "#class_rule"
        },
				{
					"include": "#enum_rule"
				},
				{
					"include": "#function_rule"
				}
			]
		},
    "load_rule": {
      "patterns": [
        {
          "begin": "\\b(load)\\s+",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.load.mn"
            }
          },
          "end": "(?=$)",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "match": "([^\\s\\.]+)",
              "name": "keyword.other.unit.mn"
            },
            {
              "match": "(\\.)$",
              "name": "invalid.mn"
            },
            {
              "match": "(\\.)",
              "name": "punctuation.mn"
            },
            {
              "match": "(?!\\s)",
              "name": "invalid.mn"
            }
          ]
        }
      ]
    },
    "package_rule": {
      "patterns": [
        {
			    "name": "meta.package.declaration.mn",
