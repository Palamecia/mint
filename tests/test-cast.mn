load test.case
load mint.type
load mint.operator

@class TestCast : Test.Case {
	const def new(self) {
		
		library = lib('libmint-mint')
		libobject = library.call('mint_int8_create', 0)
		libobject.delete = def [library] (self) {
			library.call('mint_int8_delete', self)
		}

		self._testPackage = Test
		self._testFunction = def {}
		self._testLibrary = library
		self._testLibobject = libobject
		return self
	}

	const def testToBoolean(self) {
		self.expectEqual(boolean(none), false)
		self.expectEqual(boolean(null), false)
		self.expectEqual(boolean(0), false)
		self.expectEqual(boolean(0.5), true)
		self.expectEqual(boolean(1), true)
		self.expectEqual(boolean(7357), true)
		self.expectEqual(boolean(''), true)
		self.expectEqual(boolean(/.*/), true)
		self.expectEqual(boolean([]), true)
		self.expectEqual(boolean({}), true)
		self.expectEqual(boolean(()), false)
		self.expectEqual(boolean((null,)), true)
		self.expectEqual(boolean((0,)), true)
		self.expectEqual(boolean((0.5,)), true)
		self.expectEqual(boolean((1,)), true)
		self.expectEqual(boolean((7357,)), true)
		self.expectEqual(boolean(('',)), true)
		self.expectEqual(boolean((/.*/,)), true)
		self.expectEqual(boolean(([],)), true)
		self.expectEqual(boolean(({},)), true)
		self.expectEqual(boolean(self._testPackage), true)
		self.expectEqual(boolean(self._testFunction), true)
		self.expectEqual(boolean(self._testLibrary), true)
		self.expectEqual(boolean(self._testLibobject), true)
		self.expectEqual(boolean((self._testPackage)), true)
		self.expectEqual(boolean((self._testFunction)), true)
		self.expectEqual(boolean((self._testLibrary)), true)
		self.expectEqual(boolean((self._testLibobject)), true)
	}

	const def testToNumber(self) {
		self.expectEqual(number(false), 0)
		self.expectEqual(number(true), 1)
		self.expectEqual(number('0'), 0)
		self.expectEqual(number('1'), 1)
		self.expectEqual(number('7357'), 7357)
		self.expectEqual(number('0b1001'), 0b1001)
		self.expectEqual(number('0o7057'), 0o7057)
		self.expectEqual(number('0x7E57'), 0x7E57)
		self.expectEqual(number((false,)), 0)
		self.expectEqual(number((true,)), 1)
		self.expectEqual(number(('0',)), 0)
		self.expectEqual(number(('1',)), 1)
		self.expectEqual(number(('7357',)), 7357)
		self.expectEqual(number(('0b1001',)), 0b1001)
		self.expectEqual(number(('0o7057',)), 0o7057)
		self.expectEqual(number(('0x7E57',)), 0x7E57)
	}

	const def testToString(self) {
		self.expectEqual(string(none), '')
		self.expectEqual(string(null), '(null)')
		self.expectEqual(string(false), 'false')
		self.expectEqual(string(true), 'true')
		self.expectEqual(string(0), '0')
		self.expectEqual(string(0.5), '0.5')
		self.expectEqual(string(100000000), '100000000')
		self.expectEqual(string(/.*/), '/.*/')
		self.expectEqual(string([0, 1, 2, 3]), '[0, 1, 2, 3]')
		self.expectEqual(string({0 : 1, 2 : 3}), '{2 : 3, 0 : 1}')
		self.expectEqual(string((null,)), '(null)')
		self.expectEqual(string((false,)), 'false')
		self.expectEqual(string((true,)), 'true')
		self.expectEqual(string((0,)), '0')
		self.expectEqual(string((0.5,)), '0.5')
		self.expectEqual(string((100000000,)), '100000000')
		self.expectEqual(string((/.*/,)), '/.*/')
		self.expectEqual(string(([0, 1, 2, 3],)), '[0, 1, 2, 3]')
		self.expectEqual(string(({0 : 1, 2 : 3},)), '{2 : 3, 0 : 1}')
		self.expectEqual(string(self._testPackage), '(package)')
		self.expectEqual(string(self._testFunction), '(function)')
		self.expectEqual(string(self._testLibrary), '(library)')
		self.expectEqual(string(self._testLibobject), '(libobject)')
		self.expectEqual(string((self._testPackage,)), '(package)')
		self.expectEqual(string((self._testFunction,)), '(function)')
		self.expectEqual(string((self._testLibrary,)), string(self._testLibrary))
		self.expectEqual(string((self._testLibobject,)), string(self._testLibobject))
	}

	const def testToRegex(self) {
		self.expectEqual(regex(none), string(regex('')))
		self.expectEqual(regex(null), string(/(null)/))
		self.expectEqual(regex(false), string(/false/))
		self.expectEqual(regex(true), string(/true/))
		self.expectEqual(regex(true), string(/true/))
		self.expectEqual(regex(0), string(/0/))
		self.expectEqual(regex(0.5), string(/0.5/))
		self.expectEqual(regex(100000000), string(/100000000/))
		self.expectEqual(regex('test'), string(/test/))
		self.expectEqual(regex([0, 1, 2, 3]), string(/[0, 1, 2, 3]/))
		self.expectEqual(regex(()), string(regex('')))
		self.expectEqual(regex((null,)), string(/(null)/))
		self.expectEqual(regex((false,)), string(/false/))
		self.expectEqual(regex((true,)), string(/true/))
		self.expectEqual(regex((true,)), string(/true/))
		self.expectEqual(regex((0,)), string(/0/))
		self.expectEqual(regex((0.5,)), string(/0.5/))
		self.expectEqual(regex((100000000,)), string(/100000000/))
		self.expectEqual(regex(('test',)), string(/test/))
		self.expectEqual(regex(([0, 1, 2, 3],)), string(/[0, 1, 2, 3]/))
		self.expectEqual(regex(self._testPackage), string(/(package)/))
		self.expectEqual(regex(self._testFunction), string(/(function)/))
		self.expectEqual(regex(self._testLibrary), string(/(library)/))
		self.expectEqual(regex(self._testLibobject), string(/(libobject)/))
		self.expectEqual(regex((self._testPackage,)), string(/(package)/))
		self.expectEqual(regex((self._testFunction,)), string(/(function)/))
		self.expectEqual(regex((self._testLibrary,)), string(regex(self._testLibrary)))
		self.expectEqual(regex((self._testLibobject,)), string(regex(self._testLibobject)))
	}

	const def testToArray(self) {
		self.expectEqual(array(none), [])
		self.expectEqual(array(null), [null])
		self.expectEqual(array(false), [false])
		self.expectEqual(array(true), [true])
		self.expectEqual(array(7357), [7357])
		self.expectEqual(array('test'), ['test'])
		self.expectEqual(array(/.*/), string([/.*/]))
		self.expectEqual(array({0 : 1, 2 : 3}), [2, 0])
		self.expectEqual(array((0, 1, 2, 3)), [0, 1, 2, 3])
		self.expect(self.arrayIsSame, [self._testPackage], array(self._testPackage))
		self.expect(self.arrayIsSame, [self._testFunction], array(self._testFunction))
		self.expect(self.arrayIsSame, [self._testLibrary], array(self._testLibrary))
		self.expect(self.arrayIsSame, [self._testLibobject], array(self._testLibobject))
	}

	const def testToHash(self) {
		self.expectEqual(hash(none), {})
		self.expectEqual(hash(null), {null : none})
		self.expectEqual(hash(false), {false : none})
		self.expectEqual(hash(true), {true : none})
		self.expectEqual(hash(7357), {7357 : none})
		self.expectEqual(hash('test'), {'test': none})
		self.expectEqual(hash(/.*/), string({/.*/ : none}))
		self.expectEqual(hash(['a', 'b', 'c']), {0 : 'a', 1 : 'b', 2 : 'c'})
		self.expectEqual(hash(('a', 'b', 'c')), {'a' : none, 'b' : none, 'c' : none})
	}

	const def testToIterator(self) {
		self.expect(self.iteratorEqual, (), inOperator(none))
		self.expect(self.iteratorEqual, (null,), inOperator(null))
		self.expect(self.iteratorEqual, (false,), inOperator(false))
		self.expect(self.iteratorEqual, (true,), inOperator(true))
		self.expect(self.iteratorEqual, (7357,), inOperator(7357))
		self.expect(self.iteratorEqual, ('t', 'e', 's', 't',), inOperator('test'))
		self.expect(self.iteratorCbEqual, (/test/,), inOperator(/test/), string)
		self.expect(self.iteratorEqual, ('a', 'b', 'c'), inOperator(['a', 'b', 'c']))
		// self.expect(self.iteratorCbEqual, ((2, 'c'), (1, 'b'), (0, 'a')), inOperator({0 : 'a', 1 : 'b', 2 : 'c'}), array)
		self.expect(self.iteratorIsSame, (self._testPackage,), inOperator(self._testPackage))
		self.expect(self.iteratorIsSame, (self._testFunction,), inOperator(self._testFunction))
		self.expect(self.iteratorIsSame, (self._testLibrary,), inOperator(self._testLibrary))
		self.expect(self.iteratorIsSame, (self._testLibobject,), inOperator(self._testLibobject))
	}

	- @def arrayIsSame(expected, result) {
		if typeof expected != typeof result {
			return false
		}
		if expected.size() != result.size() {
			return false
		}
		for i in 0...expected.size() {
			if not (expected[i] is result[i]) {
				return false
			}
		}
		return true
	}

	- @def iteratorEqual(expected, result) {
		if typeof expected != typeof result {
			return false
		}
		while not expected.isEmpty() {
			if result.isEmpty() {
				return false
			}
			if expected.next() != result.next() {
				return false
			}
		}
		return result.isEmpty()
	}

	- @def iteratorCbEqual(expected, result, callback) {
		if typeof expected != typeof result {
			return false
		}
		while not expected.isEmpty() {
			if result.isEmpty() {
				return false
			}
			if typeof expected.value() != typeof result.value() {
				return false
			}
			if callback(expected.next()) != callback(result.next()) {
				return false
			}
		}
		return result.isEmpty()
	}

	- @def iteratorIsSame(expected, result) {
		if typeof expected != typeof result {
			return false
		}
		while not expected.isEmpty() {
			if result.isEmpty() {
				return false
			}
			if not (expected.next() is result.next()) {
				return false
			}
		}
		return result.isEmpty()
	}

	- _testPackage = none
	- _testFunction = none
	- _testLibrary = none
	- _testLibobject = none
}
