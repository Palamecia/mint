load test.case
load container.linked-list

@class LinkedListTest : Test.Case {
	const def testCreate(self) {
		lst = Container.LinkedList([0, 7, 3, 5, 7])
		self.expectEqual(typeof lst, 'Container.LinkedList')
		self.expectEqual(lst.data(), [0, 7, 3, 5, 7])
		self.expectEqual(lst.toArray(), [0, 7, 3, 5, 7])
	}

	const def testFirst(self) {
		lst = Container.LinkedList([0, 7, 3, 5, 7])
		self.expectEqual(lst.first(), 0)
		lst.removeFirst()
		self.expectEqual(lst.first(), 7)
		node = lst.firstNode()
		self.expectEqual(node.getValue(), 7)
		self.expectIsSame(node.getPrevious(), none)
		self.expectIsNotSame(node.getNext(), none)
		self.expectEqual(lst.toArray(), [7, 3, 5, 7])
	}

	const def testLast(self) {
		lst = Container.LinkedList([0, 7, 3, 5, 7])
		self.expectEqual(lst.last(), 7)
		lst.removeLast()
		self.expectEqual(lst.last(), 5)
		node = lst.lastNode()
		self.expectEqual(node.getValue(), 5)
		self.expectIsNotSame(node.getPrevious(), none)
		self.expectIsSame(node.getNext(), none)
		self.expectEqual(lst.toArray(), [0, 7, 3, 5])
	}

	const def testEach(self) {
		%values = [0, 7, 3, 5, 7]
		lst = Container.LinkedList(values)
		self.expectEqual(lst.in(5), true)
		self.expectEqual(lst.in(8), false)
		self.expectEqual(lst.contains(5), true)
		self.expectEqual(lst.contains(8), false)
		self.expectEqual(lst.count(7), 2)
		self.expectEqual(lst.count(5), 1)
		self.expectEqual(lst.count(8), 0)
		lst.each(def [self, values, i = 0] (value) {
			self.expectEqual(value, values[i++], 'with i = %d' % i)
		})
		i = 0
		for value in lst {
			self.expectEqual(value, values[i++], 'with i = %d' % i)
		}
	}

	const def testSize(self) {
		lst = Container.LinkedList([0, 7, 3, 5, 7])
		self.expectEqual(lst.isEmpty(), false)
		self.expectEqual(lst.size(), 5)
		lst.clear()
		self.expectEqual(lst.isEmpty(), true)
		self.expectEqual(lst.size(), 0)
	}
}
