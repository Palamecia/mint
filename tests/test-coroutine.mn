load test.case
load test.error-catcher
load mint.coroutine

@class TestCoroutine : Test.Case {
    const def testSimpleWait(self) {
        async def f() {
            return 5
        }
        async def [...] g() {
            let x = await f()
            return x + 1
        }
        self.expectEqual(spawn(g()), 6)
    }

    const def testNestedWait(self) {
        async def a() { return 1 }
        async def [...] b() { return await a() }
        async def [...] c() { return await b() }
        self.expectEqual(spawn(c()), 1)
    }

    const def testWithParameter(self) {
        async def f(seed) {
            return seed + 4
        }
        self.expectEqual(spawn(f(2)), 6)
    }

    const def testGenerator(self) {
        async def f() {
            yield none
            return 42
        }
        let result = spawn(f())
        self.expectEqual(typeof result, 'async_iterator')
        self.expectNotDefined(spawn(result.next()))
        self.expectEqual(spawn(result.next()), 42)
    }

    const def testGeneratorOnly(self) {
        async def f() {
            yield 1
            yield 2
            yield 3
        }
        let result = spawn(f())
        self.expectEqual(typeof result, 'async_iterator')
        self.expectEqual(spawn(result.next()), 1)
        self.expectEqual(spawn(result.next()), 2)
        self.expectEqual(spawn(result.next()), 3)
        self.expectEqual(result.isEmpty(), true)
    }
    
    const def testAwaitNestedGenerator(self) {
        async def f() {
            yield none
            return 42
        }
        async def [...] g() {
            return await f()
        }
        let result = spawn(g())
        self.expectEqual(typeof result, 'async_iterator')
        self.expectNotDefined(spawn(result.next()))
        self.expectEqual(spawn(result.next()), 42)
    }

    const def testAwaitNestedGeneratorOnly(self) {
        async def f() {
            yield 1
            yield 2
            yield 3
        }
        async def [...] g() {
            return await f()
        }
        let result = spawn(g())
        self.expectEqual(typeof result, 'async_iterator')
        self.expectEqual(spawn(result.next()), 1)
        self.expectEqual(spawn(result.next()), 2)
        self.expectEqual(spawn(result.next()), 3)
        self.expectEqual(result.isEmpty(), true)
    }

    const def testAwaitNestedGeneratorWithOperation(self) {
        async def f() {
            yield 1
            return 2
        }
        async def [...] g() {
            for let i in await f() {
                yield i + 1
            }
        }
        let result = spawn(g())
        self.expectEqual(typeof result, 'async_iterator')
        self.expectEqual(spawn(result.next()), 2)
        self.expectEqual(spawn(result.next()), 3)
        self.expectEqual(result.isEmpty(), true)
    }

    const def testDeepAwaitChain(self) {
        async def leaf() {
            return 1
        }
        async def [...] level2() {
            let x = await leaf()
            return x + 1
        }
        async def [...] level1() {
            let y = await level2()
            return y + 1
        }
        async def [...] root() {
            return await level1()
        }
        self.expectEqual(spawn(root()), 3)
    }

    const def testAwaitInsideLoop(self) {
        async def inc(x) {
            return x + 1
        }
        async def [...] test() {
            let sum = 0
            for let i in (1, 2, 3) {
                sum = sum + await inc(i)
            }
            return sum
        }
        self.expectEqual(spawn(test()), 9)
    }

    const def testAwaitInsideConditionalBranch(self) {
        async def value(x) {
            return x * 2
        }
        async def [...] test(flag) {
            if flag {
                return await value(5)
            } else {
                return await value(10)
            }
        }
        self.expectEqual(spawn(test(true)), 10)
        self.expectEqual(spawn(test(false)), 20)
    }

    const def testAwaitExpressionEvaluationOrder(self) {
        async def a() { return 2 }
        async def b() { return 3 }
        async def [...] test() {
            let x = 1 + await a() * await b()
            return x
        }
        self.expectEqual(spawn(test()), 1 + 2 * 3)
    }

    const def testAwaitInNestedBlocks(self) {
        async def inner() {
            return 5
        }
        async def [...] outer() {
            if true {
                if true {
                    return await inner()
                }
            }
        }
        self.expectEqual(spawn(outer()), 5)
    }

    const def testExceptionPropagationThroughAwait(self) {
        async def boom() {
            raise "error"
        }
        async def [...] test() {
            try {
                await boom()
            } catch error {
                return "caught"
            }
        }
        self.expectEqual(spawn(test()), "caught")
    }

    const def testExceptionBubblingAcrossMultipleLevels(self) {
        async def fail() {
            raise "x"
        }
        async def [...] middle() {
            await fail()
        }
        async def [...] top() {
            try {
                await middle()
            } catch error {
                return "ok"
            }
        }
        self.expectEqual(spawn(top()), "ok")
    }

    const def testDoubleAwaitOnSameCoroutine(self) {
        async def simple() {
            return 10
        }
        let c = simple()
        self.expectEqual(spawn(c), 10)
        try {
            let catcher = Test.ErrorCatcher()
            spawn(c)
            self.fail()
        } catch error {
            self.expectEqual(error.toString(), "cannot reuse already awaited coroutine")
        }
    }

    const def testAwaitInsideGeneratorExpression(self) {
        async def inc(x) {
            return x + 1
        }
        async def [...] test() {
            let g = for let i in (1, 2, 3) => await inc(i)
            let sum = 0
            for let v in g {
                sum = sum + v
            }
            return sum
        }
        self.expectEqual(spawn(test()), 9)
    }

    const def testVariableCaptureAcrossSuspension(self) {
        async def test() {
            let x = 5
            let y = await (async def [...]() { return x + 1 })()
            x = 100
            return y
        }
        self.expectEqual(spawn(test()), 6)
    }

    const def testMassiveSuspensionDepth(self) {
        async def [...] chain(n) {
            if n == 0 {
                return 0
            }
            return 1 + await chain(n - 1)
        }
        self.expectEqual(spawn(chain(50)), 50)
    }

    const def testAwaitInSwitch(self) {
        async def get(x) {
            return x * 2
        }
        async def [...] test(v) {
            let r =: switch v {
                case 1 => await get(1)
                case 2 => await get(2)
                default => 0
            }
            return r
        }
        self.expectEqual(spawn(test(1)), 2)
        self.expectEqual(spawn(test(2)), 4)
    }

    const def testReturnSwitchExpression(self) {
        async def get(x) {
            return x * 2
        }

        async def [...] test(v) {
            return switch v {
                case 1 => await get(1)
                case 2 => await get(2)
                default => 0
            }
        }

        self.expectEqual(spawn(test(1)), 2)
        self.expectEqual(spawn(test(2)), 4)
        self.expectEqual(spawn(test(3)), 0)
    }

    const def testAwaitInWhileLoopWithMutation(self) {
        async def next_val(x) {
            return x + 1
        }
        async def [...] test() {
            let i = 0
            while i < 3 {
                i = await next_val(i)
            }
            return i
        }
        self.expectEqual(spawn(test()), 3)
    }

    const def testTheMostImportantHiddenBug(self) {
        async def test() {
            let x = 1
            let y = await (async def [...]() {
                return x + 1
            })()
            return x + y
        }
        self.expectEqual(spawn(test()), 3)
    }

    const def testStress(self) {
        async def [...] inner(x) {
            if x % 2 == 0 {
                return x
            }
            return await inner(x - 1)
        }
        async def [...] test() {
            let sum = 0
            for let i in (1, 2, 3, 4, 5) {
                sum = sum + await inner(i)
            }
            return sum
        }
        self.expectEqual(spawn(test()), 2 + 2 + 4 + 4)
    }

    const def testInnerCatchPreventsPropagation(self) {
        async def child() {
            try {
                raise "boom"
            } catch error {
                return "handled"
            }
        }
        async def [...] parent() {
            return await child()
        }
        self.expectEqual(spawn(parent()), "handled")
    }

    const def testRethrowFromInnerCoroutine(self) {
        async def child() {
            try {
                raise "boom"
            } catch error {
                raise "rethrow"
            }
        }
        async def [...] parent() {
            try {
                await child()
                return "bad"
            } catch error {
                return error
            }
        }
        self.expectEqual(spawn(parent()), "rethrow")
    }

    const def testAwaitInsideCatchBlock(self) {
        async def fail() {
            raise "boom"
        }
        async def recover() {
            return "recovered"
        }
        async def [...] test() {
            try {
                await fail()
            } catch error {
                return await recover()
            }
        }
        self.expectEqual(spawn(test()), "recovered")
    }

    const def testExceptionAfterAwaitResumesCorrectly(self) {
        async def ok() {
            return 1
        }
        async def [...] test() {
            let x = await ok()
            raise "after"
        }
        async def [...] wrapper() {
            try {
                await test()
            } catch error {
                return error
            }
        }
        self.expectEqual(spawn(wrapper()), "after")
    }

    const def testMultipleAwaitsWithFailureInSecond(self) {
        async def ok() { return 1 }
        async def fail() { raise "boom" }
        async def [...] test() {
            await ok()
            await fail()
            return "bad"
        }
        async def [...] wrapper() {
            try {
                await test()
            } catch error {
                return "caught"
            }
        }
        self.expectEqual(spawn(wrapper()), "caught")
    }

    const def testNestedTryCatchAcrossAwaitBoundaries(self) {
        async def fail() {
            raise "boom"
        }
        async def [...] test() {
            try {
                try {
                    await fail()
                } catch e1 {
                    raise "inner"
                }
            } catch e2 {
                return e2
            }
        }
        self.expectEqual(spawn(test()), "inner")
    }

    const def testExceptionValueIntegrity(self) {
        async def fail() {
            raise "boom"
        }
        async def [...] test() {
            try {
                await fail()
            } catch error {
                return error
            }
        }
        self.expectEqual(spawn(test()), "boom")
    }

    const def testDeepRecursiveAwaitPropagation(self) {
        async def [...] chain(n) {
            if n == 0 {
                raise "end"
            }
            await chain(n - 1)
        }
        async def [...] test() {
            try {
                await chain(10)
            } catch error {
                return error
            }
        }
        self.expectEqual(spawn(test()), "end")
    }

    const def testVariablePreservationAfterException(self) {
        async def fail() {
            raise "boom"
        }
        async def [...] test() {
            let x = 5
            try {
                await fail()
            } catch error {
                return x
            }
        }
        self.expectEqual(spawn(test()), 5)
    }

    const def testAwaitInsideFinallyBlock(self) {
        async def fail() {
            raise "boom"
        }
        async def [...] test() {
            try {
                await fail()
            }
            return "cleanup"
        }
        self.expectEqual(spawn(test()), "cleanup")
    }

    const def testExceptionInsideFinally(self) {
        async def fail() {
            raise "first"
        }
        async def [...] test() {
            try {
                await fail()
            }
            raise "second"
        }
        async def [...] wrapper() {
            try {
                await test()
            } catch error {
                return error
            }
        }
        self.expectEqual(spawn(wrapper()), "second")
    }

    const def testCallerThrowsAfterAwaitedException(self) {
        async def fail() {
            raise "boom"
        }
        async def [...] test() {
            try {
                await fail()
            } catch error {
                raise "caller_error"
            }
        }
        async def [...] wrapper() {
            try {
                await test()
            } catch error {
                return error
            }
        }
        self.expectEqual(spawn(wrapper()), "caller_error")
    }

    const def testConcurrentAwaitIsolation(self) {
        async def fail() {
            raise "boom"
        }
        async def ok() {
            return 1
        }
        async def [...] test() {
            try {
                await fail()
            } catch error {
                return await ok()
            }
        }
        self.expectEqual(spawn(test()), 1)
    }

    const def testUltimateExceptionDiagnostic(self) {
        async def fail() {
            raise "boom"
        }
        async def [...] test() {
            let x = 10
            try {
                await fail()
            } catch error {
                return x + 1
            }
        }
        self.expectEqual(spawn(test()), 11)
    }

    const def testAsyncGeneratorNextAfterCompletion(self) {

        async def f() {
            yield 1
        }

        let it = spawn(f())

        self.expectEqual(spawn(it.next()), 1)
        self.expectEqual(it.isEmpty(), true)

        let result = spawn(it.next())
        self.expectEqual(result, none)
    }

    const def testAsyncGeneratorYieldAfterAwait(self) {

        async def f() {
            return 10
        }

        async def [...] g() {
            let x = await f()
            yield x + 1
            yield x + 2
        }

        let it = spawn(g())

        self.expectEqual(spawn(it.next()), 11)
        self.expectEqual(spawn(it.next()), 12)
        self.expectEqual(it.isEmpty(), true)
    }

    const def testAsyncGeneratorYieldGeneratorExpressionWithoutParentheses(self) {

        async def f() {
            yield for let i in (1, 2, 3) => i
        }

        let it = spawn(f())

        self.expectEqual(spawn(it.next()), 1)
        self.expectEqual(spawn(it.next()), 2)
        self.expectEqual(spawn(it.next()), 3)
        self.expectEqual(it.isEmpty(), true)
    }

    const def testAsyncGeneratorAwaitInLoop(self) {

        async def f() {
            yield 1
            yield 2
        }

        async def delay(x) {
            return x
        }

        async def [...] g() {
            for let x in await f() {
                let y = await delay(x)
                yield y * 2
            }
        }

        let it = spawn(g())

        self.expectEqual(spawn(it.next()), 2)
        self.expectEqual(spawn(it.next()), 4)
        self.expectEqual(it.isEmpty(), true)
    }

    const def testAsyncGeneratorException(self) {

        async def f() {
            yield 1
            raise 'boom'
        }

        let caught = false
        try {
            let it = spawn(f())
            self.expectEqual(spawn(it.next()), 1)
            spawn(it.next())
        } catch error {
            caught = true
        }

        self.expectEqual(caught, true)
    }

    const def testAsyncGeneratorDoubleIterator(self) {

        async def f() {
            yield 1
            yield 2
        }

        let it1 = spawn(f())
        let it2 = it1   // aliasing same iterator

        self.expectEqual(spawn(it1.next()), 1)
        self.expectEqual(spawn(it2.next()), 2)

        self.expectEqual(it1.isEmpty(), true)
    }

    const def testAsyncGeneratorDeepStack(self) {

        async def [...] f(n) {
            if n == 0 {
                yield 0
            } else {
                for let x in await f(n - 1) {
                    yield x + 1
                }
            }
        }

        let it = spawn(f(5))

        self.expectEqual(spawn(it.next()), 5)
        self.expectEqual(it.isEmpty(), true)
    }

    const def testAsyncGeneratorReturnGeneratorExpressionWithoutParentheses(self) {

        async def f() {
            yield 1
            return switch 1 {
                case 0 => 10
                case 1 => 20
                default => 30
            }
        }

        let it = spawn(f())

        self.expectEqual(spawn(it.next()), 1)
        self.expectEqual(spawn(it.next()), 20)
        self.expectEqual(it.isEmpty(), true)
    }
    

    const def testAsyncGeneratorSchedulerInterleave(self) {

        async def f() {
            yield 1
            yield 2
        }

        async def [...] consumer() {
            let it = await f()
            let a = await it.next()
            let b = await it.next()
            return a + b
        }

        let result = spawn(consumer())
        self.expectEqual(result, 3)
    }
}
