load test.case
load mint.enum

@enum TestEnum {
	first = 0
	next = 1
	last = 2
}

@class EnumTest : Test.Case {
	const def testFindEnumName(self) {
		self.expectEqual(TestEnum.findEnumName(TestEnum.first), 'TestEnum.first')
		self.expectEqual(TestEnum.findEnumName(TestEnum.next), 'TestEnum.next')
		self.expectEqual(TestEnum.findEnumName(TestEnum.last), 'TestEnum.last')
	}

	const def testFindEnumValue(self) {
		self.expectIsSame(TestEnum.findEnumValue(0), TestEnum.first)
		self.expectIsSame(TestEnum.findEnumValue(1), TestEnum.next)
		self.expectIsSame(TestEnum.findEnumValue(2), TestEnum.last)
	}
}
