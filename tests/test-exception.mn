load test.case
load exception.exception

@class ExceptionTest : Test.Case {
	const def testCatch(self) {
		try {
			raise 'test'
		} catch error {
			var received = error
		}
		self.expectEqual('test', received)
	}

	const def testCatchFromGenerator(self) {
		try {
			a, b = def {
				yield (none)
				raise 'test'
			} ()
		} catch error {
			var received = error
		}
		self.expectEqual('test', received)
	}

	const def testCatchRuntimeError(self) {
		try {
			raise Exception.RuntimeError('test')
		} catch error {
			var received = error
		}
		self.expectEqual('test', received.toString())
	}
}
