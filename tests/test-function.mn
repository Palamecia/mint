load test.case
load mint.function

@class FunctionTest : Test.Case {
	class MyClass {
		const def new(self, message) {
			self.message = message
			return self
		}

		const def myMethod(self) {
			return self.message
		}

		- message
	}

	const def testCallbackCall(self) {
		object = FunctionTest.MyClass('success')
		func = Callback(object, object.myMethod)
		self.expectEqual(func(), 'success')
		object = FunctionTest.MyClass('test')
		func = Callback(object, object.myMethod)
		self.expectEqual(func(), 'test')
	}

	const def testSignalConnect(self) {
		var sig = Signal()
		var first = def {}
		var second = def {}
		self.expectEqual(sig.connect(first), true)
		self.expectEqual(sig.connect(second), true)
		self.expectEqual(sig.connect(first), false)
		self.expectEqual(sig.disconnect(first), true)
		self.expectEqual(sig.disconnect(first), false)
		self.expectEqual(sig.connect(first), true)
	}

	const def testSignalCount(self) {
		var sig = Signal()
		var activation = 0
		sig.connect(def [activation] {
			++activation
		})
		sig.connect(def [activation] {
			++activation
		})
		sig.connect(def [activation] {
			++activation
		})
		sig()
		self.expectEqual(activation, 3)
	}

	const def testSignalOrder(self) {
		var sig = Signal()
		var activation = 0
		var (first, second, third) = (0, 0, 0)
		sig.connect(def [first, activation] {
			first = ++activation
		})
		sig.connect(def [second, activation] {
			second = ++activation
		})
		sig.connect(def [third, activation] {
			third = ++activation
		})
		sig()
		self.expectEqual(activation, 3)
		self.expectEqual(first, 1)
		self.expectEqual(second, 2)
		self.expectEqual(third, 3)
	}

	const def testToString(self) {
		object = FunctionTest.MyClass('success')
		func = Callback(object, object.myMethod)
		self.expectEqual(func.toString(), 'FunctionTest.MyClass.myMethod')
	}
}
