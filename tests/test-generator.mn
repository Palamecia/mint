load test.case

class TestGenerator : Test.Case {
    const def testIfGenerator(self) {
        self.expect(self.iteratorEqual, (), if false => 'ok')
        self.expect(self.iteratorEqual, ('ok', ), if true => 'ok')
        self.expect(self.iteratorEqual, ('ok', ), (if false => 'ko' else => 'ok'))
        self.expect(self.iteratorEqual, (1, 2, 3), if true {
            yield 1
            yield 2
            yield 3
        })
    }

    const def testSwitchGenerator(self) {
        self.expect(self.iteratorEqual, ('ok', ), switch 1 {
            case 0 => 'ko'
            case 1 => 'ok'
            default => 'no'
        })
    }

    const def testWhileGenerator(self) {
        if let gen = 0..5 {
            self.expect(self.iteratorEqual, (0, 1, 2, 3, 4, 5), while not gen.isEmpty() => gen.next())
        }
    }

    const def testForGenerator(self) {
        self.expect(self.iteratorEqual, (0, 1, 2, 3, 4, 5), for let i in 0..5 => i)
        self.expect(self.iteratorEqual, (11, 21, 12, 22), for let i in (1, 2) {
            for let j in (10, 20) {
                yield i + j
            }
        })
    }

    const def testNestedGenerator(self) {
        self.expectEqual([1, 3, 5, 7, 9], [for let i in 0..10 => if i % 2 => i])
        self.expect(self.iteratorEqual, ('a', 'b', 'c', 'd', 'e'), for let i in 0..5 => switch i {
            case 0 => 'a'
            case 1 => 'b'
            case 2 => 'c'
            case 3 => 'd'
            case 4 => 'e'
        })
    }

    const def testVariableCapture(self) {

        let x = 10
        let g = for let i in [1, 2, 3] => i + x

        x = 20

        let result = [...g]

        self.expectEqual([11, 22, 23], result)
    }

    const def testLazyExecution(self) {

        let counter = 0

        let g = for i in [1, 2, 3, 4] {
            counter = counter + 1
            yield i
        }

        self.expectEqual(1, counter)

        let first = g.next()
        self.expectEqual(2, counter)

        [...g]
        self.expectEqual(4, counter)
    }

    const def testReturnGenerator(self) {
        let gen = def() {
            return (for let i in 0..5 => i)
        }
        self.expect(self.iteratorEqual, (0, 1, 2, 3, 4, 5), gen())
    }

    const def testReturnGeneratorWithCapture(self) {
        let gen = def() {
            let i = 0
            return (while i <= 5 => i++)
        }
        self.expect(self.iteratorEqual, (0, 1, 2, 3, 4, 5), gen())
    }

    const def testReturnGeneratorFromGenerator(self) {
        let gen = def() {
            yield (for let i in 0..5 => i)
        }
        self.expect(self.iteratorEqual, (0, 1, 2, 3, 4, 5), gen().next())
    }

    const def testReturnGeneratorFromGeneratorWithCapture(self) {
        let gen = def() {
            let i = 0
            yield (while i <= 5 => i++)
        }
        self.expect(self.iteratorEqual, (0, 1, 2, 3, 4, 5), gen().next())
    }

	- @def iteratorEqual(expected, result) {
		if typeof expected != typeof result {
			return false
		}
		while not expected.isEmpty() {
			if result.isEmpty() {
				return false
			}
			if expected.next() != result.next() {
				return false
			}
		}
		return result.isEmpty()
	}
}
