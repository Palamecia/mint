load test.case

@class TestGenerator : Test.Case {
    const def testIfGenerator(self) {
        self.expect(self.iteratorEqual, (), if false => 'ok')
        self.expect(self.iteratorEqual, ('ok', ), if true => 'ok')
        self.expect(self.iteratorEqual, ('ok', ), (if false => 'ko' else => 'ok'))
        self.expect(self.iteratorEqual, (1, 2, 3), if true {
            yield 1
            yield 2
            yield 3
        })
    }

    const def testSwitchGenerator(self) {
        self.expect(self.iteratorEqual, ('ok', ), switch 1 {
            case 0 => 'ko'
            case 1 => 'ok'
            default => 'no'
        })
    }

    const def testWhileGenerator(self) {
        if let gen = 0..5 {
            self.expect(self.iteratorEqual, (0, 1, 2, 3, 4, 5), while not gen.isEmpty() => gen.next())
        }
    }

    const def testForGenerator(self) {
        self.expect(self.iteratorEqual, (0, 1, 2, 3, 4, 5), for let i in 0..5 => i)
        self.expect(self.iteratorEqual, (11, 21, 12, 22), for let i in (1, 2) {
            for let j in (10, 20) {
                yield i + j
            }
        })
    }

    const def testNestedGenerator(self) {
        self.expectEqual([for let i in 0..10 => if i % 2 => i], [1, 3, 5, 7, 9])
        self.expect(self.iteratorEqual, ('a', 'b', 'c', 'd', 'e'), for let i in 0..5 => switch i {
            case 0 => 'a'
            case 1 => 'b'
            case 2 => 'c'
            case 3 => 'd'
            case 4 => 'e'
        })
    }

    const def testBreakFromSwitchInGenerator(self) {
        self.expect(self.iteratorEqual, (0, 1, 2, 3, 4, 5), for let i in 0..5 {
            switch i {
            case 2:
                break
            }
            yield i
        })
    }

    const def testBreakFromNestedSwitchInGenerator(self) {
        self.expect(self.iteratorEqual, (0, 1, 2, 3, 4, 5), for let i in 0..5 {
            switch i {
            case 2:
                if true {
                    break
                }
            }
            yield i
        })
    }

    const def testVariableCapture(self) {

        let x = 10
        let g = for let i in [1, 2, 3] => i + x

        x = 20

        let result = [...g]

        self.expectEqual(result, [11, 22, 23])
    }

    const def testLazyExecution(self) {

        let counter = 0

        let g = for i in [1, 2, 3, 4] {
            counter = counter + 1
            yield i
        }

        self.expectEqual(counter, 1)

        let first = g.next()
        self.expectEqual(counter, 2)

        [...g]
        self.expectEqual(counter, 4)
    }

    const def testReturnGenerator(self) {
        def gen() {
            return (for let i in 0..5 => i)
        }
        self.expect(self.iteratorEqual, (0, 1, 2, 3, 4, 5), gen())
    }

    const def testReturnGeneratorWithCapture(self) {
        def gen() {
            let i = 0
            return (while i <= 5 => i++)
        }
        self.expect(self.iteratorEqual, (0, 1, 2, 3, 4, 5), gen())
    }

    const def testReturnGeneratorFromGenerator(self) {
        def gen() {
            yield (for let i in 0..5 => i)
        }
        self.expect(self.iteratorEqual, (0, 1, 2, 3, 4, 5), gen().next())
    }

    const def testReturnGeneratorFromGeneratorWithCapture(self) {
        def gen() {
            let i = 0
            yield (while i <= 5 => i++)
        }
        self.expect(self.iteratorEqual, (0, 1, 2, 3, 4, 5), gen().next())
    }

    const def testYieldGeneratorExpressionWithoutParentheses(self) {
        def gen() {
            yield for let i in 0..5 => i
        }
        self.expect(self.iteratorEqual, (0, 1, 2, 3, 4, 5), gen())
    }

    const def testReturnGeneratorExpressionWithoutParentheses(self) {
        def gen() {
            return switch 1 {
                case 0 => 'ko'
                case 1 => 'ok'
                default => 'no'
            }
        }
        self.expectEqual(gen(), 'ok')
    }

    const def testRaiseBeforeFirstYield(self) {
        def gen() {
            raise "boom"
            yield 1
        }
        try {
            for let x in gen() {}
            self.fail()
        } catch error {
            self.expectEqual(error, "boom")
        }
    }

    const def testRaiseAfterFirstYield(self) {
        def gen() {
            yield 1
            raise "boom"
        }
        let values = []
        try {
            for let x in gen() {
                values.push(x)
            }
            self.fail()
        } catch error {
            self.expectEqual(error, "boom")
        }
        self.expectEqual(values, [1])
    }

    const def testCatchInsideGenerator(self) {
        def gen() {
            try {
                raise "err"
            } catch error {
                yield "handled"
            }
        }
        let result = []
        for let x in gen() {
            result.push(x)
        }
        self.expectEqual(result, ["handled"])
    }

    const def testRaiseInsideLoopInGenerator(self) {
        def gen() {
            for let i in (1, 2, 3) {
                if i == 2 {
                    raise "bad"
                }
                yield i
            }
        }
        let values = []
        try {
            for let x in gen() {
                values.push(x)
            }
            self.fail()
        } catch error {
            self.expectEqual(error, "bad")
        }
        self.expectEqual(values, [1])
    }

    const def testCatchOutsideGenerator(self) {
        def gen() {
            yield 1
            raise "fail"
        }
        let values = []
        try {
            for let x in gen() {
                values.push(x)
            }
        } catch error {
            values.push("caught")
        }
        self.expectEqual(values, [1, "caught"])
    }

    const def testNestedGeneratorRaise(self) {
        def inner() {
            yield 1
            raise "inner_error"
        }
        def [...] outer() {
            for let x in inner() {
                yield x
            }
        }
        let values = []
        try {
            for let x in outer() {
                values.push(x)
            }
            self.fail()
        }
        self.expectEqual(values, [1])
    }

    const def testRaiseAfterYieldInTryBlock(self) {
        def gen() {
            try {
                yield 1
                raise "boom"
            } catch error {
                yield 2
            }
        }
        let result = []
        for let x in gen() {
            result.push(x)
        }
        self.expectEqual(result, [1,2])
    }

    const def testYieldInsideCatchAfterSuspension(self) {
        def gen() {
            try {
                yield 1
                raise "err"
            } catch error {
                yield 2
                yield 3
            }
        }
        let result = []
        for let x in gen() {
            result.push(x)
        }
        self.expectEqual(result, [1,2,3])
    }

    const def testRaiseInsideGeneratorExpression(self) {
        let g = for let i in (1, 2, 3) {
            if i == 2 {
                raise "bad"
            }
            yield i
        }
        let values = []
        try {
            for let x in g {
                values.push(x)
            }
            self.fail()
        }
        self.expectEqual(values, [1])
    }

    const def testRaiseInDeeplyNestedControlFlow(self) {
        def gen() {
            for let i in (1, 2, 3) {
                while true {
                    if i == 2 {
                        raise "boom"
                    }
                    yield i
                    break
                }
            }
        }
        let values = []
        try {
            for let x in gen() {
                values.push(x)
            }
            self.fail()
        }
        self.expectEqual(values, [1])
    }

    const def testGeneratorCleanupAfterException(self) {
        let flag = 0
        def [...] gen() {
            try {
                yield 1
                raise "x"
            } catch error {
                flag = 42
                raise
            }
        }
        try {
            for let x in gen() {}
            self.fail()
        }
        self.expectEqual(flag, 42)
    }

    const def testMostImportantDiagnostic(self) {
        def gen() {
            let x = 10
            try {
                yield x
                raise "err"
            } catch error {
                yield x + 1
            }
        }
        let result = []
        for let v in gen() {
            result.push(v)
        }
        self.expectEqual(result, [10,11])
    }

    const def testGeneratorCatchesItsOwnException(self) {
        def gen() {
            try {
                yield 1
                raise "boom"
            } catch error {
                yield 2
            }
        }
        let result = []
        try {
            for let x in gen() {
                result.push(x)
            }
        } catch error {
            result.push("caller")
        }
        self.expectEqual(result, [1,2])
    }

    const def testGeneratorDoesNotCatch(self) {
        def gen() {
            yield 1
            raise "boom"
        }
        let result = []
        try {
            for let x in gen() {
                result.push(x)
            }
        } catch error {
            result.push("caller")
        }
        self.expectEqual(result, [1,"caller"])
    }

    const def testGeneratorCatchesThenReraises(self) {
        def gen() {
            try {
                yield 1
                raise "boom"
            } catch error {
                yield 2
                raise
            }
        }
        let result = []
        try {
            for let x in gen() {
                result.push(x)
            }
        } catch error {
            result.push("caller")
        }
        self.expectEqual(result, [1,2,"caller"])
    }

    const def testCallerHasTryInsideLoopBody(self) {
        def gen() {
            yield 1
            raise "boom"
        }
        let result = []
        try {
            for let x in gen() {
                try {
                    result.push(x)
                } catch error {
                    result.push("inner")
                }
            }
        }
        self.expectEqual(result, [1])
    }

    const def testCallerHasTryWrappingEachNext(self) {
        def gen() {
            yield 1
            raise "boom"
        }
        let g = gen()
        let result = []
        try {
            result.push(g.value())
            result.push(g.next())
        } catch error {
            result.push("caught")
        }
        self.expectEqual(result, [1,"caught"])
    }

    const def testBothHaveNestedTryCatch(self) {
        def gen() {
            try {
                yield 1
                try {
                    raise "boom"
                } catch error {
                    yield 2
                }
            } catch error {
                yield 999
            }
        }
        let result = []
        try {
            for let x in gen() {
                result.push(x)
            }
        } catch error {
            result.push("caller")
        }
        self.expectEqual(result, [1,2])
    }

    const def testGeneratorHasOuterCatchCallerAlsoHasCatch(self) {
        def gen() {
            try {
                yield 1
                raise "boom"
            } catch error {
                raise "rethrow"
            }
        }
        let result = []
        try {
            for let x in gen() {
                result.push(x)
            }
        } catch error {
            result.push(error)
        }
        self.expectEqual(result, [1,"rethrow"])
    }

    const def testExceptionAfterFinalYield(self) {
        def gen() {
            yield 1
            return none
            raise "boom"
        }
        let result = []
        try {
            for let x in gen() {
                result.push(x)
            }
        } catch error {
            result.push("caller")
        }
        self.expectEqual(result, [1, none])
    }

    const def testGeneratorSuspendedInsideTry(self) {
        def gen() {
            try {
                yield 1
                yield 2
                raise "boom"
            } catch error {
                yield 3
            }
        }
        let result = []
        try {
            for let x in gen() {
                result.push(x)
            }
        } catch error {
            result.push("caller")
        }
        self.expectEqual(result, [1,2,3])
    }

    const def testTheRealRuntimeKiller(self) {
        def gen() {
            try {
                yield 1
                raise "boom"
            } catch error {
                yield 2
            }
        }
        let result = []
        try {
            for let x in gen() {
                result.push(x)
                if x == 2 {
                    raise "caller_error"
                }
            }
        } catch error {
            result.push(error)
        }
        self.expectEqual(result, [1,2,"caller_error"])
    }

	- @def iteratorEqual(expected, result) {
		if typeof expected != typeof result {
			return false
		}
		while not expected.isEmpty() {
			if result.isEmpty() {
				return false
			}
			if expected.next() != result.next() {
				return false
			}
		}
		return result.isEmpty()
	}
}
