load test.case
load system.thread
load network.channel
load network.endpoints.tcpip
load network.endpoints.udpip
load network.serializers.server
load network.serializers.datagram
load network.protocols.http.client
load network.protocols.http.server

class NetworkChannelTest : Test.Case {
	const def testOnTcpMessage(self) {

        let result = 'ko'
        let scheduler = Network.Scheduler()
        let client = Network.AsynchronousChannel(Network.TcpIp(scheduler, '127.0.0.1', 7357))
        let server = Network.AsynchronousChannel(Network.TcpIp(scheduler, '127.0.0.1', 7357), Network.ServerSerializer)

        server.onMessage = def [result] (self, channel) {
            let client = Network.AsynchronousChannel(channel.read())
            client.onMessage = def [result] (self, channel) {
                result = channel.read()
                channel.close()
                channel.unwatch()
            }
            client.watch()
            channel.close()
            channel.unwatch()
        }

        client.onOpen = def (self, channel) {
            channel.write('ok')
        }

        client.onClose = def (self, channel) {
            channel.unwatch()
        }

        self.expectEqual(true, server.watch())
        self.expectEqual(true, server.listen())

        self.expectEqual(true, client.watch())
        self.expectEqual(true, client.connect())

        scheduler.run()
        self.expectEqual('ok', result)
    }

	const def testOnHttpMessage(self) {

        let result = 'ko'
        let scheduler = Network.Scheduler()
        let client = Network.Http.Client(Network.TcpIp(scheduler, '127.0.0.1', 7357))
        let server = Network.Http.Server(Network.TcpIp(scheduler, '127.0.0.1', 7357))

        server.onConnection = def [result] (self, channel) {
            channel.onMessage = def [result] (self, channel) {
                result = channel.read().getBody()
                channel.close()
                channel.unwatch()
            }
            self.close()
            self.unwatch()
        }

        client.onOpen = def (self, channel) {
            channel.write('ok')
        }

        client.onClose = def (self, channel) {
            channel.unwatch()
        }

        self.expectEqual(true, server.watch())
        self.expectEqual(true, server.listen())

        self.expectEqual(true, client.watch())
        self.expectEqual(true, client.connect())

        scheduler.run()
        self.expectEqual('ok', result)
    }

	const def testOnUdpMessage(self) {

        let result = 'ko'
        let scheduler = Network.Scheduler()
        let client = Network.AsynchronousChannel(Network.UdpIp(scheduler, '127.0.0.1', 7357), Network.DatagramSerializer)
        let server = Network.AsynchronousChannel(Network.UdpIp(scheduler, '127.0.0.1', 7357), Network.DatagramSerializer)

        let sender = System.Thread(def [client, result] {
            while result == 'ko' {
                client.write('ok')
                System.wait()
            }
            client.close()
        })

        server.onMessage = def [result] (self, channel) {
            let datagram = channel.read()
            result = datagram.data().getString()
            channel.close()
            channel.unwatch()
        }

        client.onClose = def (self, channel) {
            channel.unwatch()
        }

        self.expectEqual(true, server.watch())
        self.expectEqual(true, server.bind())

        self.expectEqual(true, client.watch())
        self.expectEqual(true, client.connect())

        sender.start()

        scheduler.run()
        self.expectEqual('ok', result)
    }

	const def testWatch(self) {

        let i = 0
        let scheduler = Network.Scheduler()
        let client = Network.AsynchronousChannel(Network.TcpIp(scheduler, '127.0.0.1', 7357))
        let server = Network.AsynchronousChannel(Network.TcpIp(scheduler, '127.0.0.1', 7357), Network.ServerSerializer)

        server.onMessage = def [result] (self, channel) {
            let client = Network.AsynchronousChannel(channel.read())
            client.close()
        }

        client.onClose = def [i, server] (self, channel) {
            if (++i) < 3 {
                channel.connect()
            } else {
                channel.unwatch()
                server.close()
                server.unwatch()
            }
        }

        self.expectEqual(true, server.watch())
        self.expectEqual(true, server.listen())

        self.expectEqual(true, client.watch())
        self.expectEqual(true, client.connect())

        scheduler.run()
        self.expectEqual(3, i)
    }
}
