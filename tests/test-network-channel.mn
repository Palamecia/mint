load test.case
load system.thread
load network.poller
load network.channel
load network.endpoints.ip
load network.sockets.tcp
load network.sockets.udp
load network.serializers.server
load network.serializers.datagram

@class NetworkChannelTest : Test.Case {
	const def testTcpMessage(self) {

        let endpoint = Network.IpEndpoint('127.0.0.1', 7357)

        let socket = Network.TcpSocket()
        self.expectEqual(socket.open(endpoint.getIpVersion()), true)
        socket.setSocketOption(Network.SocketOption.REUSEADDR, true)
        let server = Network.Channel(socket, Network.ServerSerializer)
        self.expectEqual(server.listen(endpoint), true)

        let client = Network.Channel(Network.TcpSocket())
        self.expectEqual(client.connect(endpoint), true)

        let remoteClient = Network.Channel(server.read())
        server.close()

        remoteClient.write('ok')
        remoteClient.close()

        let result = client.read()
        client.close()

        self.expectEqual(result, 'ok')
    }

	const def testTcpMessageEvent(self) {

        let result = 'ko'
        let poller = Network.Poller()
        let endpoint = Network.IpEndpoint('127.0.0.1', 7357)

        let socket = Network.TcpSocket()
        self.expectEqual(socket.open(endpoint.getIpVersion()), true)
        socket.setSocketOption(Network.SocketOption.REUSEADDR, true)
        let server = Network.EventChannel(socket, Network.ServerSerializer)
        server.onMessage = def [result, poller] (self, channel) {
            let client = Network.EventChannel(channel.read())
            client.onMessage = def [result, poller] (self, channel) {
                result = channel.read()
                channel.close()
                poller.unwatch(channel)
            }
            poller.watch(client)
            channel.close()
            poller.unwatch(channel)
        }

        self.expectEqual(poller.watch(server), true)
        self.expectEqual(server.listen(endpoint), true)

        let client = Network.EventChannel(Network.TcpSocket())
        client.onOpen = def (self, channel) {
            channel.write('ok')
        }
        client.onClose = def [poller] (self, channel) {
            poller.unwatch(channel)
        }

        self.expectEqual(poller.watch(client), true)
        self.expectEqual(client.connect(endpoint), true)

        poller.run()

        self.expectEqual(result, 'ok')
    }

	const def testTcpMessageAsync(self) {

        let scheduler = Runtime.Scheduler()
        let endpoint = Network.IpEndpoint('127.0.0.1', 7357)

        async def [...] serverMain() {
            let socket = Network.TcpSocket().asyncOn(scheduler)
            self.expectEqual(socket.open(endpoint.getIpVersion()), true)
            socket.setSocketOption(Network.SocketOption.REUSEADDR, true)
            let server = Network.AsyncChannel(socket, Network.AsyncServerSerializer)
            self.expectEqual(server.listen(endpoint), true)
            let client = await server.read()
            await client.write('ok')
        }

        async def [...] clientMain() {
            let client = Network.AsyncChannel(Network.TcpSocket().asyncOn(scheduler))
            self.expectEqual(await client.connect(endpoint), true)
            return await client.read()
        }

        scheduler.spawn(serverMain())

        let promise = scheduler.spawn(clientMain())
        scheduler.run()

        self.expectEqual(promise.get(), 'ok')
    }

    const def testUdpMessage(self) {

        let result = 'ko'
        let endpoint = Network.IpEndpoint('127.0.0.1', 7357)

        let socket = Network.UdpSocket()
        self.expectEqual(socket.open(endpoint.getIpVersion()), true)
        socket.setSocketOption(Network.SocketOption.REUSEADDR, true)
        let server = Network.Channel(socket, Network.DatagramSerializer)
        self.expectEqual(server.bind(endpoint), true)

        let client = Network.Channel(Network.UdpSocket(), Network.DatagramSerializer)
        self.expectEqual(client.connect(endpoint), true)

        let sender = System.Thread(def [client, result] {
            while result === 'ko' {
                client.write('ok')
                System.wait()
            }
            client.close()
        })

        sender.start()

        let datagram = none
        while not defined datagram {
            System.wait()
            datagram = server.read()
        }
        result = datagram.data().getString()
        server.close()

        self.expectEqual(result, 'ok')
    }

	const def testUdpMessageEvent(self) {

        let result = 'ko'
        let poller = Network.Poller()
        let endpoint = Network.IpEndpoint('127.0.0.1', 7357)

        let socket = Network.UdpSocket()
        self.expectEqual(socket.open(endpoint.getIpVersion()), true)
        socket.setSocketOption(Network.SocketOption.REUSEADDR, true)
        let server = Network.EventChannel(socket, Network.DatagramSerializer)
        server.onMessage = def [...] (self, channel) {
            let datagram = channel.read()
            result = datagram.data().getString()
            channel.close()
            poller.unwatch(channel)
        }

        let client = Network.EventChannel(Network.UdpSocket(), Network.DatagramSerializer)
        client.onClose = def [...] (self, channel) {
            poller.unwatch(channel)
        }

        let sender = System.Thread(def [client, result] {
            while result === 'ko' {
                client.write('ok')
                System.wait()
            }
            client.close()
        })

        self.expectEqual(poller.watch(server), true)
        self.expectEqual(server.bind(endpoint), true)

        self.expectEqual(poller.watch(client), true)
        self.expectEqual(client.connect(endpoint), true)

        sender.start()
        poller.run()

        self.expectEqual(result, 'ok')
    }

    const def testUdpMessageAsync(self) {

        let result = 'ko'
        let scheduler = Runtime.Scheduler()
        let endpoint = Network.IpEndpoint('127.0.0.1', 7357)

        async def [...] serverMain() {
            let socket = Network.UdpSocket().asyncOn(scheduler)
            self.expectEqual(socket.open(endpoint.getIpVersion()), true)
            socket.setSocketOption(Network.SocketOption.REUSEADDR, true)
            let server = Network.AsyncChannel(socket, Network.AsyncDatagramSerializer)
            self.expectEqual(server.bind(endpoint), true)
            let datagram = await server.read()
            result = datagram.data().getString()
            return result
        }

        async def [...] clientMain() {
            let client = Network.AsyncChannel(Network.UdpSocket().asyncOn(scheduler), Network.AsyncDatagramSerializer)
            self.expectEqual(await client.connect(endpoint), true)

            while result === 'ko' {
                await client.write('ok')
            }
        }

        let promise = scheduler.spawn(serverMain())
        scheduler.spawn(clientMain())
        scheduler.run()

        self.expectEqual(promise.get(), 'ok')
    }

	const def testWatch(self) {

        let i = 0
        let poller = Network.Poller()
        let endpoint = Network.IpEndpoint('127.0.0.1', 7357)
        let client = Network.EventChannel(Network.TcpSocket())
        let socket = Network.TcpSocket()
        let server = Network.EventChannel(socket, Network.ServerSerializer)

        self.expectEqual(socket.open(endpoint.getIpVersion()), true)
        socket.setSocketOption(Network.SocketOption.REUSEADDR, true)

        server.onMessage = def [result] (self, channel) {
            let client = Network.EventChannel(channel.read())
            client.close()
        }

        client.onClose = def [i, endpoint, server, poller] (self, channel) {
            if (++i) < 3 {
                channel.connect(endpoint)
            } else {
                poller.unwatch(channel)
                server.close()
                poller.unwatch(server)
            }
        }

        self.expectEqual(poller.watch(server), true)
        self.expectEqual(server.listen(endpoint), true)

        self.expectEqual(poller.watch(client), true)
        self.expectEqual(client.connect(endpoint), true)

        poller.run()
        self.expectEqual(i, 3)
    }

    const def testChannelStateAndMetadata(self) {

        let endpoint = Network.IpEndpoint('127.0.0.1', 7364)
        let socket = Network.TcpSocket()
        let server = Network.Channel(socket, Network.ServerSerializer)

        self.expectEqual(socket.open(endpoint.getIpVersion()), true)
        self.expectEqual(server.getState(), Network.Socket.State.Open)
        self.expectEqual(server.setNonBlocking(true), true)
        self.expectEqual(server.isNonBlocking(), true)

        self.expectEqual(server.listen(endpoint), true)
        self.expectEqual(server.getState(), Network.Socket.State.Listening)
        self.expectDefined(server.getSocket().getEndpoint())

        self.expectEqual(server.setNonBlocking(false), true)
        self.expectEqual(server.isNonBlocking(), false)
        server.close()
    }
}
