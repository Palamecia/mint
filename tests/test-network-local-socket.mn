load test.case
load system.file
load network.channel
load network.endpoints.local
load network.sockets.local

@class NetworkLocalSocketTest : Test.Case {
	const def testMessage(self) {

        let endpoint = Network.LocalEndpoint('test-1')

        try {
            if let path = endpoint.getPath() {
                System.File(path).remove()
            }
        }

        let server = Network.Channel(Network.LocalSocket(), Network.ServerSerializer)
        self.expectEqual(server.listen(endpoint), true)

        let client = Network.Channel(Network.LocalSocket())
        self.expectEqual(client.connect(endpoint), true)

        let remoteClient = Network.Channel(server.read())
        remoteClient.write('ok')
        let result = client.read()

        remoteClient.close()
        server.close()
        client.close()

        self.expectEqual(result, 'ok')
    }

    const def testMessageEvent(self) {

        let result = 'ko'
        let poller = Network.Poller()
        let endpoint = Network.LocalEndpoint('test-2')

        try {
            if let path = endpoint.getPath() {
                System.File(path).remove()
            } else {
                // If the path is not available, this is as named pipe: we cannot proceed with the test.
                return none
            }
        }

        let server = Network.EventChannel(Network.LocalSocket(), Network.ServerSerializer)
        server.onMessage = def [result, poller] (self, channel) {
            let client = Network.EventChannel(channel.read())
            client.onMessage = def [result, poller] (self, channel) {
                result = channel.read()
                channel.close()
                poller.unwatch(channel)
            }
            poller.watch(client)
            channel.close()
            poller.unwatch(channel)
        }

        let client = Network.EventChannel(Network.LocalSocket())
        client.onOpen = def (self, client) {
            client.write('ok')
        }
        client.onClose = def [...] (self, client) {
            poller.unwatch(client)
        }

        self.expectEqual(poller.watch(server), true)
        self.expectEqual(server.listen(endpoint), true)

        self.expectEqual(poller.watch(client), true)
        self.expectEqual(client.connect(endpoint), true)

        poller.run()
        self.expectEqual(result, 'ok')
    }

	const def testMessageAsync(self) {

        let scheduler = Runtime.Scheduler()
        let endpoint = Network.LocalEndpoint('test-3')

        try {
            if let path = endpoint.getPath() {
                System.File(path).remove()
            }
        }

        async def [...] serverMain() {
            let server = Network.AsyncChannel(Network.LocalSocket().asyncOn(scheduler), Network.AsyncServerSerializer)
            self.expectEqual(server.listen(endpoint), true)
            let client = await server.read()
            await client.write('ok')
        }

        async def [...] clientMain() {
            let client = Network.AsyncChannel(Network.LocalSocket().asyncOn(scheduler))
            self.expectEqual(await client.connect(endpoint), true)
            return await client.read()
        }

        scheduler.spawn(serverMain())

        let promise = scheduler.spawn(clientMain())
        scheduler.run()

        self.expectEqual(promise.get(), 'ok')
    }

    const def testStateAndEndpoint(self) {

        let endpoint = Network.LocalEndpoint('test-4')

        try {
            if let path = endpoint.getPath() {
                System.File(path).remove()
            }
        }

        let server = Network.Channel(Network.LocalSocket(), Network.ServerSerializer)

        self.expectEqual(server.getState(), Network.Socket.State.Unknown)
        self.expectEqual(server.listen(endpoint), true)
        self.expectEqual(server.getState(), Network.Socket.State.Listening)
        self.expectDefined(server.getSocket().getEndpoint())
        self.expectEqual(server.setNonBlocking(true), true)
        self.expectEqual(server.isNonBlocking(), true)
        self.expectEqual(server.setNonBlocking(false), true)
        self.expectEqual(server.isNonBlocking(), false)
        server.close()
    }
}
