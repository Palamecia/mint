load test.case
load runtime.scheduler
load network.endpoints.ip
load network.sockets.tcp

@class NetworkSocketTest : Test.Case {
    const def testOnTcpMessage(self) {

        let scheduler = Runtime.Scheduler()
        let endpoint = Network.IpEndpoint('127.0.0.1', 7357)

        async def [...] serverMain() {
            let server = Network.TcpSocket().asyncOn(scheduler)
            self.expectEqual(server.open(endpoint.getIpVersion()), true)
            server.setSocketOption(Network.SocketOption.REUSEADDR, true)
            self.expectEqual(server.listen(endpoint), true)
            let client = await server.accept()
            await client.write('ok')
            client.close()
            server.close()
        }

        async def [...] clientMain() {
            let client = Network.TcpSocket().asyncOn(scheduler)
            self.expectEqual(await client.connect(endpoint), true)
            let result = await client.read(def(buffer) => buffer.containsString())
            client.close()
            return result.getString()
        }

        scheduler.spawn(serverMain())

        let promise = scheduler.spawn(clientMain())
        scheduler.run()

        self.expectEqual(promise.get(), 'ok')
    }

    const def testTcpMultipleClients(self) {

        let scheduler = Runtime.Scheduler()
        let endpoint = Network.IpEndpoint('127.0.0.1', 7358)
        let results = []

        async def [...] serverMain() {

            let server = Network.TcpSocket().asyncOn(scheduler)
            self.expectEqual(server.open(endpoint.getIpVersion()), true)
            server.setSocketOption(Network.SocketOption.REUSEADDR, true)
            self.expectEqual(server.listen(endpoint), true)

            for (let i = 0, i < 3, i = i + 1) {
                let client = await server.accept()
                await client.write('ok')
                client.close()
            }

            server.close()
        }

        async def [...] clientMain() {
            let client = Network.TcpSocket().asyncOn(scheduler)
            self.expectEqual(await client.connect(endpoint), true)
            results.push((await client.read(def(buffer) => buffer.containsString())).getString())
            client.close()
        }

        scheduler.spawn(serverMain())

        scheduler.spawn(clientMain())
        scheduler.spawn(clientMain())
        scheduler.spawn(clientMain())

        scheduler.run()

        self.expectEqual(results, ['ok','ok','ok'])
    }

    const def testTcpConcurrentClients(self) {

        let scheduler = Runtime.Scheduler()
        let endpoint = Network.IpEndpoint('127.0.0.1', 7359)
        let results = []

        async def [...] serverMain() {

            let server = Network.TcpSocket().asyncOn(scheduler)
            self.expectEqual(server.open(endpoint.getIpVersion()), true)
            server.setSocketOption(Network.SocketOption.REUSEADDR, true)
            self.expectEqual(server.listen(endpoint), true)

            for (let i = 0, i < 3, i = i + 1) {
                let client = await server.accept()
                await client.write('hello')
                client.close()
            }

            server.close()
        }

        async def [...] clientMain() {
            let client = Network.TcpSocket().asyncOn(scheduler)
            self.expectEqual(await client.connect(endpoint), true)
            results.push((await client.read(def(buffer) => buffer.containsString())).getString())
            client.close()
        }

        scheduler.spawn(serverMain())

        for (let i = 0, i < 3, i = i + 1) {
            scheduler.spawn(clientMain())
        }

        scheduler.run()

        self.expectEqual(results.size(), 3)
    }

    const def testTcpBidirectional(self) {

        let scheduler = Runtime.Scheduler()
        let endpoint = Network.IpEndpoint('127.0.0.1', 7360)
        let result = ''

        async def [...] serverMain() {
            let server = Network.TcpSocket().asyncOn(scheduler)
            self.expectEqual(server.open(endpoint.getIpVersion()), true)
            server.setSocketOption(Network.SocketOption.REUSEADDR, true)
            self.expectEqual(server.listen(endpoint), true)
            let client = await server.accept()
            let message = (await client.read(def(buffer) => buffer.containsString())).getString()
            await client.write(message + ' world')
            client.close()
            server.close()
        }

        async def [...] clientMain() {
            let client = Network.TcpSocket().asyncOn(scheduler)
            self.expectEqual(await client.connect(endpoint), true)
            await client.write('hello')
            result = (await client.read(def(buffer) => buffer.containsString())).getString()
            client.close()
        }

        scheduler.spawn(serverMain())
        scheduler.spawn(clientMain())

        scheduler.run()

        self.expectEqual(result, 'hello world')
    }

    const def testTcpClientDisconnect(self) {

        let scheduler = Runtime.Scheduler()
		let endpoint = Network.IpEndpoint('127.0.0.1', 7361)

        async def [...] serverMain() {
            let server = Network.TcpSocket().asyncOn(scheduler)
            self.expectEqual(server.open(endpoint.getIpVersion()), true)
            server.setSocketOption(Network.SocketOption.REUSEADDR, true)
            self.expectEqual(server.listen(endpoint), true)
            let client = await server.accept()
            client.close()
            server.close()
        }

        async def [...] clientMain() {
            let client = Network.TcpSocket().asyncOn(scheduler)
            self.expectEqual(await client.connect(endpoint), true)
            client.close()
        }

        scheduler.spawn(serverMain())
        scheduler.spawn(clientMain())

        scheduler.run()
    }

    const def testTcpLargeMessage(self) {

        let scheduler = Runtime.Scheduler()
		let endpoint = Network.IpEndpoint('127.0.0.1', 7362)

        let message = 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
        let result = ''

        async def [...] serverMain() {
            let server = Network.TcpSocket().asyncOn(scheduler)
			self.expectEqual(server.open(endpoint.getIpVersion()), true)
			server.setSocketOption(Network.SocketOption.REUSEADDR, true)
            self.expectEqual(server.listen(endpoint), true)
            let client = await server.accept()
            await client.write(message)
            client.close()
            server.close()
        }

        async def [...] clientMain() {
            let client = Network.TcpSocket().asyncOn(scheduler)
            self.expectEqual(await client.connect(endpoint), true)
            result = (await client.read(def(buffer) => buffer.containsString())).getString()
            client.close()
        }

        scheduler.spawn(serverMain())
        scheduler.spawn(clientMain())

        scheduler.run()

        self.expectEqual(result, message)
    }

    const def testTcpAcceptLoop(self) {

        let scheduler = Runtime.Scheduler()
        let endpoint = Network.IpEndpoint('127.0.0.1', 7363)
        let results = []

        async def [...] serverMain() {

            let server = Network.TcpSocket().asyncOn(scheduler)
            self.expectEqual(server.open(endpoint.getIpVersion()), true)
            server.setSocketOption(Network.SocketOption.REUSEADDR, true)
            self.expectEqual(server.listen(endpoint), true)

            for (let i = 0, i < 2, i = i + 1) {
                let client = await server.accept()
                await client.write('ok')
                client.close()
            }

            server.close()
        }

        async def [...] clientMain() {
            let client = Network.TcpSocket().asyncOn(scheduler)
            self.expectEqual(await client.connect(endpoint), true)
            results.push((await client.read(def(buffer) => buffer.containsString())).getString())
            client.close()
        }

        scheduler.spawn(serverMain())
        scheduler.spawn(clientMain())
        scheduler.spawn(clientMain())

        scheduler.run()

        self.expectEqual(results, ['ok','ok'])
    }

    const def testTcpSocketMetadata(self) {

        let socket = Network.TcpSocket()
        let endpoint = Network.IpEndpoint('127.0.0.1', 7364)

        self.expectEqual(socket.open(endpoint.getIpVersion()), true)
        self.expectEqual(socket.getState(), Network.Socket.State.Open)
        self.expectEqual(socket.setNonBlocking(true), true)
        self.expectEqual(socket.isNonBlocking(), true)

        self.expectEqual(socket.listen(endpoint), true)
        self.expectDefined(socket.getEndpoint())

        self.expectEqual(socket.setNonBlocking(false), true)
        self.expectEqual(socket.isNonBlocking(), false)
        socket.close()
    }
}
