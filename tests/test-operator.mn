load test.case

@class OperatorRecorder {
	final record = []
	const def +(self) {
		self.record << '+(0)'
		return self
	}
	const def +(self, other) {
		self.record << '+(1)'
		return self
	}
	const def -(self) {
		self.record << '-(0)'
		return self
	}
	const def -(self, other) {
		self.record << '-(1)'
		return self
	}
	const def *(self, other) {
		self.record << '*(1)'
		return self
	}
	const def /(self, other) {
		self.record << '/(1)'
		return self
	}
	const def %(self, other) {
		self.record << '%(1)'
		return self
	}
}

class OperatorTest : Test.Case {

	const def testPriority(self) {
		var recorder = OperatorRecorder()
		-recorder * 2
		self.expectEqual(recorder.record, ['-(0)', '*(1)'])
	}

	const def testAdd(self) {

		self.expectEqual(addOperator(false, false), false)
		self.expectEqual(addOperator(false, true), true)
		self.expectEqual(addOperator(true, false), true)
		self.expectEqual(addOperator(true, true), true)
	
		self.expectEqual(addOperator(2, 2), 4)
		self.expectEqual(addOperator(2, '2'), 4)

		self.expectEqual(addOperator('2', '2'), '22')
		self.expectEqual(addOperator('2', 2), '22')
	}
	
	const def testSub(self) {
		self.expectEqual(subOperator(false, false), false)
		self.expectEqual(subOperator(false, true), true)
		self.expectEqual(subOperator(true, false), true)
		self.expectEqual(subOperator(true, true), false)
	
		self.expectEqual(subOperator(2, 2), 0)
		self.expectEqual(subOperator(2, '2'), 0)

		self.expectEqual('-' in (membersof ''), false)
	}

	const def testEq(self) {
		self.expectEqual(eqOperator(false, false), true)
		self.expectEqual(eqOperator(false, true), false)
		self.expectEqual(eqOperator(true, false), false)
		self.expectEqual(eqOperator(true, true), true)
	
		self.expectEqual(eqOperator(2, 2), true)
		self.expectEqual(eqOperator(2, '2'), true)
	}

	const def testNe(self) {
		self.expectEqual(neOperator(false, false), false)
		self.expectEqual(neOperator(false, true), true)
		self.expectEqual(neOperator(true, false), true)
		self.expectEqual(neOperator(true, true), false)
	
		self.expectEqual(neOperator(2, 2), false)
		self.expectEqual(neOperator(2, '2'), false)
	}

	const def testStrictEq(self) {
		self.expectEqual(strictEqOperator(false, false), true)
		self.expectEqual(strictEqOperator(false, true), false)
		self.expectEqual(strictEqOperator(true, false), false)
		self.expectEqual(strictEqOperator(true, true), true)
	
		self.expectEqual(strictEqOperator(2, 2), true)
		self.expectEqual(strictEqOperator(2, '2'), false)
	}

	const def testStrictNe(self) {
		self.expectEqual(strictNeOperator(false, false), false)
		self.expectEqual(strictNeOperator(false, true), true)
		self.expectEqual(strictNeOperator(true, false), true)
		self.expectEqual(strictNeOperator(true, true), false)
	
		self.expectEqual(strictNeOperator(2, 2), false)
		self.expectEqual(strictNeOperator(2, '2'), true)
	}

	const def testHashKeyCompare(self) {
		self.expectEqual(hashKeyCompareOperator(none, none), false)
		self.expectEqual(hashKeyCompareOperator(null, null), false)
		self.expectEqual(hashKeyCompareOperator(null, none), false)
		self.expectEqual(hashKeyCompareOperator(none, null), true)
	}

	const def testInExpression(self) {
		self.expectEqual(2 in [1, 2, 3], true)
		self.expectEqual(4 in [1, 2, 3], false)
		self.expectEqual(4 not in [1, 2, 3], true)

		let found = 'e' in 'test'
		self.expectEqual(found, true)
		self.expectEqual((3 in 0..5) ? 'found' : 'missing', 'found')
		self.expectEqual((2 in [1, 2, 3]) && (4 in 0..5), true)
		self.expectEqual(1 in 0..1 or 2 in 2..3, true)
		self.expectEqual(1 in 0..0 or 2 in 3..4, false)
	}

	const def testForInStillIterates(self) {
		var values = []
		for value in 0..3 {
			values << value
		}
		self.expectEqual(values, [0, 1, 2, 3])
	}
}
