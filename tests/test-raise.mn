load test.case

@class TestRaise : Test.Case {
	const def testNullException(self) {
		var i = null
		while i is null or i < 5 {
			try {
				i++
			} catch error {
				error = 0
			}
		}
		self.expectEqual(i, 5)
	}

	const def testMultiException(self) {
		for i in 0..5 {
			a = null
			try {
				a++
			} catch error {
				error = i
			}
			self.expectEqual(a, i)
		}
	}

	const def testRaiseResetScopedSymbols(self) {
		try {
			if let foo = true {
				raise foo
			}
		} catch error {
			self.expectEqual(error, true)
		}
		self.expectNotDefined(foo)
	}

	const def testRaiseWithoutCatch(self) {
		var test = 7357
		try {
			raise test
		}
		self.expectEqual(test, 7357)
	}
}