load test.case
load serializer.data-stream

@class TestDataStream : Test.Case {
	const def testGet(self) {
		
		var s = Serializer.DataStream()

		s.write(uint8(42))
		self.expectEqual(s.getUInt8(), uint8(42))
		self.expectEqual(s.getUInt8(), uint8(42))

		s.remove(s.size())
		s.write(uint32(65536))
		self.expectEqual(s.getUInt32(), uint32(65536))
		self.expectEqual(s.getUInt32(), uint32(65536))
	}

	const def testRead(self) {

		var s = Serializer.DataStream()

		s.write(uint8(42))
		self.expectEqual(s.readUInt8(), uint8(42))
		self.expectIsSame(s.readUInt8(), none)
	}

	const def testFromUtf8Bytes(self) {
		
		var s = Serializer.DataStream.fromUtf8Bytes('test', 4)

		self.expectEqual(s.size(), 4)
		self.expectEqual(s.getString(0, 4), 'test')
	}
}
