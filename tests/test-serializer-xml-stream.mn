load test.case
load serializer.xml-stream

@class TestXmlStream : Test.Case {
	const def testMultiDocument(self) {
		var s = Serializer.XmlStream('<document><test/></document><document><test/></document>')
		self.expectEqual(s.read(), Serializer.XmlStream.TokenType.StartDocument)
		self.expectEqual(s.read(), Serializer.XmlStream.TokenType.StartElement)
		self.expectEqual(s.read(), Serializer.XmlStream.TokenType.StartElement)
		self.expectEqual(s.read(), Serializer.XmlStream.TokenType.EndElement)
		self.expectEqual(s.read(), Serializer.XmlStream.TokenType.EndElement)
		self.expectEqual(s.read(), Serializer.XmlStream.TokenType.EndDocument)
		self.expectEqual(s.read(), Serializer.XmlStream.TokenType.StartDocument)
		self.expectEqual(s.read(), Serializer.XmlStream.TokenType.StartElement)
		self.expectEqual(s.read(), Serializer.XmlStream.TokenType.StartElement)
		self.expectEqual(s.read(), Serializer.XmlStream.TokenType.EndElement)
		self.expectEqual(s.read(), Serializer.XmlStream.TokenType.EndElement)
		self.expectEqual(s.read(), Serializer.XmlStream.TokenType.EndDocument)
	}
	const def testIndented(self) {
		var str = ''
		var s = Serializer.XmlStream(str)
		s.setIndented(true)
		s.write('<document><test/></document>')
		self.expectEqual(str, '<document>\n\t<test/>\n</document>\n')
		str.clear()
		s.setIndented(false)
		s.write('<document><test/></document>')
		self.expectEqual(str, '<document><test/></document>')
	}
	const def testCloseElement(self) {
		var str = ''
		var s = Serializer.XmlStream(str)
		s.setIndented(false)
		s.writeStartDocument()
		s.writeStartElement('document')
		s.writeEmptyElement('test')
		s.writeEndElement()
		s.writeEndDocument()
		self.expectEqual(str, '<document><test/></document>')
	}
	const def testCloseDocument(self) {
		var str = ''
		var s = Serializer.XmlStream(str)
		s.setIndented(false)
		s.writeStartDocument()
		s.writeStartElement('document')
		s.writeEmptyElement('test')
		s.writeEndDocument()
		self.expectEqual(str, '<document><test/></document>')
	}
}
