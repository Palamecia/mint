load test.case
load serializer.yaml-stream

@class TestYamlStream : Test.Case {
	const def testSimpleSequence(self) {
		var s = Serializer.YamlStream('---
- apple 
- banana 
- carrot 
...')
		self.expectEqual(s.read().data(), ['apple', 'banana', 'carrot'])
	}

	const def testNestedSequences(self) {
		var s = Serializer.YamlStream('---
- 
 - foo 
 - bar 
 - baz 
...')
		self.expectEqual(s.read().data(), [['foo', 'bar', 'baz']])
	}

	const def testMixedSequences(self) {
		var s = Serializer.YamlStream('---
- apple 
- 
 - foo 
 - bar 
 - x123 
- banana 
- carrot 
...')
		self.expectEqual(s.read().data(), ['apple', ['foo', 'bar', 'x123'], 'banana', 'carrot'])
	}

	const def testDeeplyNestedSequences(self) {
		var s = Serializer.YamlStream('---
- 
 - 
  - uno 
  - dos 
...')
		self.expectEqual(s.read().data(), [[['uno', 'dos']]])
	}

	const def testSimpleMapping(self) {
		var s = Serializer.YamlStream('---
foo: whatever 
bar: stuff 
...')
		self.expectEqual(s.read().data(), { 'foo' : 'whatever', 'bar' : 'stuff' })
	}

	const def testSequenceInMapping(self) {
		var s = Serializer.YamlStream('---
foo: whatever 
bar: 
 - uno 
 - dos 
...')
		self.expectEqual(s.read().data(), { 'foo' : 'whatever', 'bar' : [ 'uno', 'dos' ] })
	}

	const def testNestedMappings(self) {
		var s = Serializer.YamlStream('---
foo: whatever 
bar: 
 fruit: apple 
 name: steve 
 sport: baseball 
...')
		self.expectEqual(s.read().data(), {
			'foo' : 'whatever',  
  			'bar' : { 
				'fruit' : 'apple',  
				'name' : 'steve', 
				'sport' : 'baseball' 
	   		} 
		})
	}

	const def testMixedMapping(self) {
		var s = Serializer.YamlStream('---
foo: whatever 
bar: 
 - 
   fruit: apple 
   name: steve 
   sport: baseball 
 - more 
 - 
   python: rocks 
   perl: papers 
   ruby: scissorses 
...')
		self.expectEqual(s.read().data() , {
			'foo' : 'whatever',  
	  		'bar' : [ 
	    		{ 
	        		'fruit' : 'apple',  
	        		'name' : 'steve', 
	        		'sport' : 'baseball' 
	    		}, 
	    		'more', 
	    		{ 
	        		'python' : 'rocks', 
	        		'perl' : 'papers', 
	        		'ruby' : 'scissorses' 
	    		} 
	  		] 
		})
	}

	const def testMappingInSequenceShortcut(self) {
		var s = Serializer.YamlStream('---
- work on YAML.mn: 
   - work on Store 
...')
		self.expectEqual(s.read().data(), [ { 'work on YAML.mn' : ['work on Store'] } ])
	}

	const def testSequenceInMappingShortcut(self) {
		var s = Serializer.YamlStream("---
allow:
- 'localhost'
- '%.sourceforge.net'
- '%.freepan.org'
...")
		self.expectEqual(s.read().data(), { 'allow' : [ 'localhost', '%.sourceforge.net', '%.freepan.org' ] })
	}

	const def testMergekey(self) {
		var s = Serializer.YamlStream('---
mapping:
  name: Joe
  job: Accountant
  <<:
    age: 38
...')
		self.expectEqual(s.read().data(), {
			'mapping' : {
				'name' : 'Joe',
    			'job' : 'Accountant',
    			'age' : 38
  			}
		})
	}

	const def testSimpleInlineArray(self) {
		var s = Serializer.YamlStream('---
seq: [ a, b, c ]
...')
		self.expectEqual(s.read().data(), { 'seq' : [ 'a', 'b', 'c' ] })
	}

	const def testSimpleInlineHash(self) {
		var s = Serializer.YamlStream('---
hash: { name: Steve, foo: bar }
...')
		self.expectEqual(s.read().data(), { 'hash' : { 'name' : 'Steve', 'foo' : 'bar' } })
	}

	const def testMultiLineInlineCollections(self) {
		var s = Serializer.YamlStream('---
languages: [ Ruby, 
             Perl, 
             Python ] 
websites: { YAML: yaml.org, 
            Ruby: ruby-lang.org, 
            Python: python.org, 
            Perl: use.perl.org }
...')
		self.expectEqual(s.read().data(), {
			'languages' : [ 'Ruby', 'Perl', 'Python' ], 
  			'websites' : { 
				'YAML' : 'yaml.org', 
	    		'Ruby' : 'ruby-lang.org', 
	    		'Python' : 'python.org', 
	    		'Perl' : 'use.perl.org'  
  			} 
		})
	}

	const def testCommasInValues(self) {
		var s = Serializer.YamlStream('---
attendances: [ 45,123, 70,000, 17,222 ]
...')
		self.expectEqual(s.read().data(), { 'attendances' : [ 45123, 70000, 17222 ] })
	}

	const def testStrings(self) {
		var s = Serializer.YamlStream('--- String')
		self.expectEqual(s.read().data(), 'String')
	}

	const def testStringCharacters(self) {
		var s = Serializer.YamlStream("---
- What's Yaml? 
- It's for writing data structures in plain text. 
- And? 
- And what? That's not good enough for you? 
- No, I mean, \"And what about Yaml?\" 
- Oh, oh yeah. Uh.. Yaml for Ruby. 
...")
		self.expectEqual(s.read().data(), [
			"What's Yaml?", 
			"It's for writing data structures in plain text.", 
			"And?", 
			"And what? That's not good enough for you?", 
			"No, I mean, \"And what about Yaml?\"", 
			"Oh, oh yeah. Uh.. Yaml for Ruby." 
		])
	}

	const def testIndicatorsInStrings(self) {
		var s = Serializer.YamlStream('---
the colon followed by space is an indicator: but is a string:right here 
same for the pound sign: here we have it#in a string 
the comma can, honestly, be used in most cases: [ but not in, inline collections ]
...')
		self.expectEqual(s.read().data(), {
			'the colon followed by space is an indicator' : 'but is a string:right here', 
			'same for the pound sign' : 'here we have it#in a string', 
			'the comma can, honestly, be used in most cases' : [ 'but not in', 'inline collections' ] 
		})
	}

	const def testForcingStrings(self) {
		var s = Serializer.YamlStream('---
date string: !str 2001-08-01 
number string: !str 192 
...')
		self.expectEqual(data = s.read().data(), {
			'date string' : '2001-08-01', 
			'number string' : '192' 
		})
		self.expectEqual(typeof data['date string'], 'string')
		self.expectEqual(typeof data['number string'], 'string')
	}

	const def testSingleQuotedStrings(self) {
		var s = Serializer.YamlStream("---
all my favorite symbols: '#:!/%.)' 
a few i hate: '&(*' 
why do i hate them?: 'it''s very hard to explain' 
...")
		self.expectEqual(s.read().data(), {
			'all my favorite symbols' : '#:!/%.)', 
			'a few i hate' : '&(*', 
			'why do i hate them?' : 'it\'s very hard to explain' 
		})
	}

	const def testDoubleQuotedStrings(self) {
		var s = Serializer.YamlStream('---
i know where i want my line breaks: "one here\\nand another here\\n"
...')
		self.expectEqual(s.read().data(), {
			'i know where i want my line breaks' : "one here\nand another here\n" 
		})
	}

	const def testMultiLineQuotedStrings(self) {
		var s = Serializer.YamlStream('---
i want a long string: "so i\'m going to
  let it go on and on to other lines
  until i end it with a quote."
...')
		self.expectEqual(s.read().data(), {
			'i want a long string' : "so i'm going to " + "let it go on and on to other lines " + "until i end it with a quote." 
		})
	}

	const def testPlainScalars(self) {
		var s = Serializer.YamlStream("---
- My little toe is broken in two places;
- I'm crazy to have skied this way;
- I'm not the craziest he's seen, since there was always the German guy
  who skied for 3 hours on a broken shin bone (just below the kneecap);
- Nevertheless, second place is respectable, and he doesn't
  recommend going for the record;
- He's going to put my foot in plaster for a month;
- This would impair my skiing ability somewhat for the
  duration, as can be imagined.
...")
		self.expectEqual(s.read().data(), [
			"My little toe is broken in two places;", 
			"I'm crazy to have skied this way;", 
			"I'm not the craziest he's seen, since there was always " + "the German guy who skied for 3 hours on a broken shin " +  "bone (just below the kneecap);", 
			"Nevertheless, second place is respectable, and he doesn't " +  "recommend going for the record;", 
			"He's going to put my foot in plaster for a month;", 
			"This would impair my skiing ability somewhat for the duration, " + "as can be imagined."
		])
	}

	const def testNull(self) {
		var s = Serializer.YamlStream('---
name: Mr. Show 
hosted by: Bob and David 
date of next season: ~ 
...')
		self.expectEqual(s.read().data(), {
			'name' : 'Mr. Show', 
			'hosted by' : 'Bob and David', 
			'date of next season' : null
		})
	}

	const def testBoolean(self) {
		var s = Serializer.YamlStream('---
Is Gus a Liar?: true
Do I rely on Gus for Sustenance?: false
...')
		self.expectEqual(s.read().data(), {
			'Is Gus a Liar?' : true, 
			'Do I rely on Gus for Sustenance?' : false 
		})
	}

	const def testIntegers(self) {
		var s = Serializer.YamlStream('---
zero: 0 
simple: 12 
one-thousand: 1,000 
negative one-thousand: -1,000 
...')
		self.expectEqual(s.read().data(), {
			'zero' : 0, 
			'simple' : 12, 
			'one-thousand' : 1000, 
			'negative one-thousand' : -1000 
		})
	}

	const def testIntegersAsMapKeys(self) {
		var s = Serializer.YamlStream('---
1: one 
2: two 
3: three 
...')
		self.expectEqual(s.read().data(), {
			1 : 'one', 
			2 : 'two', 
			3 : 'three' 
		})
	}

	const def testFloats(self) {
		var s = Serializer.YamlStream('---
a simple float: 2.00 
larger float: 1,000.09 
scientific notation: 1.00009e+3
...')
		self.expectEqual(s.read().data(), {
			'a simple float' : 2.0, 
			'larger float' : 1000.09, 
			'scientific notation' : 1.00009e+3
		})
	}

	const def testTime(self) {
		var s = Serializer.YamlStream('---
iso8601: 2001-12-14t21:59:43.10-05:00 
space seperated: 2001-12-14 21:59:43.10 -05:00
...')
		self.expectEqual(s.read().data(), {
			'iso8601' : System.Date(2001, 12, 14, 21, 59, 43, 10, "-05:00"), 
			'space seperated' : System.Date(2001, 12, 14, 21, 59, 43, 10, "-05:00") 
		})
	}

	const def testDate(self) {
		var s = Serializer.YamlStream('--- 1976-07-31')
		self.expectEqual(s.read().data(), System.Date(1976, 07, 31))
	}

	const def testSingleEndingNewline(self) {
		var s = Serializer.YamlStream('---
this: |
    Foo
    Bar
...')
		self.expectEqual(s.read().data(), { 'this' : "Foo\nBar\n" })
	}

	const def testThePlusIndicator(self) {
		var s = Serializer.YamlStream('---
normal: |
  extra new lines not kept

preserving: |+
  extra new lines are kept


dummy: value
...')
		self.expectEqual(s.read().data(), {
			'normal' : "extra new lines not kept\n", 
			'preserving' : "extra new lines are kept\n\n\n", 
			'dummy' : 'value' 
		})
	}

	const def testThreeTrailingNewlinesInLiterals(self) {
		var s = Serializer.YamlStream('---
clipped: |
    This has one newline.



same as "clipped" above: "This has one newline.\\n"

stripped: |-
    This has no newline.



same as "stripped" above: "This has no newline."

kept: |+
    This has four newlines.



same as "kept" above: "This has four newlines.\\n\\n\\n\\n"
...')
		self.expectEqual(s.read().data(), {
			'clipped' : "This has one newline.\n", 
			'same as "clipped" above' : "This has one newline.\n", 
			'stripped' : 'This has no newline.', 
			'same as "stripped" above' : 'This has no newline.', 
			'kept' : "This has four newlines.\n\n\n\n", 
			'same as "kept" above' : "This has four newlines.\n\n\n\n"
		})
	}

	const def testExtraTrailingNewlinesWithSpaces(self) {
		var s = Serializer.YamlStream('---
this: |
    Foo

    
kept: |+
    Foo

    ')
		self.expectEqual(s.read().data(), {
			'this' : "Foo\n\n    \n",  
			'kept' : "Foo\n\n    \n"
		})
	}

	const def testFoldedBlockInSequence(self) {
		var s = Serializer.YamlStream("---
- apple
- banana
- >
    can't you see
    the beauty of yaml?
    hmm
- dog
...")
		self.expectEqual(s.read().data(), [
			'apple',  
			'banana',  
			"can't you see the beauty of yaml? hmm\n", 
			'dog' 
		])
	}

	const def testFoldedBlockAsMappingValue(self) {
		var s = Serializer.YamlStream("---
quote: >
    Mark McGwire's
    year was crippled
    by a knee injury.
source: espn
...")
		self.expectEqual(s.read().data(), {
			'quote' : "Mark McGwire's year was crippled by a knee injury.\n", 
			'source' : 'espn' 
		})
	}

	const def testThreeTrailingNewlinesInFoldedBlocks(self) {
		var s = Serializer.YamlStream('---
clipped: >
    This has one newline.



same as "clipped" above: "This has one newline.\\n" 

stripped: >-
    This has no newline.



same as "stripped" above: "This has no newline."

kept: >+
    This has four newlines.



same as "kept" above: "This has four newlines.\\n\\n\\n\\n"
...')
		self.expectEqual(s.read().data(), {
			'clipped' : "This has one newline.\n", 
			'same as "clipped" above' : "This has one newline.\n", 
			'stripped' : 'This has no newline.', 
			'same as "stripped" above' : 'This has no newline.', 
			'kept' : "This has four newlines.\n\n\n\n", 
			'same as "kept" above' : "This has four newlines.\n\n\n\n" 
		})
	}

	const def testSimpleAliasExample(self) {
		var s = Serializer.YamlStream('---
- &showell Steve 
- Clark 
- Brian 
- Oren 
- *showell 
...')

		showell = 'Steve'

		self.expectEqual(s.read().data(), [ showell, 'Clark', 'Brian', 'Oren', showell ])
	}

	const def testAliasOfMapping(self) {
		var s = Serializer.YamlStream('---
- &hello 
    Meat: pork 
    Starch: potato 
- banana 
- *hello 
...')

		hello = { 'Meat' : 'pork', 'Starch' : 'potato' } 

		self.expectEqual(s.read().data(), [
			hello,  
			'banana', 
			hello 
		])
	}

	const def testTrailingDocumentSeparator(self) {
		var s = Serializer.YamlStream('---
- foo: 1
  bar: 2
---
more: stuff
...')

		self.expectEqual(s.read().data(), [ { 'foo' : 1, 'bar' : 2 } ])
		self.expectEqual(s.read().data(), { 'more' : 'stuff' })
	}

	const def testYamlHeader(self) {
		var s = Serializer.YamlStream('--- %YAML:1.0 
foo: 1 
bar: 2 
...')

		self.expectEqual(typeof s.read(), 'Serializer.YamlDirective')
		self.expectEqual(s.read().data(), { 'foo' : 1, 'bar' : 2 })
	}

	const def testRedHerringDocumentSeparator(self) {
		var s = Serializer.YamlStream('---
foo: |
    ---
...')

		self.expectEqual(s.read().data(), { 'foo' : "---\n" })
	}

	const def testMultipleDocumentSeparatorsInBlock(self) {
		var s = Serializer.YamlStream('---
foo: | 
    ---
    foo: bar
    ---
    yo: baz
bar: | 
    fooness
...')

		self.expectEqual(s.read().data(), {
			'foo' : "---\nfoo: bar\n---\nyo: baz\n", 
			'bar' : "fooness\n" 
		})
	}
}
