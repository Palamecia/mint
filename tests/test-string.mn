load test.case
load mint.string

@class StringTest : Test.Case {
    const def testReplace(self) {
        self.expectEqual('replace this string'.replace('this', 'that'), 'replace that string')
        self.expectEqual('replace this string'.replace(8, 4, 'that'), 'replace that string')
    }

    const def testPercentFormat(self) {

        // --- Basic substitution ---
        self.expectEqual('Hello %s' % 'Mint', 'Hello Mint')

        // --- Multiple values ---
        self.expectEqual('%d %d' % (1, 2), '1 2')

        // --- Float formatting ---
        self.expectEqual('%.2f' % 3.14159, '3.14')

        // --- Padding ---
        self.expectEqual('%04d' % 7, '0007')

        // --- Left align ---
        self.expectEqual('%-4d' % 7, '7   ')

        // --- String ---
        self.expectEqual('value: %s' % 'test', 'value: test')

        // --- Mixed ---
        self.expectEqual('x=%d y=%.2f' % (10, 3.5), 'x=10 y=3.50')
    }

    const def testBraceFormat(self) {

        // --- Basic substitution ---
        self.expectEqual('Hello {}'.format('Mint'), 'Hello Mint')
        self.expectEqual('{:04} {:.2f}'.format(7, 3.5), '0007 3.50')
        self.expectEqual('{1} then {0}'.format('left', 'right'), 'right then left')
        self.expectEqual('{{{}}}'.format('ok'), '{ok}')

        // --- Multiple arguments ---
        self.expectEqual('{} {} {}'.format(1, 2, 3), '1 2 3')

        // --- Mixed indexing and automatic ---
        self.expectEqual('{0} {} {0} {}'.format('a', 'b'), 'a a a b')

        // --- Reuse same argument ---
        self.expectEqual('{0} {0} {0}'.format('x'), 'x x x')

        // --- Large index ---
        self.expectEqual('{2}'.format('a', 'b', 'last'), 'last')

        // --- Negative numbers ---
        self.expectEqual('{:05}'.format(-42), '-0042')

        // --- Float rounding ---
        self.expectEqual('{:.2f}'.format(3.14159), '3.14')

        // --- Float no decimals ---
        self.expectEqual('{:.0f}'.format(3.6), '4')

        // --- String formatting fallback ---
        self.expectEqual('value: {}'.format('test'), 'value: test')

        // --- Empty format ---
        self.expectEqual(''.format(), '')

        // --- No placeholders ---
        self.expectEqual('hello'.format(1, 2, 3), 'hello')

        // --- Escaped braces ---
        self.expectEqual('{{}}'.format(), '{}')
        self.expectEqual('{{{}}}'.format('x'), '{x}')

        // --- Nested braces stress ---
        self.expectEqual('{{{} {}}}'.format('a', 'b'), '{a b}')
    }
}
