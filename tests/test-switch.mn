load test.case

@class RangeSwitch : Test.Case {
    const def testSwitchGenerator(self) {
        let i =: switch 5 {
        case 5:
            yield '5'
            break
        default:
            yield ''
            break
        }
        self.expectEqual('5', i)
    }

    const def testSwitchArrowGenerator(self) {
        let i =: switch 5 {
            case 5 => '5'
            default => ''
        }
        self.expectEqual('5', i)
    }

    const def testReturnSwitchExpression(self) {
        def greet(tone) {
            return switch tone {
                case 'friendly' => 'Hello'
                case 'formal' => 'Greetings'
                default => 'Hi'
            }
        }

        self.expectEqual('Hello', greet('friendly'))
        self.expectEqual('Greetings', greet('formal'))
        self.expectEqual('Hi', greet('other'))
    }
}
