load test.case

@class RangeSwitch : Test.Case {
    const def testSwitchGenerator(self) {
        let i =: switch 5 {
        case 5:
            yield '5'
            break
        default:
            yield ''
            break
        }
        self.expectEqual(i, '5')
    }

    const def testSwitchArrowGenerator(self) {
        let i =: switch 5 {
            case 5 => '5'
            default => ''
        }
        self.expectEqual(i, '5')
    }

    const def testReturnSwitchExpression(self) {
        def greet(tone) {
            return switch tone {
                case 'friendly' => 'Hello'
                case 'formal' => 'Greetings'
                default => 'Hi'
            }
        }

        self.expectEqual(greet('friendly'), 'Hello')
        self.expectEqual(greet('formal'), 'Greetings')
        self.expectEqual(greet('other'), 'Hi')
    }

    const def testFunctionDefinedInCaseBody(self) {
        let result = 0
        switch 1 {
        case 1:
            let nested = def() {
                return 42
            }
            result = nested()
        }
        self.expectEqual(result, 42)
    }

    const def testContinueFromCaseBody(self) {
        let values = []
        for let i in 0..5 {
            switch i {
            case 2:
                continue
            }
            values.push(i)
        }
        self.expectEqual(values, [0, 1, 3, 4, 5])
    }

    const def testContinueFromNestedCaseBody(self) {
        let values = []
        switch true {
        case true:
            for let i in 0..5 {
                switch i {
                case 2:
                    continue
                }
                values.push(i)
            }
        }
        self.expectEqual(values, [0, 1, 3, 4, 5])
    }
}
