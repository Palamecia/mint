load test.case
load system.date

@class DateTest : Test.Case {
	const def testLeapYear(self) {
		self.expectEqual(System.Date.isLeap(1970), false)
		self.expectEqual(System.Date.isLeap(1971), false)
		self.expectEqual(System.Date.isLeap(1972), true)
		self.expectEqual(System.Date.isLeap(1973), false)
	}

	const def testAddMonth(self) {
		self.expectDefined(System.TimeZone.current())
		date = System.Date(1970, 1, 1)
		self.expectDefined(date)
		self.expectEqual(date.getMonth(), 1)
		date = date.addMonths(5)
		self.expectEqual(date.getMonth(), 6)
		date = date.addMonths(6)
		self.expectEqual(date.getMonth(), 12)
		date = date.addMonths(1)
		self.expectEqual(date.getMonth(), 1)
		self.expectEqual(date.getYear(), 1971)
		date = date.addMonths(-30)
		self.expectEqual(date.getMonth(), 7)
		self.expectEqual(date.getYear(), 1968)
		date = date.addMonths(30)
		self.expectEqual(date.getMonth(), 1)
		self.expectEqual(date.getYear(), 1971)
	}

	const def testParseIsoDate(self) {

		const SecondsPerDay = 86400

		self.expectEqual(System.Date("2022").toSeconds() / SecondsPerDay, 18993)
		self.expectEqual(System.Date("202203").toSeconds() / SecondsPerDay, 19052)
		self.expectEqual(System.Date("2022-03").toSeconds() / SecondsPerDay, 19052)
		self.expectEqual(System.Date("20220317").toSeconds() / SecondsPerDay, 19068)
		self.expectEqual(System.Date("2022-03-17").toSeconds() / SecondsPerDay, 19068)
		self.expectEqual(System.Date("2022W114").toSeconds() / SecondsPerDay, 19068)
		self.expectEqual(System.Date("2022-W11-4").toSeconds() / SecondsPerDay, 19068)
		self.expectEqual(System.Date("2022-03-17T12").toSeconds(), 1647518400)
		self.expectEqual(System.Date("2022-03-17T12Z").toSeconds(), 1647518400)
		self.expectEqual(System.Date("2022-03-17T12+0100").toSeconds(), 1647514800)
		self.expectEqual(System.Date("2022-03-17T12+0130").toSeconds(), 1647513000)
		self.expectEqual(System.Date("2022-03-17T12-0100").toSeconds(), 1647522000)
		self.expectEqual(System.Date("2022-03-17T12-0130").toSeconds(), 1647523800)
		self.expectEqual(System.Date("2022-03-17T12+01:00").toSeconds(), 1647514800)
		self.expectEqual(System.Date("2022-03-17T12+01:30").toSeconds(), 1647513000)
		self.expectEqual(System.Date("2022-03-17T12-01:00").toSeconds(), 1647522000)
		self.expectEqual(System.Date("2022-03-17T12-01:30").toSeconds(), 1647523800)
		self.expectEqual(System.Date("2022-03-17T1230").toSeconds(), 1647520200)
		self.expectEqual(System.Date("2022-03-17T1230Z").toSeconds(), 1647520200)
		self.expectEqual(System.Date("2022-03-17T1230+0100").toSeconds(), 1647516600)
		self.expectEqual(System.Date("2022-03-17T1230+0130").toSeconds(), 1647514800)
		self.expectEqual(System.Date("2022-03-17T1230-0100").toSeconds(), 1647523800)
		self.expectEqual(System.Date("2022-03-17T1230-0130").toSeconds(), 1647525600)
		self.expectEqual(System.Date("2022-03-17T1230+01:00").toSeconds(), 1647516600)
		self.expectEqual(System.Date("2022-03-17T1230+01:30").toSeconds(), 1647514800)
		self.expectEqual(System.Date("2022-03-17T1230-01:00").toSeconds(), 1647523800)
		self.expectEqual(System.Date("2022-03-17T1230-01:30").toSeconds(), 1647525600)
		self.expectEqual(System.Date("2022-03-17T12:30").toSeconds(), 1647520200)
		self.expectEqual(System.Date("2022-03-17T12:30Z").toSeconds(), 1647520200)
		self.expectEqual(System.Date("2022-03-17T12:30+0100").toSeconds(), 1647516600)
		self.expectEqual(System.Date("2022-03-17T12:30+0130").toSeconds(), 1647514800)
		self.expectEqual(System.Date("2022-03-17T12:30-0100").toSeconds(), 1647523800)
		self.expectEqual(System.Date("2022-03-17T12:30-0130").toSeconds(), 1647525600)
		self.expectEqual(System.Date("2022-03-17T12:30+01:00").toSeconds(), 1647516600)
		self.expectEqual(System.Date("2022-03-17T12:30+01:30").toSeconds(), 1647514800)
		self.expectEqual(System.Date("2022-03-17T12:30-01:00").toSeconds(), 1647523800)
		self.expectEqual(System.Date("2022-03-17T12:30-01:30").toSeconds(), 1647525600)
		self.expectEqual(System.Date("2022-03-17T123055").toSeconds(), 1647520255)
		self.expectEqual(System.Date("2022-03-17T123055Z").toSeconds(), 1647520255)
		self.expectEqual(System.Date("2022-03-17T123055+0100").toSeconds(), 1647516655)
		self.expectEqual(System.Date("2022-03-17T123055+0130").toSeconds(), 1647514855)
		self.expectEqual(System.Date("2022-03-17T123055-0100").toSeconds(), 1647523855)
		self.expectEqual(System.Date("2022-03-17T123055-0130").toSeconds(), 1647525655)
		self.expectEqual(System.Date("2022-03-17T123055+01:00").toSeconds(), 1647516655)
		self.expectEqual(System.Date("2022-03-17T123055+01:30").toSeconds(), 1647514855)
		self.expectEqual(System.Date("2022-03-17T123055-01:00").toSeconds(), 1647523855)
		self.expectEqual(System.Date("2022-03-17T123055-01:30").toSeconds(), 1647525655)
		self.expectEqual(System.Date("2022-03-17T12:30:55").toSeconds(), 1647520255)
		self.expectEqual(System.Date("2022-03-17T12:30:55Z").toSeconds(), 1647520255)
		self.expectEqual(System.Date("2022-03-17T12:30:55+0100").toSeconds(), 1647516655)
		self.expectEqual(System.Date("2022-03-17T12:30:55+0130").toSeconds(), 1647514855)
		self.expectEqual(System.Date("2022-03-17T12:30:55-0100").toSeconds(), 1647523855)
		self.expectEqual(System.Date("2022-03-17T12:30:55-0130").toSeconds(), 1647525655)
		self.expectEqual(System.Date("2022-03-17T12:30:55+01:00").toSeconds(), 1647516655)
		self.expectEqual(System.Date("2022-03-17T12:30:55+01:30").toSeconds(), 1647514855)
		self.expectEqual(System.Date("2022-03-17T12:30:55-01:00").toSeconds(), 1647523855)
		self.expectEqual(System.Date("2022-03-17T12:30:55-01:30").toSeconds(), 1647525655)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25").toSeconds(), 1647520255)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25").getMilliseconds(), 250)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25Z").toSeconds(), 1647520255)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25+0100").toSeconds(), 1647516655)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25+0130").toSeconds(), 1647514855)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25-0100").toSeconds(), 1647523855)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25-0130").toSeconds(), 1647525655)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25+01:00").toSeconds(), 1647516655)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25+01:30").toSeconds(), 1647514855)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25-01:00").toSeconds(), 1647523855)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25-01:30").toSeconds(), 1647525655)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25Z").getMilliseconds(), 250)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25753").toSeconds(), 1647520255)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25753").getMilliseconds(), 257)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25753Z").toSeconds(), 1647520255)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25753+0100").toSeconds(), 1647516655)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25753+0130").toSeconds(), 1647514855)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25753-0100").toSeconds(), 1647523855)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25753-0130").toSeconds(), 1647525655)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25753+01:00").toSeconds(), 1647516655)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25753+01:30").toSeconds(), 1647514855)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25753-01:00").toSeconds(), 1647523855)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25753-01:30").toSeconds(), 1647525655)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25753Z").getMilliseconds(), 257)
		self.expectEqual(System.Date("T12").toSeconds() % SecondsPerDay, 43200)
		self.expectEqual(System.Date("T12Z").toSeconds() % SecondsPerDay, 43200)
		self.expectEqual(System.Date("T12+0100").toSeconds() % SecondsPerDay, 39600)
		self.expectEqual(System.Date("T12+0130").toSeconds() % SecondsPerDay, 37800)
		self.expectEqual(System.Date("T12-0100").toSeconds() % SecondsPerDay, 46800)
		self.expectEqual(System.Date("T12-0130").toSeconds() % SecondsPerDay, 48600)
		self.expectEqual(System.Date("T12+01:00").toSeconds() % SecondsPerDay, 39600)
		self.expectEqual(System.Date("T12+01:30").toSeconds() % SecondsPerDay, 37800)
		self.expectEqual(System.Date("T12-01:00").toSeconds() % SecondsPerDay, 46800)
		self.expectEqual(System.Date("T12-01:30").toSeconds() % SecondsPerDay, 48600)
		self.expectEqual(System.Date("T1230").toSeconds() % SecondsPerDay, 45000)
		self.expectEqual(System.Date("T1230Z").toSeconds() % SecondsPerDay, 45000)
		self.expectEqual(System.Date("T1230+0100").toSeconds() % SecondsPerDay, 41400)
		self.expectEqual(System.Date("T1230+0130").toSeconds() % SecondsPerDay, 39600)
		self.expectEqual(System.Date("T1230-0100").toSeconds() % SecondsPerDay, 48600)
		self.expectEqual(System.Date("T1230-0130").toSeconds() % SecondsPerDay, 50400)
		self.expectEqual(System.Date("T1230+01:00").toSeconds() % SecondsPerDay, 41400)
		self.expectEqual(System.Date("T1230+01:30").toSeconds() % SecondsPerDay, 39600)
		self.expectEqual(System.Date("T1230-01:00").toSeconds() % SecondsPerDay, 48600)
		self.expectEqual(System.Date("T1230-01:30").toSeconds() % SecondsPerDay, 50400)
		self.expectEqual(System.Date("12:30").toSeconds() % SecondsPerDay, 45000)
		self.expectEqual(System.Date("T12:30").toSeconds() % SecondsPerDay, 45000)
		self.expectEqual(System.Date("T12:30Z").toSeconds() % SecondsPerDay, 45000)
		self.expectEqual(System.Date("T12:30+0100").toSeconds() % SecondsPerDay, 41400)
		self.expectEqual(System.Date("T12:30+0130").toSeconds() % SecondsPerDay, 39600)
		self.expectEqual(System.Date("T12:30-0100").toSeconds() % SecondsPerDay, 48600)
		self.expectEqual(System.Date("T12:30-0130").toSeconds() % SecondsPerDay, 50400)
		self.expectEqual(System.Date("T12:30+01:00").toSeconds() % SecondsPerDay, 41400)
		self.expectEqual(System.Date("T12:30+01:30").toSeconds() % SecondsPerDay, 39600)
		self.expectEqual(System.Date("T12:30-01:00").toSeconds() % SecondsPerDay, 48600)
		self.expectEqual(System.Date("T12:30-01:30").toSeconds() % SecondsPerDay, 50400)
		self.expectEqual(System.Date("T123055").toSeconds() % SecondsPerDay, 45055)
		self.expectEqual(System.Date("T123055Z").toSeconds() % SecondsPerDay, 45055)
		self.expectEqual(System.Date("T123055+0100").toSeconds() % SecondsPerDay, 41455)
		self.expectEqual(System.Date("T123055+0130").toSeconds() % SecondsPerDay, 39655)
		self.expectEqual(System.Date("T123055-0100").toSeconds() % SecondsPerDay, 48655)
		self.expectEqual(System.Date("T123055-0130").toSeconds() % SecondsPerDay, 50455)
		self.expectEqual(System.Date("T123055+01:00").toSeconds() % SecondsPerDay, 41455)
		self.expectEqual(System.Date("T123055+01:30").toSeconds() % SecondsPerDay, 39655)
		self.expectEqual(System.Date("T123055-01:00").toSeconds() % SecondsPerDay, 48655)
		self.expectEqual(System.Date("T123055-01:30").toSeconds() % SecondsPerDay, 50455)
		self.expectEqual(System.Date("12:30:55").toSeconds() % SecondsPerDay, 45055)
		self.expectEqual(System.Date("T12:30:55").toSeconds() % SecondsPerDay, 45055)
		self.expectEqual(System.Date("T12:30:55Z").toSeconds() % SecondsPerDay, 45055)
		self.expectEqual(System.Date("T12:30:55").toSeconds() % SecondsPerDay, 45055)
		self.expectEqual(System.Date("T12:30:55Z").toSeconds() % SecondsPerDay, 45055)
		self.expectEqual(System.Date("T12:30:55+0100").toSeconds() % SecondsPerDay, 41455)
		self.expectEqual(System.Date("T12:30:55+0130").toSeconds() % SecondsPerDay, 39655)
		self.expectEqual(System.Date("T12:30:55-0100").toSeconds() % SecondsPerDay, 48655)
		self.expectEqual(System.Date("T12:30:55-0130").toSeconds() % SecondsPerDay, 50455)
		self.expectEqual(System.Date("T12:30:55+01:00").toSeconds() % SecondsPerDay, 41455)
		self.expectEqual(System.Date("T12:30:55+01:30").toSeconds() % SecondsPerDay, 39655)
		self.expectEqual(System.Date("T12:30:55-01:00").toSeconds() % SecondsPerDay, 48655)
		self.expectEqual(System.Date("T12:30:55-01:30").toSeconds() % SecondsPerDay, 50455)
		self.expectEqual(System.Date("T12:30:55.25").toSeconds() % SecondsPerDay, 45055)
		self.expectEqual(System.Date("T12:30:55.25").getMilliseconds(), 250)
		self.expectEqual(System.Date("T12:30:55.25Z").toSeconds() % SecondsPerDay, 45055)
		self.expectEqual(System.Date("T12:30:55.25+0100").toSeconds() % SecondsPerDay, 41455)
		self.expectEqual(System.Date("T12:30:55.25+0130").toSeconds() % SecondsPerDay, 39655)
		self.expectEqual(System.Date("T12:30:55.25-0100").toSeconds() % SecondsPerDay, 48655)
		self.expectEqual(System.Date("T12:30:55.25-0130").toSeconds() % SecondsPerDay, 50455)
		self.expectEqual(System.Date("T12:30:55.25+01:00").toSeconds() % SecondsPerDay, 41455)
		self.expectEqual(System.Date("T12:30:55.25+01:30").toSeconds() % SecondsPerDay, 39655)
		self.expectEqual(System.Date("T12:30:55.25-01:00").toSeconds() % SecondsPerDay, 48655)
		self.expectEqual(System.Date("T12:30:55.25-01:30").toSeconds() % SecondsPerDay, 50455)
		self.expectEqual(System.Date("T12:30:55.25Z").getMilliseconds(), 250)
		self.expectEqual(System.Date("T12:30:55.25753").toSeconds() % SecondsPerDay, 45055)
		self.expectEqual(System.Date("T12:30:55.25753").getMilliseconds(), 257)
		self.expectEqual(System.Date("2022-03-17T12:30:55.25753Z").toSeconds() % SecondsPerDay, 45055)
		self.expectEqual(System.Date("T12:30:55.25753Z").getMilliseconds(), 257)
		self.expectEqual(System.Date("T12:30:55.25753+0100").toSeconds() % SecondsPerDay, 41455)
		self.expectEqual(System.Date("T12:30:55.25753+0130").toSeconds() % SecondsPerDay, 39655)
		self.expectEqual(System.Date("T12:30:55.25753-0100").toSeconds() % SecondsPerDay, 48655)
		self.expectEqual(System.Date("T12:30:55.25753-0130").toSeconds() % SecondsPerDay, 50455)
		self.expectEqual(System.Date("T12:30:55.25753+01:00").toSeconds() % SecondsPerDay, 41455)
		self.expectEqual(System.Date("T12:30:55.25753+01:30").toSeconds() % SecondsPerDay, 39655)
