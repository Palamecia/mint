load test.case
load system.event
load system.poller

@class EventTest : Test.Case {
    const def testTriggerAndNotification(self) {

        let poller = System.Poller()
        let event = System.Event()
        let triggerCount = 0

        self.expectEqual(poller.watch(event, def [...] {
            ++triggerCount
        }), true)

        self.expectEqual(poller.poll(0), false)
        self.expectEqual(triggerCount, 0)

        event.set()

        self.expectEqual(poller.poll(0), true)
        self.expectEqual(triggerCount, 1)

        self.expectEqual(poller.poll(0), false)
    }
}
