load test.case
load system.file
load system.filesystem
load serializer.text-stream

@class FileTest : Test.Case {
	const def testOpenClose(self) {

		let f = System.FileStream()
		self.expectEqual(false, f.isOpen())

		f.open(System.FS.getStandardPath(System.StandardPath.Temporary, 'test'), 'w')
		self.expectEqual(true, f.isOpen())

		f.close()
		self.expectEqual(false, f.isOpen())

		f.open(System.FS.getStandardPath(System.StandardPath.Temporary, 'test'), 'w')
		self.expectEqual(true, f.isOpen())
	}

	const def testReadWrite(self) {
		
		let writeFile = System.open(System.FS.getStandardPath(System.StandardPath.Temporary, 'test'), 'w')
		self.expectEqual('System.FileStream', typeof writeFile)
		self.expectEqual(true, writeFile.isOpen())

		let writeStream = Serializer.TextStream(writeFile)
		self.expectEqual('Serializer.TextStream', typeof writeStream)
		print(writeStream, 'test')
		writeFile.close()

		let readFile = System.open(System.FS.getStandardPath(System.StandardPath.Temporary, 'test'))
		self.expectEqual('System.FileStream', typeof readFile)
		self.expectEqual(true, readFile.isOpen())

		let readStream = Serializer.TextStream(readFile)
		self.expectEqual('Serializer.TextStream', typeof readStream)
		self.expectEqual('test', readStream.read())
	}
}
