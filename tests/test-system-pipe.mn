load test.case
load system.pipe
load system.poller

@class PipeTest : Test.Case {
    const def testDataCommunication(self) {

        let poller = System.Poller()
        let pipe = System.Pipe()

        self.expectEqual(poller.watch(pipe, def {}), true)

        pipe.write("hello")
        self.expectEqual(poller.poll(0), true)

        let data = pipe.read()
        self.expectEqual(poller.poll(0), false)
    }
}
