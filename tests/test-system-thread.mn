load test.case
load system.thread
load mint.coroutine

@class ThreadTest : Test.Case {
	const def testMutexType(self) {
		self.expectIsSame(System.Mutex().getKind(), System.Mutex.Kind.Normal)
		self.expectIsSame(System.Mutex(System.Mutex.Kind.Normal).getKind(), System.Mutex.Kind.Normal)
		self.expectIsSame(System.Mutex(System.Mutex.Kind.Recursive).getKind(), System.Mutex.Kind.Recursive)
	}

	const def testSharedReference(self) {

		var i = 0
		var m = System.Mutex()
		var t = System.Thread(def [i] (m) {
			m.lock()
			for i in 0..100 {
				m.unlock()
				System.wait()
				m.lock()
			}
			m.unlock()
		})

		var v = 0
		t.start(m)

		m.lock()
		while v < 100 {
			m.unlock()
			System.wait()
			m.lock()
			v = i
		}
		m.unlock()

		self.expectEqual(v, 100)
	}

	const def testSpawn(self) {
		let f = System.spawn(def {
			return 42
		})
		self.expectEqual(typeof f, 'System.Promise')
		self.expectEqual(f.get(), 42)
	}

	const def testSpawnMethod(self) {
		class ThreadTestSpawnMethod {
			const def run(self) {
				return 42
			}
		}
		let o = ThreadTestSpawnMethod()
		let f = System.spawnMethod(o, o.run)
		self.expectEqual(typeof f, 'System.Promise')
		self.expectEqual(f.get(), 42)
	}

	const def testSpawnAsync(self) {
		let f = System.spawnAsync(async def {
			return 42
		}())
		self.expectEqual(typeof f, 'System.Promise')
		self.expectEqual(f.get(), 42)
	}

	const def testSpawnImediateAsync(self) {
		let f = System.spawnAsync(42)
		self.expectEqual(typeof f, 'System.Promise')
		self.expectEqual(f.get(), 42)
	}

	const def testSpawnAwait(self) {
		let f = spawn(async def {
			let p = System.spawn(def {
				return 42
			})
			return await p
		}())
		self.expectEqual(typeof f, 'number')
		self.expectEqual(f, 42)
	}
}
