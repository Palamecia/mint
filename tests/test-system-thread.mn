load test.case
load system.thread
load mint.coroutine

@class ThreadTest : Test.Case {
	const def testMutexType(self) {
		self.expectIsSame(System.Mutex.Type.Normal, System.Mutex().getType())
		self.expectIsSame(System.Mutex.Type.Normal, System.Mutex(System.Mutex.Type.Normal).getType())
		self.expectIsSame(System.Mutex.Type.Recursive, System.Mutex(System.Mutex.Type.Recursive).getType())
	}

	const def testSharedReference(self) {

		var i = 0
		var m = System.Mutex()
		var t = System.Thread(def [i] (m) {
			m.lock()
			for i in 0..100 {
				m.unlock()
				System.wait()
				m.lock()
			}
			m.unlock()
		})

		var v = 0
		t.start(m)

		m.lock()
		while v < 100 {
			m.unlock()
			System.wait()
			m.lock()
			v = i
		}
		m.unlock()

		self.expectEqual(100, v)
	}

	const def testSpawn(self) {
		let f = System.spawn(def {
			return 42
		})
		self.expectEqual('System.Promise', typeof f)
		self.expectEqual(42, f.get())
	}

	const def testSpawnMethod(self) {
		class ThreadTestSpawnMethod {
			const def run(self) {
				return 42
			}
		}
		let o = ThreadTestSpawnMethod()
		let f = System.spawnMethod(o, o.run)
		self.expectEqual('System.Promise', typeof f)
		self.expectEqual(42, f.get())
	}

	const def testSpawnAsync(self) {
		let f = System.spawnAsync(async def {
			return 42
		}())
		self.expectEqual('System.Promise', typeof f)
		self.expectEqual(42, f.get())
	}

	const def testSpawnImediateAsync(self) {
		let f = System.spawnAsync(42)
		self.expectEqual('System.Promise', typeof f)
		self.expectEqual(42, f.get())
	}

	const def testSpawnAwait(self) {
		let f = spawn(async def {
			let p = System.spawn(def {
				return 42
			})
			return await p
		}())
		self.expectEqual('number', typeof f)
		self.expectEqual(42, f)
	}
}
