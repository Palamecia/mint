load test.case
load system.timer
load system.poller

@class TimerTest : Test.Case {
    const def testOneShotBehavior(self) {
        
        let poller = System.Poller()
        let timer = System.Timer()
        let tickCount = 0

        self.expectEqual(poller.watch(timer, def [...] {
            ++tickCount
        }), true)

        timer.start(100)

        self.expectEqual(poller.poll(0), false)
        self.expectEqual(0, tickCount)

        self.expectEqual(poller.poll(110), true)
        self.expectEqual(1, tickCount)

        self.expectEqual(poller.poll(110), false)
        self.expectEqual(1, tickCount)
    }

    const def testPeriodicBehavior(self) {
        
        let poller = System.Poller()
        let timer = System.Timer()
        let tickCount = 0

        self.expectEqual(poller.watch(timer, def [...] {
            ++tickCount
        }), true)

        timer.start(50, 50)

        self.expectEqual(poller.poll(60), true)
        self.expectEqual(1, tickCount)

        self.expectEqual(poller.poll(60), true)
        self.expectEqual(2, tickCount)
    }
}
