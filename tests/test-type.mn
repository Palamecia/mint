load test.case
load test.error-catcher
load mint.type

@class TypeTest : Test.Case {
    const def testDeclarePrivate(self) {
        const __my_type__ = type('__my_type__', {
            private('member'): none
        })
        self.expectEqual(__my_type__.isMemberPrivate('member'), true)
    }

    const def testGetMemberInfo(self) {
        const info = self.getMemberInfo('testGetMemberInfo')
        self.expectEqual(typeof info, 'MemberInfo')
        self.expectEqual(info.getName(), 'testGetMemberInfo')
        self.expectEqual(typeof info.getOwner(), 'TypeTest')
        self.expectEqual(info.isConst(), true)
        self.expectEqual(info.isPublic(), true)
    }

    const def testLocalClassBasic(self) {

        class Foo {}

        let foo = Foo()

        self.expectEqual(typeof foo, 'Foo')
    }

    const def testLocalClassScope(self) {

        def make() {
            class Foo {}
            return Foo
        }

        let Foo1 = make()
        let Foo2 = make()

        self.expectIsNotSame(Foo2, Foo1)
    }

    const def testLocalClassInstanceIsolation(self) {

        class Foo {}

        let a = Foo()
        let b = Foo()

        self.expectIsNotSame(b, a)
    }

    const def testLocalClassMethod(self) {

        class Foo {
            def value(self) {
                return 42
            }
        }

        let foo = Foo()

        self.expectEqual(foo.value(), 42)
    }

    const def testLocalClassInheritance(self) {

        class A {}
        class B : A {}

        let b = B()

        self.expectEqual(typeof b, 'B')
    }

    const def testLocalClassNoCapture(self) {

        let value = 42

        class Foo {
            def get(self) {
                return value
            }
        }

        let foo = Foo()

        self.expectIsSame(foo.get(), none)
    }

    const def testLocalClassEscape(self) {

        def make() {
            class Foo {}
            return Foo
        }

        let Foo = make()
        let obj = Foo()

        self.expectEqual(typeof obj, 'Foo')
    }

    const def testLocalClassShadowing(self) {
        try {

            let catcher = Test.ErrorCatcher()

            class Foo {}
            let a = Foo()

            class Foo {}
            let b = Foo()

            self.fail()
        } catch error {
            self.expectEqual(error.toString(), "multiple definition of class 'Foo'")
        }
    }

    const def testLocalClassFields(self) {

        class Foo {
            final x = 0
        }

        let foo = Foo()
        foo.x = 10

        self.expectEqual(foo.x, 10)
    }

    const def testLocalClassNested(self) {

        class Outer {
            def make(self) {
                class Inner {}
                return Inner()
            }
        }

        let o = Outer()
        let i = o.make()

        self.expectEqual(typeof i, 'Inner')
    }

    const def testLocalClassReferenceSameScope(self) {

        class A {
            def make(self) {
                return B()
            }
        }

        class B {
            def value(self) {
                return 42
            }
        }

        let a = A()
        let b = a.make()

        self.expectEqual(b.value(), 42)
    }

    const def testLocalClassForwardReference(self) {

        class A {
            def make(self) {
                return B()
            }
        }

        class B {}

        let a = A()
        let b = a.make()

        self.expectEqual(typeof b, 'B')
    }

    const def testLocalClassMutualReference(self) {

        class A {
            def make(self) {
                return B()
            }
        }

        class B {
            def make(self) {
                return A()
            }
        }

        let a = A()
        let b = a.make()
        let a2 = b.make()

        self.expectEqual(typeof a2, 'A')
    }

    const def testLocalClassSelfReference(self) {

        class A {
            def make(self, n) {
                if n == 0 {
                    return self
                }
                return A().make(n - 1)
            }
        }

        let a = A()
        let result = a.make(3)

        self.expectEqual(typeof result, 'A')
    }

    /*const def testLocalClassNestedReference(self) {

        class A {
            def make(self) {

                class B {
                    def createA(self) {
                        return A()
                    }
                }

                return B().createA()
            }
        }

        let a = A()
        let result = a.make()

        self.expectEqual('A', typeof result)
    }*/

    const def testAllocateBasic(self) {

        class Foo {
            def clone(self) {
                return self.allocate()
            }
        }

        let foo = Foo()
        let other = foo.clone()

        self.expectEqual(typeof other, 'Foo')
        self.expectIsNotSame(other, foo)
    }

    const def testAllocateNoFieldCopy(self) {

        class Foo {
            final x = null

            def clone(self) {
                return self.allocate()
            }
        }

        let foo = Foo()
        foo.x = 42

        let other = foo.clone()

        self.expectEqual(other.x, null)
    }

    const def testAllocateNoConstructor(self) {

        class Foo {
            const def new(self) {
                Foo.called = true
                return self
            }
            const def clone(const self) {
                return self.allocate()
            }
            @called = false
        }

        let foo = Foo()
        self.expectEqual(Foo.called, true)

        Foo.called = false

        let other = foo.clone()
        self.expectEqual(Foo.called, false)
    }

    const def testAllocateInheritance(self) {

        class Foo {
            const def clone(const self) {
                return self.allocate()
            }
        }

        class Bar : Foo {}

        let foo = Foo()
        self.expectEqual(typeof foo.clone(), 'Foo')

        let bar = Bar()
        self.expectEqual(typeof bar.clone(), 'Bar')
    }

    const def testAllocatePolymorphic(self) {

        class Foo {
            def make(self) {
                return self.allocate()
            }
        }

        class Bar : Foo {}

        let bar = Bar()
        let result = bar.make()

        self.expectEqual(typeof result, 'Bar')
    }

    const def testAllocateFromClass(self) {

        class Foo {
            @const def make() {
                return Foo.allocate()
            }
        }

        let obj = Foo.make()

        self.expectEqual(typeof obj, 'Foo')
    }

    const def testAllocateCloneCopy(self) {

        class Foo {
            final x = 0

            def clone(self) {
                let other = self.allocate()
                other.x = self.x
                return other
            }
        }

        let foo = Foo()
        foo.x = 99

        let other = foo.clone()

        self.expectEqual(other.x, 99)
        self.expectIsNotSame(other, foo)
    }

    const def testAllocateSelfReference(self) {

        class Foo {
            final selfRef = null

            def clone(self) {
                let other = self.allocate()
                other.selfRef = other
                return other
            }
        }

        let foo = Foo()
        let other = foo.clone()

        self.expectIsSame(other, other.selfRef)
    }

    const def testIsDerivedFrom(self) {

        class A {}
        class B : A {}
        class C : B {}

        let a = A()
        let b = B()
        let c = C()

        self.expectEqual(a.isDerivedFrom(A), true)
        self.expectEqual(a.isDerivedFrom(B), false)
        self.expectEqual(a.isDerivedFrom(C), false)

        self.expectEqual(b.isDerivedFrom(A), true)
        self.expectEqual(b.isDerivedFrom(B), true)
        self.expectEqual(b.isDerivedFrom(C), false)

        self.expectEqual(c.isDerivedFrom(A), true)
        self.expectEqual(c.isDerivedFrom(B), true)
        self.expectEqual(c.isDerivedFrom(C), true)
    }

    const def testHasMethod(self) {

        class A {
            def foo(self) {}
        }

        class B : A {
            def bar(self) {}
        }

        let a = A()
        let b = B()

        self.expectEqual(a.hasMethod('foo'), true)
        self.expectEqual(a.hasMethod('bar'), false)

        self.expectEqual(b.hasMethod('foo'), true)
        self.expectEqual(b.hasMethod('bar'), true)
    }

    const def testHasMethodWithSignature(self) {

        class A {
            def foo(self, x) {}
        }

        class B : A {
            def bar(self, x, y) {}
        }

        let a = A()
        let b = B()

        self.expectEqual(a.hasMethod('foo', 2), true)
        self.expectEqual(a.hasMethod('foo', 3), false)
        self.expectEqual(a.hasMethod('bar', 3), false)

        self.expectEqual(b.hasMethod('foo', 2), true)
        self.expectEqual(b.hasMethod('foo', 3), false)
        self.expectEqual(b.hasMethod('bar', 3), true)
    }

    const def testHasMethodWithVariadicSignature(self) {

        class A {
            def foo(self, x, ...) {}
        }

        class B : A {
            def bar(self, x, y, ...) {}
        }

        let a = A()
        let b = B()

        self.expectEqual(a.hasMethod('foo', 2), true)
        self.expectEqual(a.hasMethod('foo', 3), true)
        self.expectEqual(a.hasMethod('bar', 3), false)

        self.expectEqual(b.hasMethod('foo', 2), true)
        self.expectEqual(b.hasMethod('foo', 3), true)
        self.expectEqual(b.hasMethod('bar', 3), true)
    }
}
